{
  "name": "@greenpill-network/website",
  "version": "0.1.0",
  "private": true,
  "description": "Greenpill Network public website - Astro + Keystatic",
  "type": "module",
  "scripts": {
    "dev": "bun --cwd ../.. scripts/dev-website.ts",
    "build": "bun run --cwd ../.. build:packages && bun --bun astro build",
    "check": "bun run --cwd ../.. build:packages && astro check",
    "preview": "bun run --cwd ../.. build:packages && bun --bun astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@greenpill-network/shared": "workspace:*",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "^0.5.48",
    "astro": "6.4.8",
    "gsap": "^3.14.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "^2.8.8"
  }
}
