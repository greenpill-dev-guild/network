---
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import '../styles/gp-tokens.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
  activeNav?: string | null;
  noindex?: boolean;
  hideShell?: boolean;
  /** `graphic` draws the illustrated background layer; the home page asks for `plain`. */
  backgroundMode?: 'graphic' | 'plain';
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title,
  description,
  ogImage = '/images/brand/greenpill-share.jpg',
  canonicalPath = '',
  activeNav = null,
  noindex = false,
  hideShell = false,
  backgroundMode = 'graphic',
  ogType = 'website',
} = Astro.props;
const site = Astro.site ?? new URL('https://greenpill.network');
const canonicalUrl = canonicalPath ? `${site.origin}${canonicalPath}` : site.origin;
// og:image / twitter:image must be absolute URLs; content values are site-relative paths.
const ogImageUrl = new URL(ogImage, site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonicalPath && <link rel="canonical" href={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Manrope:wght@300;400;500;600;700;800&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <!-- Brand marks: the lime topographic capsule from the Greenpill brand kit
         (Figma "Marketing"), not the starburst capsule from the book cover. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/images/brand/greenpill-icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="gp-root">
    {backgroundMode === 'graphic' && <div class="gp-background-parallax" aria-hidden="true"></div>}
    {!hideShell && <a class="gp-skip-link" href="#main-content">Skip to content</a>}
    {!hideShell && <SiteHeader activeNav={activeNav} />}
    <div id="main-content" class="gp-main-target" tabindex="-1">
      <slot />
    </div>
    {!hideShell && <SiteFooter />}
    <script>
      import '../scripts/webmcp';
    </script>
  </body>
</html>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  html {
    background: var(--gp-green-950);
    overflow-x: clip;
  }

  body.gp-root {
    margin: 0;
    min-block-size: 100dvh;
    background: var(--gp-green-950);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }

  /* The illustrated background: two soft glows over the topographic line
     art, fixed behind the page. It does not animate. November 2026 QA
     (finding 8) traced the seams it used to show to two layers: each glow
     was painted in a box narrower than the screen, so its edge was cut off
     in a straight line, and a gradient texture tiled every 1200px met itself
     at hard edges. The glows now span the whole layer and fade out within a
     set radius, and the tiled texture is gone. The line art never repeats
     inside the layer at common screen sizes (it is at least 1944px tall). */
  body.gp-root .gp-background-parallax {
    position: fixed;
    /* Overscan, so collapsing mobile toolbars never reveal the layer's edge. */
    inset-block: -14lvh;
    inset-inline: 0;
    z-index: 0;
    pointer-events: none;
    background-image: url('/images/greenpill-bg.png');
    background-position: top center;
    background-repeat: repeat-y;
    background-size: max(1400px, 100vw) auto;
    opacity: 0.94;
    transform: translate3d(0, 0, 0);
    /* Keeps the layer on its own compositing layer. The CSS minifier folds
       the 3D no-op above into a 2D translate, which drops that hint. */
    will-change: transform;
  }

  /* Reading treatment ("quiet lines", PRD-1446, Afo's pick on 2026-11-08).
     Full-strength strokes crossed small text and dropped it below AA, so a
     green-950 scrim at 60% sits between the line art and the glows: the
     strokes read at about 40% strength and the glows keep their colour.
     The scrim is this pseudo-element's background colour, so it paints
     over the layer's line art and under the pseudo-element's own glows.
     Worst case, the brightest stroke under the lime glow, is #265029;
     DESIGN.md "Reading contrast" lists every text style against it. */
  body.gp-root .gp-background-parallax::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--gp-green-950) 60%, transparent);
    background-image:
      radial-gradient(circle 27vmax at 16% 18%, color-mix(in srgb, var(--gp-lime-500) 10%, transparent), transparent),
      radial-gradient(circle 26vmax at 82% 74%, color-mix(in srgb, var(--gp-gold-500) 8%, transparent), transparent);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  /* Visitors who ask their system for more contrast, and Windows contrast
     themes, read on the plain canvas: no line art and no glows. The token
     file lifts the muted and dim text tones for the same query. */
  @media (prefers-contrast: more), (forced-colors: active) {
    body.gp-root .gp-background-parallax {
      display: none;
    }
  }

  /* Main content and footer are their own stacking layer, so positioned
     elements inside a page (map overlays, popovers) stay below the sticky
     header instead of painting over it. */
  body.gp-root .gp-main-target,
  body.gp-root .gp-site-footer {
    position: relative;
    z-index: 1;
  }

  /* The header stays in normal flow. Its stacking level comes from
     SiteHeader's own rule, which sits above the page layer set here, so the
     open mobile menu paints over the content. */
  body.gp-root .gp-site-header {
    position: relative;
  }

  body.gp-root a {
    color: inherit;
  }

  body.gp-root .gp-skip-link {
    position: fixed;
    inset-block-start: var(--gp-space-lg);
    inset-inline-start: var(--gp-space-lg);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--gp-space-lg);
    border: 1px solid var(--gp-border);
    border-radius: var(--gp-radius-pill);
    background: var(--gp-primary);
    color: var(--gp-primary-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-label-md);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--gp-space-2xl)));
    transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  body.gp-root .gp-skip-link:focus {
    transform: translateY(0);
  }

  /* Page-level container-query context. Components reflow via @container
     against this; safe because no position:fixed elements live inside
     #main-content (the skip link + header overlay are siblings). */
  .gp-main-target {
    container-type: inline-size;
  }

  .gp-main-target:focus {
    outline: none;
  }
</style>
