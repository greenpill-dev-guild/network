---
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import '../styles/gp-tokens.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
  activeNav?: string | null;
  noindex?: boolean;
  hideShell?: boolean;
  /**
   * @deprecated Every page now uses the plain background (decision D4,
   * November 2026 QA). Still accepted so existing callers keep compiling;
   * it has no effect.
   */
  backgroundMode?: 'plain';
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title,
  description,
  ogImage = '/images/greenpill-twitter-card.png',
  canonicalPath = '',
  activeNav = null,
  noindex = false,
  hideShell = false,
  ogType = 'website',
} = Astro.props;
const site = Astro.site ?? new URL('https://greenpill.network');
const canonicalUrl = canonicalPath ? `${site.origin}${canonicalPath}` : site.origin;
// og:image / twitter:image must be absolute URLs; content values are site-relative paths.
const ogImageUrl = new URL(ogImage, site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonicalPath && <link rel="canonical" href={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Manrope:wght@300;400;500;600;700;800&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/images/greenpill-logo-large.png" type="image/png" sizes="150x150" />
    <link rel="shortcut icon" href="/favicon.ico" />
  </head>
  <body class="gp-root">
    {!hideShell && <a class="gp-skip-link" href="#main-content">Skip to content</a>}
    {!hideShell && <SiteHeader activeNav={activeNav} />}
    <div id="main-content" class="gp-main-target" tabindex="-1">
      <slot />
    </div>
    {!hideShell && <SiteFooter />}
    <script>
      import '../scripts/webmcp';
    </script>
  </body>
</html>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  html {
    background: var(--gp-green-950);
    overflow-x: clip;
  }

  /* One plain canvas on every page (decision D4, November 2026 QA): the
     home page's flat green-950. The old illustrated layer, its two glow
     gradients and the tiled topo texture are gone; the texture tiles left
     visible seams at wide widths. */
  body.gp-root {
    margin: 0;
    min-block-size: 100dvh;
    background: var(--gp-green-950);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }

  /* Main content and footer are their own stacking layer, so positioned
     elements inside a page (map overlays, popovers) stay below the sticky
     header instead of painting over it. */
  body.gp-root .gp-main-target,
  body.gp-root .gp-site-footer {
    position: relative;
    z-index: 1;
  }

  /* The header stays in normal flow. Its stacking level comes from
     SiteHeader's own rule, which sits above the page layer set here, so the
     open mobile menu paints over the content. */
  body.gp-root .gp-site-header {
    position: relative;
  }

  body.gp-root a {
    color: inherit;
  }

  body.gp-root .gp-skip-link {
    position: fixed;
    inset-block-start: var(--gp-space-lg);
    inset-inline-start: var(--gp-space-lg);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--gp-space-lg);
    border: 1px solid var(--gp-border);
    border-radius: var(--gp-radius-pill);
    background: var(--gp-primary);
    color: var(--gp-primary-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-label-md);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--gp-space-2xl)));
    transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  body.gp-root .gp-skip-link:focus {
    transform: translateY(0);
  }

  /* Page-level container-query context. Components reflow via @container
     against this; safe because no position:fixed elements live inside
     #main-content (the skip link + header overlay are siblings). */
  .gp-main-target {
    container-type: inline-size;
  }

  .gp-main-target:focus {
    outline: none;
  }
</style>
