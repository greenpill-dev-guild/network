---
import { getCollection } from 'astro:content';
import GpLayout from '../../layouts/GpLayout.astro';
import { getOperationalGuilds } from '../../lib/operational-content';
import { publicGuildPath } from '../../lib/public-routes';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Overline from '../../components/ui/Overline.astro';
import Text from '../../components/ui/Text.astro';
import Meta from '../../components/ui/Meta.astro';
import BookDialog from '../../components/page-sections/BookDialog.astro';
import library from '../../content/library.json';
import podcastFeed from '../../data/podcast-feed-snapshot.json';

const books = (await getCollection('books')).sort(
  (a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0),
);

const podcastResource = (await getCollection('resources')).find(
  (resource) => resource.id === 'greenpill-podcast' && resource.data.status === 'published',
);
const guilds = (await getOperationalGuilds())
  .filter((guild) => !guild.data.seo?.noindex)
  .sort((a, b) => (
    Number(b.data.featuredWeight ?? 0) - Number(a.data.featuredWeight ?? 0) ||
    String(a.data.name ?? a.id).localeCompare(String(b.data.name ?? b.id))
  ));

const hero = library.hero ?? {};
// The episode count comes from the RSS feed. The Pages build refreshes
// podcast-feed-snapshot.json before it builds, so this stays current.
const podcastEpisodes = `${podcastFeed.episodeCount} episodes`;
const recentPodcastEpisodes = podcastFeed.episodes ?? [];
const featuredEpisode = recentPodcastEpisodes[0];
const listedEpisodes = recentPodcastEpisodes.slice(1, 4);
const podcastArchiveHref = podcastFeed.archiveUrl || podcastResource?.data.primaryUrl || 'https://podcasts.apple.com/us/podcast/greenpill/id1609313639';
const podcastCoverImage = podcastFeed.image || '/images/podcast-cover.png';
const podcastUpdated = formatDate(podcastFeed.lastBuildDate);
const translationCount = books.reduce((total, book) => total + book.data.translations.length, 0);
const libraryStats = [
  { value: String(books.length), label: books.length === 1 ? 'Book' : 'Books' },
  { value: String(podcastFeed.episodeCount), label: 'Podcast episodes' },
  { value: String(translationCount), label: translationCount === 1 ? 'Translation' : 'Translations' },
  { value: String(guilds.length), label: guilds.length === 1 ? 'Guild' : 'Guilds' },
].filter((stat) => stat.value !== '0');

function bookDialogId(book: typeof books[number]) {
  return `book-${book.id}`;
}

function translationLabel(count: number) {
  return count === 1 ? '1 translation' : `${count} translations`;
}

function formatDate(value: string) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) return '';
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}

function episodeMeta(episode: typeof recentPodcastEpisodes[number]) {
  return [
    episode.season ? `Season ${episode.season}` : 'Podcast',
    episode.episode ? `Ep ${episode.episode}` : '',
    formatDate(episode.publishedAt),
    episode.duration,
  ].filter(Boolean);
}

function guildHref(guild: typeof guilds[number]) {
  return (
    publicGuildPath(guild.id || guild.slug) ||
    (guild.data.links ?? []).find((link: any) => link.url)?.url ||
    (guild.data.connectLinks ?? []).find((link: any) => link.url)?.url ||
    ''
  );
}

function guildFootLabel(guild: typeof guilds[number]) {
  return publicGuildPath(guild.id || guild.slug) ? 'Visit guild' : 'Visit guild site';
}
---

<GpLayout
  title={library.seo?.title || 'Library · Greenpill Network'}
  description={library.seo?.description || 'Browse Greenpill books and translations, recent podcast episodes, and the network\'s working guilds.'}
  ogImage={library.seo?.ogImage || undefined}
  canonicalPath={library.seo?.canonicalPath || '/library'}
  noindex={library.seo?.noindex}
  activeNav="Library"
>
  <main class="gp-library">
    <section class="gp-library-hero gp-topo">
      <Container size="2xl">
        <div class="gp-library-hero-inner">
          <Overline tone="muted">
            <span>Library</span>
            <span aria-hidden="true">·</span>
            <span>Public knowledge commons</span>
          </Overline>

          <Text variant="display" class="gp-library-hero-title">{hero.title || 'Everything we have made public.'}</Text>

          <Text variant="body-lg" class="gp-library-hero-dek">
            {hero.dek || 'Books, podcast conversations, Hub threads, project docs, and Garden resources from across the Greenpill network.'}
          </Text>

          <div class="gp-library-hero-actions">
            <Button href="#books">{hero.primaryCta?.label || 'Browse books'}</Button>
	            <Button
	              href={hero.secondaryCta?.href || '#podcast'}
	              variant="ghost"
	            >
              {hero.secondaryCta?.label || 'Listen to the podcast'}
            </Button>
          </div>

          <div class="gp-library-stat-strip">
            {libraryStats.map((stat, index) => (
              <div class:list={['gp-library-stat', { 'is-accent': index === 1 }]}>
                <span class="gp-library-stat-big">{stat.value}</span>
                <span class="gp-library-stat-sub">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <section class="gp-library-section" id="books">
      <Container size="2xl">
        <div class="gp-library-section-head">
          <div class="gp-library-section-head-copy">
            <Overline>Books · {books.length} titles</Overline>
            <Text variant="h2">The foundation shelf.</Text>
            <Text variant="body" class="gp-library-section-dek">
              Open-source books on regenerative crypto, public goods, capital allocation, local regeneration,
              and onchain impact networks.
            </Text>
          </div>
          <Text variant="mono">All free · multiple languages</Text>
        </div>

        {/*
          Each cover links to the English PDF. With JavaScript, a plain click
          opens the book's dialog instead (BookDialog.astro), which carries the
          translations and the store or edition links.
        */}
        <ul class="gp-library-books-grid" role="list">
          {books.map((book, index) => (
            <li class="gp-library-book">
              <Card
                href={book.data.ebookLink}
                padded="sm"
                stack="sm"
                class="gp-library-book-link"
                data-book-dialog-trigger={bookDialogId(book)}
              >
                <span class="gp-library-book-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="gp-library-book-cover">
                  {book.data.image && (
                    <img
                      src={book.data.image}
                      alt=""
                      width={book.data.imageWidth ?? 200}
                      height={book.data.imageHeight ?? 300}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
                <span class="gp-library-book-meta">
                  <Text as="span" variant="title-md" class="gp-library-book-title">{book.data.title}</Text>
                  {book.data.author && <Text variant="caption">{book.data.author}{book.data.publishYear && ` · ${book.data.publishYear}`}</Text>}
                  {book.data.translations.length > 0 && (
                    <Text variant="mono">{translationLabel(book.data.translations.length)}</Text>
                  )}
                </span>
              </Card>
            </li>
          ))}
        </ul>

        {books.map((book) => (
          <BookDialog
            id={bookDialogId(book)}
            title={book.data.title}
            description={book.data.description}
            author={book.data.author}
            publishYear={book.data.publishYear}
            image={book.data.image}
            imageAlt={book.data.imageAlt}
            imageWidth={book.data.imageWidth}
            imageHeight={book.data.imageHeight}
            ebookLink={book.data.ebookLink}
            formats={book.data.formats}
            translations={book.data.translations}
          />
        ))}
      </Container>
    </section>

    {featuredEpisode && (
      <section class="gp-library-section" id="podcast">
        <Container size="2xl">
          <div class="gp-library-section-head">
            <div class="gp-library-section-head-copy">
              <Overline>Podcast · {podcastEpisodes}</Overline>
              <Text variant="h2">A long-running public conversation.</Text>
              <Text variant="body" class="gp-library-section-dek">
                Recent episodes from the GreenPill RSS feed, playable directly on the site.
              </Text>
            </div>
            <div class="gp-library-podcast-links">
              <ArrowLink href={podcastArchiveHref}>Apple Podcasts</ArrowLink>
              <ArrowLink href={podcastFeed.sourceUrl} tone="muted">RSS feed</ArrowLink>
            </div>
          </div>

          <div class="gp-library-podcast-layout">
            <Card as="article" variant="elevated" padded="sm" class="gp-library-podcast-feature">
              <div class="gp-library-podcast-cover">
                <img
                  src={featuredEpisode.image || podcastCoverImage}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="gp-library-podcast-copy">
                <Meta items={['Latest episode', ...episodeMeta(featuredEpisode)]} accentIndex={0} />
                <Text variant="h3" class="gp-library-podcast-title">{featuredEpisode.title}</Text>
                <Text variant="body-sm" class="gp-library-podcast-summary">{featuredEpisode.summary || podcastFeed.description || podcastResource?.data.summary}</Text>
              </div>
              <audio class="gp-library-audio gp-library-feature-audio" controls preload="none" aria-label={featuredEpisode.title}>
                <source src={featuredEpisode.audioUrl} type={featuredEpisode.audioType || 'audio/mpeg'} />
                Your browser does not support the audio element.
              </audio>
              <div class="gp-library-episode-source">
                <a href={featuredEpisode.link}>Episode notes</a>
                {podcastUpdated && <span>Feed updated {podcastUpdated}</span>}
              </div>
            </Card>

            <ul class="gp-library-episode-list" role="list" aria-label="More recent episodes">
              {listedEpisodes.map((episode) => (
                <li class="gp-library-episode-row">
                  <img
                    class="gp-library-episode-image"
                    src={episode.image || podcastCoverImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="gp-library-episode-copy">
                    <Meta items={episodeMeta(episode)} accentIndex={1} />
                    <Text variant="title-md" class="gp-library-episode-title">{episode.title}</Text>
                    <Text variant="caption">{episode.author || 'GreenPill'}</Text>
                  </span>
                  <audio class="gp-library-audio gp-library-row-audio" controls preload="none" aria-label={episode.title}>
                    <source src={episode.audioUrl} type={episode.audioType || 'audio/mpeg'} />
                    Your browser does not support the audio element.
                  </audio>
                  <a class="gp-library-episode-notes" href={episode.link}>Notes<span class="gp-library-sr">: {episode.title}</span></a>
                </li>
              ))}
            </ul>
          </div>
        </Container>
      </section>
    )}

    {guilds.length > 0 && (
      <section class="gp-library-section" id="guilds">
        <Container size="2xl">
          <div class="gp-library-section-head">
            <div class="gp-library-section-head-copy">
              <Overline>Guilds · Working circles</Overline>
              <Text variant="h2">Build with the network.</Text>
              <Text variant="body" class="gp-library-section-dek">
                Public guild pages collect the tools, writing, and coordination work already visible to the network.
              </Text>
            </div>
          </div>

          <div class="gp-library-guild-grid">
            {guilds.map((guild, index) => {
              // A guild with neither a page nor a link gets a card that is not a link.
              const href = guildHref(guild);
              return (
                <Card
                  href={href || undefined}
                  as="article"
                  padded="lg"
                  stack="md"
                  class={guilds.length === 3 && index === 2 ? 'gp-library-guild-card is-bento-wide' : 'gp-library-guild-card'}
                >
                  <span class="gp-library-status">{guild.data.status || 'active'}</span>
                  <Text variant="h3">{guild.data.name}</Text>
                  <Text variant="body-sm">{guild.data.summary || guild.data.oneliner || guild.data.description}</Text>
                  {href && (
                    <span class="gp-library-guild-foot">
                      <span>{guildFootLabel(guild)}</span>
                      <span aria-hidden="true">→</span>
                    </span>
                  )}
                </Card>
              );
            })}
          </div>
        </Container>
      </section>
    )}
  </main>
</GpLayout>

<style>
  .gp-library {
    min-height: 100dvh;
    background: transparent;
  }

  .gp-library-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--gp-space-3xl), 7vw, var(--gp-space-5xl)) 0 var(--gp-space-2xl);
  }

  .gp-library-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-lg);
  }

  .gp-library-hero-inner :global(.gp-text.gp-library-hero-title) {
    max-width: 18ch;
    font-size: var(--gp-display-size);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .gp-library-hero-inner :global(.gp-text.gp-library-hero-dek) {
    max-width: 60ch;
    color: var(--gp-fg-muted);
  }

  .gp-library-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .gp-library-stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(var(--gp-space-lg), 3vw, var(--gp-space-2xl));
    padding-top: var(--gp-space-lg);
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-library-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gp-library-stat-big {
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-h2-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
  }

  .gp-library-stat.is-accent .gp-library-stat-big {
    color: var(--gp-primary);
  }

  .gp-library-stat-sub {
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gp-library-section {
    padding: clamp(var(--gp-space-2xl), 5vw, var(--gp-space-4xl)) 0;
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-library-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gp-space-xl);
    flex-wrap: wrap;
    margin-bottom: var(--gp-space-xl);
  }

  .gp-library-section-head-copy {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
    max-width: 720px;
  }

  .gp-library-section-head-copy :global(.gp-text.gp-library-section-dek) {
    color: var(--gp-fg-muted);
  }

	  .gp-library-books-grid {
	    display: grid;
	    grid-template-columns: repeat(10, minmax(0, 1fr));
	    gap: var(--gp-space-2xl) clamp(18px, 2vw, 28px);
	    margin: 0;
	    padding: 0;
	    list-style: none;
	  }

	  .gp-library-book {
	    grid-column: span 2;
	    min-width: 0;
	  }

  /* Each book is a Card link (components/ui/Card.astro): a click opens its
     dialog, and without JavaScript the link opens the English PDF. */
  .gp-library-books-grid :global(.gp-library-book-link) {
    block-size: 100%;
  }

	  .gp-library-book:last-child:nth-child(5n + 1) {
	    grid-column: 5 / span 2;
	  }

	  .gp-library-book:nth-last-child(2):nth-child(5n + 1) {
	    grid-column: 4 / span 2;
	  }

	  .gp-library-book:nth-last-child(3):nth-child(5n + 1) {
	    grid-column: 3 / span 2;
	  }

	  .gp-library-book:nth-last-child(4):nth-child(5n + 1) {
	    grid-column: 2 / span 2;
	  }

  .gp-library-book-index {
    color: var(--gp-fg-muted);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-label-sm);
    letter-spacing: 0.08em;
  }

  /* Covers differ in shape, so each sits whole in a 3:4 frame, the way the
     home page frames story art. */
  .gp-library-book-cover {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: var(--gp-space-sm);
    border-radius: var(--gp-radius-md);
    background: var(--gp-green-800);
    overflow: hidden;
  }

  .gp-library-book-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--gp-radius-sm);
  }

  .gp-library-book-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .gp-library-book-meta :global(.gp-text.gp-library-book-title) {
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-title-md);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* Visually hidden text that screen readers still announce. */
  .gp-library-sr {
    position: absolute;
    overflow: hidden;
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
  }

	  .gp-library-podcast-layout {
	    display: grid;
	    grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr);
	    gap: clamp(var(--gp-space-xl), 4vw, var(--gp-space-3xl));
	    align-items: start;
	  }

	  .gp-library-podcast-links {
	    display: inline-flex;
	    flex-wrap: wrap;
	    align-items: center;
	    justify-content: flex-end;
	    gap: var(--gp-space-md);
	  }

  /* The latest episode is an elevated Card (components/ui/Card.astro) with
     the cover beside the copy. It is not a link, so it has no hover. */
  .gp-library-podcast-layout :global(.gp-library-podcast-feature) {
    display: grid;
    grid-template-columns: minmax(88px, 112px) minmax(0, 1fr);
    gap: var(--gp-space-md);
    align-items: start;
    justify-self: start;
    width: min(100%, 460px);
  }

  .gp-library-podcast-cover {
    display: grid;
    place-items: center;
  }

  .gp-library-podcast-cover img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--gp-radius-md);
    box-shadow: var(--gp-shadow-card-lg);
  }

	  .gp-library-podcast-copy {
	    display: flex;
	    flex-direction: column;
	    gap: var(--gp-space-sm);
	    min-width: 0;
	  }

	  /* .gp-text in the selector outweighs Text's h3 letter-spacing; with equal
	     weight the winner depended on stylesheet order. */
	  .gp-library-podcast-copy :global(.gp-text.gp-library-podcast-title) {
	    display: -webkit-box;
	    overflow: hidden;
	    -webkit-box-orient: vertical;
	    -webkit-line-clamp: 3;
	    letter-spacing: 0;
	  }

	  .gp-library-podcast-copy :global(.gp-library-podcast-summary) {
	    display: -webkit-box;
	    overflow: hidden;
	    -webkit-box-orient: vertical;
	    -webkit-line-clamp: 3;
	  }

	  .gp-library-episode-list {
	    display: flex;
	    flex-direction: column;
	    justify-content: flex-start;
	    margin: 0;
	    padding: 0;
	    list-style: none;
    border-top: 1px solid var(--gp-border-soft);
    border-bottom: 1px solid var(--gp-border-soft);
  }

	  .gp-library-episode-row {
	    display: grid;
	    grid-template-columns: 64px minmax(0, 1fr) minmax(160px, 220px) auto;
	    gap: var(--gp-space-sm);
	    align-items: center;
	    padding: var(--gp-space-md) 0;
	    border-bottom: 1px solid var(--gp-border-soft);
	    color: var(--gp-fg);
	    text-decoration: none;
	  }

  .gp-library-episode-row:last-child {
    border-bottom: 0;
  }

	  .gp-library-episode-image {
	    width: 64px;
	    height: 64px;
	    border: 1px solid var(--gp-border-soft);
	    border-radius: var(--gp-radius-md);
	    object-fit: cover;
	    box-shadow: var(--gp-shadow-card);
	  }

	  .gp-library-episode-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

	  .gp-library-episode-copy :global(.gp-text.gp-library-episode-title) {
	    display: -webkit-box;
	    overflow: hidden;
	    -webkit-box-orient: vertical;
	    -webkit-line-clamp: 2;
	    color: var(--gp-secondary);
	  }

	  .gp-library-audio {
	    display: block;
	    width: 100%;
	    min-width: 0;
	    accent-color: var(--gp-primary);
	  }

	  .gp-library-feature-audio {
	    grid-column: 1 / -1;
	    margin-top: 0;
	  }

	  .gp-library-episode-source,
	  .gp-library-episode-notes {
	    display: flex;
	    align-items: center;
	    gap: 10px;
	    color: var(--gp-fg-muted);
	    font-family: var(--gp-font-mono);
	    font-size: 11px;
	    letter-spacing: 0.06em;
	    text-transform: uppercase;
	  }

	  .gp-library-episode-source {
	    grid-column: 1 / -1;
	    flex-wrap: wrap;
	  }

	  .gp-library-episode-source a,
	  .gp-library-episode-notes {
	    color: var(--gp-primary);
	    text-decoration: none;
	  }

	  .gp-library-episode-source a:hover,
	  .gp-library-episode-notes:hover {
	    color: var(--gp-primary-hover);
	  }

  .gp-library-guild-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gp-space-md);
  }

  /* Guild cards are Card links (components/ui/Card.astro). */
  .gp-library-guild-grid :global(.gp-library-guild-card) {
    min-height: 280px;
  }

  .gp-library-guild-grid :global(.gp-library-guild-card.is-bento-wide) {
    grid-column: 1 / -1;
    min-height: 220px;
  }

  .gp-library-status {
    width: fit-content;
    padding: 5px 10px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    color: var(--gp-primary);
    font-family: var(--gp-font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gp-library-guild-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gp-space-md);
    margin-top: auto;
    padding-top: var(--gp-space-md);
    border-top: 1px solid var(--gp-border-soft);
    color: var(--gp-fg-muted);
    font-family: var(--gp-font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

	  @container (max-width: 980px) {
	    .gp-library-books-grid {
