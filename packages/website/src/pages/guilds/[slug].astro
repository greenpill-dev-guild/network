---
import GpLayout from '../../layouts/GpLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Chip from '../../components/ui/Chip.astro';
import CtaStrip from '../../components/ui/CtaStrip.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Overline from '../../components/ui/Overline.astro';
import Text from '../../components/ui/Text.astro';
import Meta from '../../components/ui/Meta.astro';
import LinkRow from '../../components/ui/LinkRow.astro';
import Avatar from '../../components/ui/Avatar.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumb from '../../components/shell/Breadcrumb.astro';
import {
  getOperationalCollection,
  getOperationalGuilds,
  getOperationalProjects,
} from '../../lib/operational-content';
import { hasPublicGuildPage } from '../../lib/public-routes';
import { formatContentDate } from '../../lib/content-dates';

export async function getStaticPaths() {
  const items = await getOperationalGuilds();
  return items
    .filter((item) => hasPublicGuildPage(item.id))
    .map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const data = item.data;

const text = (value: unknown): string => (typeof value === 'string' ? value.trim() : '');
const list = (value: unknown): any[] => (Array.isArray(value) ? value : []);
const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

// Link labels name the destination ("GitHub", "greengoods.app"), not the action.
const HOST_LABELS: Record<string, string> = {
  'github.com': 'GitHub',
  'paragraph.com': 'Paragraph',
  'hub.regencoordination.xyz': 'Regen Hub',
  'gap.karmahq.xyz': 'Karma GAP',
  'karmahq.org': 'Karma GAP',
  'youtube.com': 'YouTube',
  'youtu.be': 'YouTube',
  'x.com': 'X',
  'luma.com': 'Luma',
  'lu.ma': 'Luma',
  'cryptoaltruists.com': 'Crypto Altruists',
};
// Hosts whose subdomain is an account id ("128c3f4a….libsyn.com").
const HOST_SUFFIX_LABELS: Record<string, string> = {
  'libsyn.com': 'Libsyn',
};
function destinationLabel(url: string): string {
  if (url.startsWith('/')) return /\.pdf$/i.test(url) ? 'Read the PDF' : 'Read on this site';
  try {
    const host = new URL(url).hostname.replace(/^www\./, '');
    const suffix = Object.keys(HOST_SUFFIX_LABELS).find((key) => host.endsWith(`.${key}`));
    return HOST_LABELS[host] ?? (suffix ? HOST_SUFFIX_LABELS[suffix] : host);
  } catch {
    return 'Open';
  }
}

const APPEARANCE_VERBS: Record<string, string> = {
  podcast: 'Listen',
  video: 'Watch',
  recording: 'Watch',
  talk: 'Watch',
  space: 'Listen',
  article: 'Read',
};

// Avatar initials come from the words of a name; "Afo (Afolabi …)" should read "AA", not "A(".
const avatarName = (name: unknown) => text(name).replace(/[()]/g, '');
const appearanceLinkLabel = (appearance: any) =>
  `${APPEARANCE_VERBS[text(appearance.kind).toLowerCase()] ?? 'Open'} on ${destinationLabel(text(appearance.href))}`;
// "With Afo, Coi, Matt" for the people an appearance credits; empty when it names none.
const appearancePeople = (appearance: any) => {
  const names = list(appearance.people).map(text).filter(Boolean);
  return names.length > 0 ? `With ${names.join(', ')}` : '';
};

// Short mono labels for key links (DESIGN.md: text labels, not icons).
const LINK_GLYPHS: Record<string, string> = {
  github: 'GH',
  karma: 'KARMA',
  x: 'X',
  twitter: 'X',
  luma: 'LUMA',
  paragraph: 'PG',
  hub: 'HUB',
  linkedin: 'IN',
  youtube: 'YT',
  farcaster: 'FC',
  telegram: 'TG',
  discord: 'DC',
};
// Returns '' when the glyph would only repeat the label (an "X" link labelled "X").
function linkGlyph(link: any): string {
  const label = text(link.label);
  const words = label.split(/\s+/).filter(Boolean);
  const glyph = LINK_GLYPHS[text(link.icon).toLowerCase()]
    ?? (words.length >= 2 ? words[0][0] + words[1][0] : (words[0] ?? '').slice(0, 2)).toUpperCase();
  return glyph.toLowerCase() === label.toLowerCase() ? '' : glyph;
}

const surfaceLabel = data.type === 'guild' ? 'Guild' : 'Pod';
const status = text(data.status) || 'active';
const heroSegments = [surfaceLabel, capitalize(status), data.foundedYear ? `Founded ${data.foundedYear}` : '']
  .filter(Boolean);

const themeRecords = await getOperationalCollection('themes');
const themeNames = new Map(themeRecords.map((theme) => [theme.id, text(theme.data.name) || theme.id]));
const themeLabels = [...new Set(list(data.themeSlugs).map((slug) => themeNames.get(slug)).filter(Boolean))]
  .slice(0, 3) as string[];

const keyLinks = list(data.links).filter((link) => text(link?.url) && text(link?.label));
const connectLinks = list(data.connectLinks).filter((link) => text(link?.url) && text(link?.label));
const mandate = list(data.mandateParagraphs).map(text).filter(Boolean);
const principles = list(data.principles).filter((principle) => text(principle?.title));
const publishedWork = list(data.outputs).filter((work) => text(work?.label));
// Outputs written before the November 2026 guild content update carry no `kind`:
// they describe surfaces, not published work, so they keep the older heading.
const workHeading = publishedWork.every((work) => text(work.kind)) ? 'Published by the guild' : 'Public outputs';
const appearances = list(data.media?.appearances).filter((a) => text(a?.title) && text(a?.href));
const [leadAppearance, ...moreAppearances] = appearances;
const contributors = list(data.publicMembers).filter((member) => text(member?.name));

// Hats and roles: the guild's stewards field holds one entry per hat, grouped by `group`.
// A hat names its wearer in `name`, or several in `holders`; with neither it is open.
const hatGroups = list(data.stewards)
  .filter((hat) => text(hat?.role))
  .map((hat) => ({ ...hat, holders: [text(hat.name), ...list(hat.holders).map(text)].filter(Boolean) }))
  .reduce((groups: Map<string, any[]>, hat) => {
    const group = text(hat.group) || 'Roles';
    groups.set(group, [...(groups.get(group) ?? []), hat]);
    return groups;
  }, new Map<string, any[]>());

// Active projects only, higher featured weight first.
const projects = (await getOperationalProjects())
  .filter((project) => project.data.guild === item.id && (text(project.data.status) || 'active') === 'active')
  .sort((a, b) => Number(b.data.featuredWeight ?? 0) - Number(a.data.featuredWeight ?? 0))
  .map((project) => ({
    name: project.data.name,
    summary: text(project.data.summary),
    tech: list(project.data.techStack).map(text).filter(Boolean).slice(0, 4),
    links: [text(project.data.repoUrl), text(project.data.liveUrl)]
      .filter((url, index, urls) => url && urls.indexOf(url) === index),
  }));
---

<GpLayout
  title={data.seo?.title || `${data.name} · Greenpill ${surfaceLabel}`}
  description={data.seo?.description || data.summary || ''}
  ogImage={data.seo?.ogImage || data.media?.ogImage || undefined}
  canonicalPath={data.seo?.canonicalPath || `/guilds/${item.id}`}
  noindex={data.seo?.noindex}
  activeNav="Library"
  ogType="profile"
>
  <main class="gp-guild">
    <section class="gp-guild-hero">
      <Container size="2xl">
        <Breadcrumb back={{ label: 'Library', href: '/library#guilds' }} crumbs={[{ label: data.name }]} />
        <div class="gp-guild-hero-inner">
          <Overline segments={heroSegments} />
          <Text variant="display">{data.name}</Text>
          {data.oneliner && (
            <div class="gp-guild-prose">
              <Text variant="body-lg">{data.oneliner}</Text>
            </div>
          )}

          {themeLabels.length > 0 && (
            <ul class="gp-guild-row" role="list" aria-label="Themes">
              {themeLabels.map((label) => (
                <li><Chip size="sm">{label}</Chip></li>
              ))}
            </ul>
          )}

          {keyLinks.length > 0 && (
            <ul class="gp-guild-row gp-guild-key-links" role="list" aria-label="Key links">
              {keyLinks.map((link) => {
                const glyph = linkGlyph(link);
                return (
                  <li>
                    <Chip href={link.url} size="lg">
                      {glyph && <span class="gp-guild-key-glyph" aria-hidden="true">{glyph}</span>}
                      <span class="gp-guild-key-label">{link.label}</span>
                    </Chip>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </Container>
    </section>

    {(mandate.length > 0 || principles.length > 0) && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-mandate-grid">
            {mandate.length > 0 && (
              <div class="gp-guild-stack gp-guild-prose">
                <Overline as="h2" text="Mandate" />
                {mandate.map((paragraph) => <Text variant="body-lg">{paragraph}</Text>)}
              </div>
            )}

            {principles.length > 0 && (
              <div class="gp-guild-stack">
                <Overline as="h2" text="Principles" />
                <ol class="gp-guild-principles" role="list">
                  {principles.map((principle, index) => (
                    <Card as="li" class="gp-guild-principle">
                      <span class="gp-guild-principle-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                      <div class="gp-guild-stack is-tight">
                        <Text variant="title-md" as="h3">{principle.title}</Text>
                        {principle.body && <Text variant="body-lg" class="gp-guild-principle-body">{principle.body}</Text>}
                      </div>
                    </Card>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </Container>
      </section>
    )}

    {publishedWork.length > 0 && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-section-head">
            <Overline as="h2" text={workHeading} />
          </div>
          <ul class="gp-guild-grid is-two" role="list">
            {publishedWork.map((work) => {
              const credits = list(work.contributors).map(text).filter(Boolean);
              const meta = [text(work.kind), formatContentDate(work.date)].filter(Boolean);
              const href = text(work.href);
              return (
                <li>
                  <Card padded="lg">
                    <div class="gp-guild-card-body">
                      {meta.length > 0 && <Meta items={meta} accentIndex={0} />}
                      <Text variant="title-lg" as="h3">{work.label}</Text>
                      {work.summary && <Text variant="body-lg">{work.summary}</Text>}
                      {credits.length > 0 && (
                        <p class="gp-guild-credit">
                          <span class="gp-guild-credit-label">Contributors</span>
                          <span>{credits.join(', ')}</span>
                        </p>
                      )}
                      {href && (
                        <div class="gp-guild-card-foot">
                          <ArrowLink href={href} size="sm">{destinationLabel(href)}</ArrowLink>
                        </div>
                      )}
                    </div>
                  </Card>
                </li>
              );
            })}
          </ul>
        </Container>
      </section>
    )}

    {projects.length > 0 && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-section-head">
            <Overline as="h2" text="Projects" />
          </div>
          <ul class="gp-guild-grid is-three" role="list">
            {projects.map((project) => (
              <li>
                <Card padded="lg">
                  <div class="gp-guild-card-body">
                    <Text variant="title-lg" as="h3">{project.name}</Text>
                    {project.summary && <Text variant="body-lg">{project.summary}</Text>}
                    {project.tech.length > 0 && <Meta items={project.tech} />}
                    {project.links.length > 0 && (
                      <div class="gp-guild-card-foot">
                        {project.links.map((url) => (
                          <ArrowLink href={url} size="sm">{destinationLabel(url)}</ArrowLink>
                        ))}
                      </div>
                    )}
                  </div>
                </Card>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )}

    {leadAppearance && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <SectionHeader segments={['Media', 'Appearances']} title="See the guild in motion." />
          <div class:list={['gp-guild-media', { 'has-list': moreAppearances.length > 0 }]}>
            <Card variant="elevated" padded="lg">
              <div class="gp-guild-card-body">
                <Meta items={[text(leadAppearance.source), formatContentDate(leadAppearance.date)].filter(Boolean)} accentIndex={0} />
                <Text variant="h3">{leadAppearance.title}</Text>
                {appearancePeople(leadAppearance) && <Text variant="body-lg">{appearancePeople(leadAppearance)}</Text>}
                <div class="gp-guild-card-foot">
                  <ArrowLink href={leadAppearance.href}>{appearanceLinkLabel(leadAppearance)}</ArrowLink>
                </div>
              </div>
            </Card>

            {moreAppearances.length > 0 && (
              <Card as="ul" padded="none" class="gp-guild-media-list" role="list">
                {moreAppearances.map((appearance) => (
                  <li>
                    <a class="gp-guild-media-row" href={appearance.href}>
                      <span class="gp-guild-media-copy">
                        <Meta items={[text(appearance.source), formatContentDate(appearance.date)].filter(Boolean)} accentIndex={0} />
                        <span class="gp-guild-media-title">{appearance.title}</span>
                        {appearancePeople(appearance) && <span class="gp-guild-media-people">{appearancePeople(appearance)}</span>}
                      </span>
                      <span class="gp-guild-media-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  </li>
                ))}
              </Card>
            )}
          </div>
        </Container>
      </section>
    )}

    {hatGroups.size > 0 && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-section-head">
            <Overline as="h2" segments={['Hats', 'How the guild is organized']} />
          </div>
          <div class="gp-guild-grid is-auto">
            {[...hatGroups.entries()].map(([group, hats]) => (
              <Card padded="lg">
                <div class="gp-guild-card-body">
                  <Overline as="h3" tone="muted" text={group} />
                  <ul class="gp-guild-hat-list" role="list">
                    {hats.map((hat) => (
                      <li class="gp-guild-hat">
                        <span class="gp-guild-hat-role">
                          <Text variant="title-md" as="span">{hat.role}</Text>
                        </span>
                        {hat.holders.length > 0 ? (
                          <ul class="gp-guild-hat-holders" role="list">
                            {hat.holders.map((holder: string) => (
                              <li class="gp-guild-person is-compact">
                                <span class="gp-guild-avatar" aria-hidden="true"><Avatar name={avatarName(holder)} size={32} /></span>
                                <span>{holder}</span>
                              </li>
                            ))}
                          </ul>
                        ) : (
                          <Chip tone="soft-gold" size="sm">Open hat</Chip>
                        )}
                        {text(hat.href) && <ArrowLink href={hat.href} size="sm">Hat details</ArrowLink>}
                      </li>
                    ))}
                  </ul>
                </div>
              </Card>
            ))}
          </div>
        </Container>
      </section>
    )}

    {contributors.length > 0 && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-section-head">
            <Overline as="h2" segments={['People', 'Public contributors']} />
          </div>
          <ul class="gp-guild-members" role="list">
            {contributors.map((member) => (
              <li class="gp-guild-person">
                <span class="gp-guild-avatar" aria-hidden="true"><Avatar name={avatarName(member.name)} size={56} /></span>
                <span class="gp-guild-stack is-tight">
                  <Text variant="title-md" as="span">{member.name}</Text>
                  {member.role && <Text variant="body-sm" as="span">{member.role}</Text>}
                </span>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )}

    {connectLinks.length > 0 && (
      <section class="gp-guild-section">
        <Container size="2xl">
          <div class="gp-guild-section-head">
            <Overline as="h2" text="Connect" />
          </div>
          <Card padded="lg">
            {connectLinks.map((link, index) => (
              <LinkRow
                href={link.url}
                label={link.label}
                sub={link.subtext}
                handle={link.handle}
                last={index === connectLinks.length - 1}
              />
            ))}
          </Card>
        </Container>
      </section>
    )}

    <section class="gp-guild-cta">
      <Container size="2xl">
        <CtaStrip
          overline="Get involved"
          title="Bring your craft into the guild."
          body="The Garden is the public ramp into Greenpill guilds. Start small and build up to a steward conversation when the project is right."
        >
          <Button href="/garden">Enter the Garden</Button>
          <Button href="/library" variant="ghost">Open Library</Button>
        </CtaStrip>
      </Container>
    </section>
  </main>
</GpLayout>

<style>
  .gp-guild {
    min-height: 100dvh;
    background: transparent;
  }

  /* Safari drops list semantics from lists without markers, so each list
     in the markup also carries role="list". */
  .gp-guild ul,
  .gp-guild ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gp-guild-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
    min-width: 0;
  }

  .gp-guild-stack.is-tight {
    gap: var(--gp-space-xs);
  }

  /* Reading text on this template runs at the body-lg token (18px). Setting the
     wrapper to the same size makes the reading measure (DESIGN.md, Typography)
     match the prose inside it. */
  .gp-guild-prose {
    font-size: var(--gp-body-lg);
    max-inline-size: var(--gp-measure-reading);
  }

  .gp-guild-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gp-space-sm);
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .gp-guild-hero {
    padding-block: clamp(var(--gp-space-2xl), 6vw, var(--gp-space-4xl)) var(--gp-space-2xl);
  }

  .gp-guild-hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
    margin-block-start: var(--gp-space-xl);
  }

  .gp-guild-key-links {
    margin-block-start: var(--gp-space-sm);
  }

  /* Keeps a one-letter label ("X") at least 44px wide inside its pill. */
  .gp-guild-key-label {
    min-inline-size: 2ch;
    text-align: center;
  }

  .gp-guild-key-glyph {
    color: var(--gp-primary);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-label-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* ── Sections ─────────────────────────────────────────────────── */
  .gp-guild-section {
    padding-block: clamp(var(--gp-space-2xl), 5vw, var(--gp-space-3xl));
    border-block-start: 1px solid var(--gp-border-soft);
  }

  .gp-guild-section-head {
    margin-block-end: var(--gp-space-lg);
  }

  .gp-guild-mandate-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(var(--gp-space-xl), 4vw, var(--gp-space-3xl));
  }

  .gp-guild-principles {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
  }

  .gp-guild-principles :global(.gp-guild-principle) {
    display: flex;
    gap: var(--gp-space-md);
  }

  .gp-guild-principle-num {
    flex: none;
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-h3-size);
    font-weight: 500;
    line-height: 1;
  }

  /* When the mandate grid drops to one column a principle card spans the
     row, so its body keeps the reading measure. The text column fills the
     card, so the cap narrows the body only, not the heading. */
  .gp-guild-principles .gp-guild-stack {
    flex: 1;
  }

  .gp-guild-principles :global(.gp-text.gp-guild-principle-body) {
    max-inline-size: var(--gp-measure-reading);
  }

  /* Card grids: each list item is a grid cell so the card stretches to the row
     height, and the card foot sits at the bottom. */
  .gp-guild-grid {
    display: grid;
    gap: var(--gp-space-md);
  }

  .gp-guild-grid.is-two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gp-guild-grid.is-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Hat groups differ in length; each card keeps its own height. */
  .gp-guild-grid.is-auto {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: start;
  }

  .gp-guild-grid > li {
    display: grid;
    min-width: 0;
  }

  .gp-guild-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-sm);
    height: 100%;
    min-width: 0;
  }

  .gp-guild-card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--gp-space-lg);
    margin-block-start: auto;
  }

  .gp-guild-credit {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--gp-space-sm);
    color: var(--gp-fg-muted);
    font-size: var(--gp-body-sm);
  }

  .gp-guild-credit-label {
    font-family: var(--gp-font-mono);
    font-size: var(--gp-label-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── Media and appearances ────────────────────────────────────── */
  .gp-guild-media {
    display: grid;
    gap: var(--gp-space-md);
  }

  .gp-guild-media.has-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  /* A Card list: rows share its border. The first and last rows round their
     own corners to keep a row's hover tone inside the card, so the card needs
     no clip and a focused row shows its whole ring. */
  .gp-guild-media :global(.gp-guild-media-list > li:first-child > .gp-guild-media-row) {
    border-start-start-radius: calc(var(--gp-radius-lg) - 1px);
    border-start-end-radius: calc(var(--gp-radius-lg) - 1px);
  }

  .gp-guild-media :global(.gp-guild-media-list > li:last-child > .gp-guild-media-row) {
    border-end-start-radius: calc(var(--gp-radius-lg) - 1px);
    border-end-end-radius: calc(var(--gp-radius-lg) - 1px);
  }

  .gp-guild-media :global(.gp-guild-media-list > li + li) {
    border-block-start: 1px solid var(--gp-border-soft);
  }

  .gp-guild-media-row {
    display: flex;
    align-items: center;
    gap: var(--gp-space-md);
    min-height: 44px;
    padding: var(--gp-space-md) var(--gp-space-lg);
    color: var(--gp-fg);
    text-decoration: none;
    cursor: pointer;
    transition: background 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-guild-media-row:hover {
    background: var(--gp-card-elev);
  }

