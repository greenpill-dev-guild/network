---
import { getCollection } from 'astro:content';
import GpLayout from '../layouts/GpLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Overline from '../components/ui/Overline.astro';
import Text from '../components/ui/Text.astro';
import Meta from '../components/ui/Meta.astro';
import HomeMap from '../components/page-sections/HomeMap.astro';
import homePage from '../content/home-page.json';
import garden from '../content/garden.json';
import podcast from '../content/podcast.json';
import podcastFeed from '../data/podcast-feed-snapshot.json';
import socialLinks from '../content/social-links.json';
import { getOperationalChapters, getOperationalGuilds } from '../lib/operational-content';
import { publicGuildPath } from '../lib/public-routes';
import NewsletterSignup from '../components/page-sections/NewsletterSignup.astro';
import {
  gardenRampSteps,
  gardenSignupFallback,
  gardenStepHref,
  isGardenSignupStep,
} from '../lib/garden-ramp';

const chapters = await getOperationalChapters();
const guilds = await getOperationalGuilds();
const books = (await getCollection('books')).sort(
  (a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0),
);

const allStories = await getCollection('stories');
const homeStoryRank = new Map((homePage.featuredStorySlugs ?? []).map((slug, index) => [slug, index]));
const publishedStories = allStories
  .filter((s) => s.data.status === 'published' && !s.data.seo?.noindex)
  .sort((a, b) => {
    const aRank = homeStoryRank.get(a.id) ?? Number.POSITIVE_INFINITY;
    const bRank = homeStoryRank.get(b.id) ?? Number.POSITIVE_INFINITY;
    return (
      aRank - bRank ||
      (b.data.featuredWeight ?? 0) - (a.data.featuredWeight ?? 0) ||
      (b.data.publishDate || '').localeCompare(a.data.publishDate || '')
    );
  });

const featuredBooks = books.slice(0, 8);

const devGuild = guilds.find((g) => g.id === 'dev-guild');
const writersGuild = guilds.find((g) => g.id === 'writers-guild');
const devGuildPath = publicGuildPath(devGuild?.id);
const writersGuildPath = publicGuildPath(writersGuild?.id);

// Same source as the Library: the RSS feed snapshot, refreshed at build time.
const podcastEpisodeCount = `${podcastFeed.episodeCount} episodes`;
const applePodcastsHref = 'https://podcasts.apple.com/us/podcast/greenpill/id1609313639';

const activeChapterCount = chapters.length;

// Ecosystem entries are editorial content in home-page.json: one row of
// partner communities and one row of tools, each linking to the
// organization's own site. Incomplete entries are skipped, not rendered.
type EcosystemEntry = { name?: string; blurb?: string; href?: string };
const isListableOrg = (org: EcosystemEntry) =>
  Boolean(org.name?.trim() && org.href && /^https:\/\//.test(org.href));
const ecosystemRows = [
  { key: 'partners', label: 'Partners and collaborators', items: homePage.ecosystem?.partners ?? [] },
  { key: 'tools', label: 'Tools we build with', items: homePage.ecosystem?.tools ?? [] },
]
  .map((row) => ({ ...row, items: (row.items as EcosystemEntry[]).filter(isListableOrg) }))
  .filter((row) => row.items.length > 0);

// With no steps in garden.json the home page leaves the ramp section out.
const gardenSteps = gardenRampSteps(garden.steps).slice(0, 4);

const heroTitle = homePage.hero?.title || homePage.title || 'A global regenerative network.';
const heroDek = homePage.hero?.body || homePage.hero?.dek ||
  `Drop in to see who you connect with - by theme, role, and what you bring or seek. ${activeChapterCount} chapters and counting.`;

// The hero's primary action browses the map when it points at it; HomeMap
// then opens its node list. Any other URL is an ordinary link.
const MAP_ANCHOR = '#network-map';
const primaryCta = homePage.hero?.primaryCta ?? { label: 'Find your people', href: MAP_ANCHOR };
const primaryBrowsesMap = primaryCta.href === MAP_ANCHOR;
const secondaryCta = homePage.hero?.secondaryCta ?? { label: 'Browse chapters', href: '/chapters' };
---

<GpLayout
  title={homePage.seo?.title || 'Greenpill Network'}
  description={homePage.seo?.description || heroDek}
  ogImage={homePage.seo?.ogImage || undefined}
  canonicalPath={homePage.seo?.canonicalPath || '/'}
  noindex={homePage.seo?.noindex}
  activeNav="Home"
  backgroundMode="plain"
>
  <main class="gp-home" id="home-top">
    <section class="gp-home-hero">
      <Container size="2xl">
        <div class="gp-home-hero-inner">
          <Text variant="display" class="gp-home-hero-title">{heroTitle}</Text>

          <div class="gp-home-hero-map">
            <HomeMap />
          </div>

          <Text variant="body-lg" class="gp-home-hero-dek">{heroDek}</Text>

          <div class="gp-home-hero-actions">
            <Button
              href={primaryCta.href}
              data-home-map-browse={primaryBrowsesMap ? '' : undefined}
              aria-haspopup={primaryBrowsesMap ? 'dialog' : undefined}
            >{primaryCta.label}</Button>
            <Button href={secondaryCta.href} variant="ghost">{secondaryCta.label}</Button>
          </div>
        </div>
      </Container>
    </section>

    <section class="gp-home-section gp-home-stories">
      <Container size="2xl">
        <div class="gp-home-section-head">
          <div class="gp-home-section-head-copy">
            <Overline>Stories · From the field</Overline>
            <Text variant="h2">Stories from the network.</Text>
          </div>
          <ArrowLink href="/stories">See all stories</ArrowLink>
        </div>

        {publishedStories.length > 0 ? (
          <div class={`gp-home-stories-grid count-${Math.min(publishedStories.length, 4)}`}>
            {publishedStories.slice(0, 4).map((story, idx) => {
              const region = (story.data.region || 'global').replace(/-/g, ' ');
              return (
                <Card href={`/stories/${story.id}`} stack="md" class={`gp-home-story is-row-${idx + 1}`}>
                  <div class="gp-home-story-art" aria-hidden="true">
                    {story.data.image ? (
                      <img src={story.data.image} alt={story.data.media?.imageAlt || ''} loading="lazy" decoding="async" />
                    ) : (
                      <span class="gp-home-story-art-fallback"></span>
                    )}
                  </div>
                  <div class="gp-home-story-copy">
                    <Meta items={[story.data.category || 'story', region]} accentIndex={0} />
                    <Text variant="h3" class="gp-home-story-title">{story.data.title}</Text>
                    <Text variant="body-sm" class="gp-home-story-blurb">
                      {story.data.excerpt || story.data.dek}
                    </Text>
                    <ArrowLink size="sm">Read the story</ArrowLink>
                  </div>
                </Card>
              );
            })}
          </div>
        ) : (
          <Card variant="elevated" padded="lg" class="gp-home-stories-empty">
            <div class="gp-home-stories-empty-visual" aria-hidden="true"></div>
            <div class="gp-home-stories-empty-copy">
              <Meta items={['Field notes', 'Steward review']} accentIndex={0} />
              <Text variant="h3">Published chapter stories are being prepared.</Text>
              <Text variant="body" class="gp-home-stories-empty-body">
                Each story will cite a public source. Until more land here, the live conversations continue on Paragraph and the Regen Coordination Hub.
              </Text>
              <div class="gp-home-stories-actions">
                <Button href="https://paragraph.com/@greenpill" variant="ghost">Read drafts on Paragraph</Button>
              </div>
            </div>
          </Card>
        )}
      </Container>
    </section>

    <section class="gp-home-section">
      <Container size="2xl">
        <div class="gp-home-section-head">
          <div class="gp-home-section-head-copy">
            <Overline>Library · Knowledge commons</Overline>
            <Text variant="h2">The Greenpill commons.</Text>
            <Text variant="body" class="gp-home-section-dek">
              Books, podcast conversations, and public guild writing: open and made by the network.
            </Text>
          </div>
          <ArrowLink href="/library">Browse the library</ArrowLink>
        </div>

        <div class="gp-home-lib-grid">
          <Card variant="elevated" padded="lg" stack="md" class="gp-home-lib-books">
            <header class="gp-home-lib-head">
              <Overline>Books · {books.length} titles</Overline>
              <Text variant="mono">All free</Text>
            </header>
            <Text variant="h3">Read the books.</Text>
            <div class="gp-home-book-grid">
              {featuredBooks.map((book, index) => {
                const href = book.data.ebookLink || '/library';
                const eager = index < 4;
                return (
                  <a class="gp-home-book" href={href}>
                    {book.data.image && (
                      <img
                        src={book.data.image}
                        alt={book.data.imageAlt}
                        width={book.data.imageWidth ?? 200}
                        height={book.data.imageHeight ?? 300}
                        loading={eager ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    )}
                    <span class="gp-home-book-meta">{book.data.title}</span>
                  </a>
                );
              })}
            </div>
            <footer class="gp-home-lib-foot">
              <Text variant="caption">Multiple translations · field-tested</Text>
              <ArrowLink href="/library#books" size="sm">Browse all</ArrowLink>
            </footer>
          </Card>

          <Card variant="elevated" padded="lg" stack="md" class="gp-home-lib-podcast">
            <header class="gp-home-lib-head">
              <Overline>Podcast · {podcastEpisodeCount}</Overline>
              <Text variant="mono">Public archive</Text>
            </header>
            <div class="gp-home-podcast-body">
              <div class="gp-home-podcast-cover">
                <img
                  src="/images/podcast-cover.png"
                  alt="Greenpill Podcast cover artwork"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="gp-home-podcast-copy">
                <Text variant="mono">Hosted by Kevin Owocki and guests</Text>
                <Text variant="h3">{podcast.title || 'The Greenpill Podcast'}</Text>
                <Text variant="body-sm">{podcast.description}</Text>
                {podcast.secondaryDescription && (
                  <Text variant="body-sm">{podcast.secondaryDescription}</Text>
                )}
                <div class="gp-home-podcast-cta">
                  <Button href={applePodcastsHref} variant="ghost">Listen on Apple Podcasts</Button>
                  <ArrowLink href={podcast.youtubeLink || 'https://www.youtube.com/@Green_Pill_Podcast'} size="sm">Watch on YouTube</ArrowLink>
                </div>
              </div>
            </div>
          </Card>

          {(devGuild && devGuildPath) || (writersGuild && writersGuildPath) ? (
            <div class="gp-home-lib-guild-pair">
              {devGuild && devGuildPath && (
                <Card href={devGuildPath} stack="sm" class="gp-home-lib-tile gp-home-lib-dev">
                  <Overline>Guild · {devGuild.data.status}</Overline>
                  <Text variant="h3">{devGuild.data.name}</Text>
                  <Text variant="body-sm">{devGuild.data.summary}</Text>
                  <div class="gp-home-lib-guild-foot">
                    <Text variant="mono">Open-source coordination tools</Text>
                    <ArrowLink size="sm">Visit guild</ArrowLink>
                  </div>
                </Card>
              )}

              {writersGuild && writersGuildPath && (
                <Card href={writersGuildPath} stack="sm" class="gp-home-lib-tile gp-home-lib-writers">
                  <Overline tone="muted">Guild · {writersGuild.data.status}</Overline>
                  <Text variant="h3">{writersGuild.data.name}</Text>
                  <Text variant="body-sm">{writersGuild.data.summary}</Text>
                  <div class="gp-home-lib-guild-foot">
                    <Text variant="mono">Stories, translations, longform</Text>
                    <ArrowLink size="sm">Visit guild</ArrowLink>
                  </div>
                </Card>
              )}
            </div>
          ) : null}
        </div>
      </Container>
    </section>

    <section class="gp-home-section gp-home-eco">
      <Container size="2xl">
        <div class="gp-home-eco-intro">
          <Overline>Ecosystem · Communities we coordinate with</Overline>
          <Text variant="h2" class="gp-home-eco-title">Stronger together.</Text>
          <Text variant="body" class="gp-home-eco-dek">
            Greenpill works inside a wider regenerative web3 ecosystem of funders, builders, and storytellers.
            These are the communities we work alongside and the tools we build with.
          </Text>
        </div>

        {ecosystemRows.map((row) => (
          <div class={`gp-home-eco-row is-${row.key}`}>
            <Overline as="h3" tone="muted" class="gp-home-eco-label">{row.label}</Overline>
            <ul class="gp-home-eco-grid" role="list">
              {row.items.map((org) => (
                <li class="gp-home-eco-item">
                  <Card href={org.href} padded="sm" class="gp-home-eco-tile">
                    <span class="gp-home-eco-mark" aria-hidden="true"></span>
                    <span class="gp-home-eco-name">{org.name}</span>
                    {org.blurb && <span class="gp-home-eco-blurb">{org.blurb}</span>}
                  </Card>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </Container>
    </section>

    {gardenSteps.length > 0 && (
      <section class="gp-home-section gp-home-garden" id="garden-ramp">
        <Container size="2xl">
          <div class="gp-home-section-head">
            <div class="gp-home-section-head-copy">
              <Overline>Participate · Enter the Garden</Overline>
              <Text variant="h2">Meet the network where you are.</Text>
              <Text variant="body" class="gp-home-section-dek">
                Four public, low-pressure ways into Greenpill. Pick whichever matches the moment you are in.
              </Text>
            </div>
            <ArrowLink href="/garden">Open the Garden</ArrowLink>
          </div>

          <div class="gp-home-garden-grid">
            {gardenSteps.map((step, index) => {
              const href = gardenStepHref(step, socialLinks);
              const signupFallback = isGardenSignupStep(step) ? gardenSignupFallback(step) : null;
              return (
                <Card as="article" stack="md" class="gp-home-garden-card">
                  <header class="gp-home-garden-head">
                    <span class="gp-home-garden-num">{String(step.level ?? index + 1).padStart(2, '0')}</span>
                    {step.friction && <Text variant="mono">{step.friction}</Text>}
                  </header>
                  <Text variant="h3" class="gp-home-garden-title">{step.title}</Text>
                  <Text variant="body-sm" class="gp-home-garden-body">{step.body}</Text>
                  <footer class="gp-home-garden-foot">
                    {signupFallback ? (
                      <NewsletterSignup
                        id={`home-newsletter-${index + 1}`}
                        fallbackHref={signupFallback.href}
                        fallbackLabel={signupFallback.label}
                      />
                    ) : href && step.cta?.label && (
                      <Button href={href} variant="ghost">{step.cta.label}</Button>
                    )}
                  </footer>
                </Card>
              );
            })}
          </div>
        </Container>
      </section>
    )}
  </main>
</GpLayout>

<style>
  .gp-home {
    min-height: 100dvh;
    background: transparent;
  }

  /* Hero composition: stacked centered — H1 → map → dek → CTAs */
  .gp-home-hero {
    position: relative;
    overflow: hidden;
    min-block-size: calc(100dvh - var(--gp-header-height));
    display: flex;
    align-items: center;
    padding: clamp(var(--gp-space-md), 3dvh, var(--gp-space-xl)) 0 clamp(var(--gp-space-lg), 3dvh, var(--gp-space-2xl));
  }

  .gp-home-hero :global(.gp-container) {
    width: min(100%, calc(var(--gp-container-2xl) + (4 * var(--gp-space-5xl))));
  }

  .gp-home-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.8dvh, var(--gp-space-lg));
    text-align: center;
  }

  .gp-home-hero-inner :global(.gp-home-hero-title) {
    max-width: 100%;
    text-wrap: balance;
  }

  @container (min-width: 900px) {
    .gp-home-hero-inner :global(.gp-home-hero-title) {
      white-space: nowrap;
      text-wrap: nowrap;
    }
  }

  /* The map sizes itself (see HomeMap); the hero only gives it the full row. */
  .gp-home-hero-map {
    width: 100%;
  }

  .gp-home-hero-inner :global(.gp-home-hero-dek) {
    max-width: 56ch;
    color: var(--gp-fg-muted);
    line-height: 1.45;
  }

  .gp-home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Section frame */
  .gp-home-section {
    padding: clamp(var(--gp-space-3xl), 7vw, var(--gp-space-4xl)) 0;
    border-top: 0;
  }

  .gp-home-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gp-space-xl);
    flex-wrap: wrap;
    margin-bottom: clamp(var(--gp-space-xl), 3vw, var(--gp-space-2xl));
  }

  .gp-home-section-head-copy {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
    max-width: 640px;
  }

  .gp-home-section-head-copy :global(.gp-home-section-dek) {
    color: var(--gp-fg-muted);
    max-width: 60ch;
  }

  /* Stories grid — HiFi bento: one large story + three smaller. */
  .gp-home-stories-grid {
    display: grid;
    gap: clamp(14px, 1.5vw, 20px);
  }

  .gp-home-stories-grid.count-4 {
    grid-template-columns: 1.15fr 0.95fr 0.95fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }
  .gp-home-stories-grid.count-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .gp-home-stories-grid.count-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gp-home-stories-grid.count-1 { grid-template-columns: minmax(0, 1fr); }

  /* Story cards are Card links (components/ui/Card.astro); the page only
     places them in the bento. */
  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-1) {
    grid-column: 1 / 3;
    grid-row: 1 / 2;
    display: grid;
    grid-template-columns: minmax(180px, 0.78fr) minmax(0, 1fr);
    align-items: center;
  }
  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-2) { grid-column: 3 / 4; grid-row: 1 / 2; }
  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-3) { grid-column: 1 / 2; grid-row: 2 / 3; }
  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-4) {
    grid-column: 2 / 4;
    grid-row: 2 / 3;
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1fr);
    align-items: center;
  }

  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-1) .gp-home-story-art,
  .gp-home-stories-grid.count-4 :global(.gp-home-story.is-row-4) .gp-home-story-art {
    height: 100%;
    min-height: 180px;
    aspect-ratio: auto;
  }

  .gp-home-story-art {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--gp-radius-md);
    overflow: hidden;
    background: var(--gp-green-800);
    position: relative;
  }

  .gp-home-story-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gp-home-story-art-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(240, 220, 160, 0.18), transparent 60%),
      url('/images/hifi/topo-bg.png');
    background-size: auto, cover;
    background-position: center;
    opacity: 0.6;
    mix-blend-mode: overlay;
  }

  .gp-home-story-copy {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-sm);
  }

  .gp-home-story-copy :global(.gp-home-story-title) {
    text-wrap: pretty;
  }

  .gp-home-story-copy :global(.gp-home-story-blurb) {
    color: var(--gp-fg-muted);
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  /* Stories empty state — matches DESIGN.md State Patterns spec: small
     placeholder visual + headline + body + single ghost CTA, sitting on
     a card-elevated surface. Lays out as a two-column composition that
     gestures at the bento rhythm without pretending to be one. The
     outer card is rendered by the Card component, so the section reaches
     it through :global() while the visual/copy children inside the page
     template stay scoped. */
  .gp-home-stories :global(.gp-home-stories-empty) {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(var(--gp-space-lg), 3vw, var(--gp-space-2xl));
    align-items: center;
  }

  .gp-home-stories-empty-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 220px;
    border-radius: var(--gp-radius-lg);
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(240, 220, 160, 0.22), transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(184, 232, 53, 0.12), transparent 65%),
      var(--gp-green-800);
  }

  .gp-home-stories-empty-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/hifi/topo-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.45;
    mix-blend-mode: overlay;
  }

  .gp-home-stories-empty-copy {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
    min-width: 0;
  }

  .gp-home-stories-empty-copy :global(.gp-home-stories-empty-body) {
    color: var(--gp-fg-muted);
    max-width: 60ch;
  }

  .gp-home-stories-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--gp-space-xs);
  }

  /* Library bento: books span both rows on the left; podcast over the guild
     pair on the right. */
  .gp-home-lib-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: clamp(14px, 1.5vw, 20px);
  }

  .gp-home-lib-grid :global(.gp-home-lib-books) {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
  }

  .gp-home-lib-grid :global(.gp-home-lib-podcast) {
    grid-column: 6 / 13;
    grid-row: 1 / 2;
  }

  .gp-home-lib-guild-pair {
    grid-column: 6 / 13;
    grid-row: 2 / 3;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(14px, 1.5vw, 20px);
    min-width: 0;
  }

  .gp-home-lib-guild-pair :global(.gp-home-lib-tile) {
    min-height: 100%;
  }

  .gp-home-lib-guild-pair :global(.gp-home-lib-tile .gp-text.is-body-sm) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .gp-home-lib-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .gp-home-lib-guild-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

