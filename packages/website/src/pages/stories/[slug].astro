---
import { getCollection } from 'astro:content';
import GpLayout from '../../layouts/GpLayout.astro';
import Container from '../../components/ui/Container.astro';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import Overline from '../../components/ui/Overline.astro';
import Text from '../../components/ui/Text.astro';
import Meta from '../../components/ui/Meta.astro';
import Breadcrumb from '../../components/shell/Breadcrumb.astro';
import Avatar from '../../components/ui/Avatar.astro';
import YouTubePlayer from '../../components/ui/YouTubePlayer.astro';
import { publicGuildPath } from '../../lib/public-routes';
import { isYouTubeId, parseTimestamp, youtubeWatchUrl } from '../../lib/youtube';
import { getOperationalChapterPages, getOperationalGuilds } from '../../lib/operational-content';
import { formatStoryDate, storyCategoryLabel, storyMetaItems, storyReadTime } from './_story-format';

export async function getStaticPaths() {
  const items = await getCollection('stories');
  return items
    .filter((item) => item.data.status === 'published' && !item.data.seo?.noindex)
    .map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const data = item.data;

const allStories = await getCollection('stories');
const continueIds: string[] = (data.continueReadingStorySlugs ?? []).length > 0
  ? data.continueReadingStorySlugs
  : (data.relatedStorySlugs ?? []);

const continueReading = continueIds
  .map((slug) => allStories.find((s) => s.id === slug && s.data.status === 'published'))
  .filter((s): s is typeof allStories[number] => Boolean(s));

type StoryBodyBlock =
  | { kind: 'p' | 'h2' | 'quote'; text: string }
  | { kind: 'ul' | 'ol'; items: string[] };

function bodyToBlocks(body: string): StoryBodyBlock[] {
  if (!body) return [];
  return body.split(/\n{2,}/).flatMap((segment) => {
    const trimmed = segment.trim();
    if (!trimmed) return [];
    const lines = trimmed.split('\n').map((line) => line.trim()).filter(Boolean);
    if (trimmed.startsWith('## ')) return { kind: 'h2' as const, text: trimmed.slice(3) };
    if (trimmed.startsWith('> ')) return { kind: 'quote' as const, text: trimmed.slice(2) };
    if (lines.length > 0 && lines.every((line) => /^[-*]\s+/.test(line))) {
      return { kind: 'ul' as const, items: lines.map((line) => line.replace(/^[-*]\s+/, '')) };
    }
    if (lines.length > 0 && lines.every((line) => /^\d+\.\s+/.test(line))) {
      return { kind: 'ol' as const, items: lines.map((line) => line.replace(/^\d+\.\s+/, '')) };
    }
    return { kind: 'p' as const, text: trimmed };
  });
}

function linkifyText(text: string) {
  return text
    .split(/(https?:\/\/[^\s]+)/g)
    .filter(Boolean)
    .map((part) => ({
      text: part,
      href: /^https?:\/\//.test(part) ? part : '',
    }));
}

const bodyBlocks = bodyToBlocks(data.body || '');
// The editor's Read Time field wins when filled; otherwise estimate from the body.
const heroMeta = [...storyMetaItems(data), data.readTime?.trim() || storyReadTime(data.body)];
const sources = (data.proofSignals ?? []).filter((signal) => signal.value || signal.label);

// Related chips use the public chapter and guild names, never the slugs.
const relatedChapter = data.relatedChapter
  ? (await getOperationalChapterPages()).find((chapter) => chapter.id === data.relatedChapter)
  : undefined;
const relatedGuild = data.relatedGuild || '';
const relatedGuildPath = publicGuildPath(relatedGuild);
const relatedGuildName = relatedGuildPath
  ? (await getOperationalGuilds()).find((guild) => guild.id === relatedGuild)?.data.name || ''
  : '';
const storyImage = data.media?.image || data.image || '';
const storyImageAlt = data.media?.imageAlt || `${data.title} story image`;

// A story about a video plays it in the header, with the story image as the
// poster, and lists the chapters a reader can jump to. A chapter whose start
// does not read as mm:ss or h:mm:ss is left out.
const videoId = data.video?.youtubeId?.trim() ?? '';
const hasVideo = isYouTubeId(videoId) && Boolean(storyImage);
const videoChapters = hasVideo
  ? (data.video?.chapters ?? []).flatMap((chapter) => {
    const start = parseTimestamp(chapter.start);
    const label = chapter.label.trim();
    return start === undefined || !label ? [] : [{ start, time: chapter.start.trim(), label }];
  })
  : [];
---

<GpLayout
  title={data.seo?.title || `${data.title} · Greenpill Stories`}
  description={data.seo?.description || data.excerpt || ''}
  ogImage={data.seo?.ogImage || data.media?.ogImage || undefined}
  canonicalPath={data.seo?.canonicalPath || `/stories/${item.id}`}
  noindex={data.seo?.noindex}
  activeNav="Stories"
  ogType="article"
>
  <main class="gp-story">
    <header class="gp-story-hero gp-topo">
      <Container size="lg">
        <Breadcrumb
          back={{ label: 'All stories', href: '/stories' }}
          crumbs={[{ label: data.title }]}
        />
        <div class="gp-story-hero-inner">
          <Meta items={heroMeta} accentIndex={0} />
          <Text variant="display" class="gp-story-title">{data.title}</Text>
          {data.dek && <Text variant="body-lg" class="gp-story-dek">{data.dek}</Text>}
          {!data.dek && data.excerpt && <Text variant="body-lg" class="gp-story-dek">{data.excerpt}</Text>}

          {data.author && (
            <div class="gp-story-byline">
              <Avatar name={data.author} size={48} />
              <div>
                <Text variant="title-md">{data.author}</Text>
                {data.authorRole && <Text variant="caption">{data.authorRole}</Text>}
              </div>
            </div>
          )}

          {hasVideo ? (
            <div class="gp-story-hero-video">
              <YouTubePlayer
                id="story-video"
                videoId={videoId}
                title={data.title}
                poster={storyImage}
                duration={data.video?.duration}
                eager
              />
              {videoChapters.length > 0 && (
                <div class="gp-story-chapters">
                  <Overline as="h2" tone="muted">Chapters</Overline>
                  <ol class="gp-story-chapter-list" role="list">
                    {videoChapters.map((chapter) => (
                      <li>
                        <a
                          class="gp-story-chapter"
                          href={youtubeWatchUrl(videoId, chapter.start)}
                          target="_self"
                          data-youtube-start={chapter.start}
                          data-youtube-target="story-video"
                        >
                          <span class="gp-story-chapter-time">{chapter.time}</span>
                          <span class="gp-story-chapter-label">{chapter.label}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </div>
          ) : storyImage && (
            <Card as="figure" padded="none" class="gp-story-hero-media">
              <img src={storyImage} alt={storyImageAlt} loading="eager" decoding="async" />
            </Card>
          )}
        </div>
      </Container>
    </header>

    {bodyBlocks.length > 0 && (
      <section class="gp-story-body">
        <Container size="md">
          <div class="gp-story-prose">
            {bodyBlocks.map((part) => {
              if (part.kind === 'h2') return <h2>{part.text}</h2>;
              if (part.kind === 'quote') return <blockquote>{part.text}</blockquote>;
              if (part.kind === 'ul' || part.kind === 'ol') {
                const Tag = part.kind;
                return (
                  <Tag>
                    {part.items.map((item) => (
                      <li>
                        {linkifyText(item).map((piece) => (
                          piece.href
                            ? <a href={piece.href}>{piece.text}</a>
                            : piece.text
                        ))}
                      </li>
                    ))}
                  </Tag>
                );
              }
              return part.kind === 'p' ? <p>{part.text}</p> : null;
            })}
          </div>
        </Container>
      </section>
    )}

    {sources.length > 0 && (
      <section class="gp-story-section">
        <Container size="lg">
          <div class="gp-story-section-head">
            <Overline as="h2">Sources</Overline>
          </div>
          <ul class="gp-story-proof" role="list">
            {sources.map((signal) => (
              <li>
                <Card href={signal.href || undefined} padded="sm" stack="sm">
                  {signal.source && <Text variant="mono">{signal.source}</Text>}
                  <Text variant="title-md">{signal.value}</Text>
                  {signal.label && <Text variant="body-sm">{signal.label}</Text>}
                </Card>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )}

    {(relatedChapter || relatedGuildName) && (
      <section class="gp-story-section">
        <Container size="lg">
          <div class="gp-story-section-head">
            <Overline>Related</Overline>
            <Text variant="caption">Where this story connects in the network.</Text>
          </div>
          <ul class="gp-story-related">
            {relatedChapter && (
              <li>
                <a class="gp-story-related-chip" href={`/chapters/${relatedChapter.id}`}>
                  Chapter · {relatedChapter.data.name || relatedChapter.id}
                </a>
              </li>
            )}
            {relatedGuildName && (
              <li>
                <a class="gp-story-related-chip" href={relatedGuildPath}>
                  Guild · {relatedGuildName}
                </a>
              </li>
            )}
          </ul>
        </Container>
      </section>
    )}

    {continueReading.length > 0 && (
      <section class="gp-story-section">
        <Container size="lg">
          <div class="gp-story-section-head">
            <Overline>Continue reading</Overline>
            <ArrowLink href="/stories">All stories</ArrowLink>
          </div>
          <div class="gp-story-continue-grid">
            {continueReading.map((c) => (
              <Card href={`/stories/${c.id}`} stack="sm">
                <Meta items={[storyCategoryLabel(c.data.category), formatStoryDate(c.data.publishDate)].filter(Boolean)} accentIndex={0} />
                <Text variant="h3">{c.data.title}</Text>
                {c.data.excerpt && <Text variant="body-sm">{c.data.excerpt}</Text>}
                <ArrowLink size="sm">Read</ArrowLink>
              </Card>
            ))}
          </div>
        </Container>
      </section>
    )}
  </main>
</GpLayout>

<style>
  .gp-story {
    min-height: 100dvh;
    background: transparent;
    /* Inherited: long words / URLs in story content break instead of
       overflowing the viewport on mobile. */
    overflow-wrap: break-word;
  }

  .gp-story-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--gp-space-2xl), 6vw, var(--gp-space-4xl)) 0 var(--gp-space-2xl);
  }

  .gp-story-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-lg);
    margin-top: var(--gp-space-xl);
  }

  .gp-story-hero-inner :global(.gp-story-title) {
    max-width: 24ch;
    font-size: var(--gp-h1-size);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .gp-story-hero-inner :global(.gp-text.gp-story-dek) {
    color: var(--gp-fg-muted);
    max-inline-size: var(--gp-measure-reading);
  }

  .gp-story-byline {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: var(--gp-space-md);
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-story-byline > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* The hero photo sits in a Card figure (components/ui/Card.astro), like
     the chapter hero; the clip keeps it inside the rounded corners. */
  .gp-story-hero-inner :global(.gp-story-hero-media) {
    width: min(100%, 920px);
    aspect-ratio: 16 / 9;
    margin-block-start: var(--gp-space-sm);
    overflow: hidden;
  }

  .gp-story-hero-inner :global(.gp-story-hero-media) img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* A video story: the player (components/ui/YouTubePlayer.astro) takes the
     photo's place and width, with its chapters below it. */
  .gp-story-hero-video {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-lg);
    inline-size: min(100%, 920px);
    margin-block-start: var(--gp-space-sm);
  }

  .gp-story-chapters {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-sm);
  }

  /* Two columns that fill top to bottom, so the times read in order. */
  .gp-story-chapter-list {
    columns: 2;
    column-gap: var(--gp-space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gp-story-chapter-list li {
    break-inside: avoid;
    border-block-end: 1px solid var(--gp-border-soft);
  }

  .gp-story-chapter {
    display: flex;
    align-items: baseline;
    gap: var(--gp-space-md);
    padding-block: var(--gp-space-sm);
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-body-sm);
    line-height: 1.45;
    text-decoration: none;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-story-chapter:hover {
    color: var(--gp-primary);
  }

  .gp-story-chapter-time {
    flex: none;
    min-inline-size: 5ch;
    color: var(--gp-fg-muted);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .gp-story-chapter-label {
    min-inline-size: 0;
  }

  @media (pointer: coarse) {
    .gp-story-chapter {
      min-block-size: 44px;
      align-items: center;
    }
  }

  .gp-story-body {
    padding: clamp(var(--gp-space-2xl), 5vw, var(--gp-space-4xl)) 0;
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-story-prose {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-lg);
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: 17px;
    line-height: 1.7;
  }

  .gp-story-prose p {
    margin: 0;
  }

  /* The reading measure (DESIGN.md, Typography). Paragraphs and list items
     stop there; headings and quotes keep the full column. */
  .gp-story-prose > p,
  .gp-story-prose li {
    max-inline-size: var(--gp-measure-reading);
  }

  .gp-story-prose ul,
  .gp-story-prose ol {
    margin: 0;
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .gp-story-prose li {
    padding-inline-start: 0.2rem;
  }

  .gp-story-prose a {
    color: var(--gp-secondary);
    text-decoration-color: rgba(184, 232, 53, 0.5);
    text-underline-offset: 0.18em;
  }

  .gp-story-prose a:hover {
    text-decoration-color: var(--gp-primary);
  }

  .gp-story-prose h2 {
    margin: var(--gp-space-xl) 0 0;
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-h3-size);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .gp-story-prose blockquote {
    margin: 0;
    padding-block: var(--gp-space-md);
    padding-inline: var(--gp-space-lg) 0;
    border-inline-start: 3px solid var(--gp-primary);
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-title-lg);
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }

  .gp-story-section {
    padding: clamp(var(--gp-space-2xl), 5vw, var(--gp-space-3xl)) 0;
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-story-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gp-space-md);
    flex-wrap: wrap;
    margin-bottom: var(--gp-space-lg);
  }

  /* Each source is a Card (a link when it has a URL); the list item is its
     grid cell, so cards in a row share a height. */
  .gp-story-proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gp-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gp-story-proof li {
    display: grid;
    min-width: 0;
  }

  .gp-story-related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gp-story-related-chip {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    border: 1px solid var(--gp-border);
    border-radius: var(--gp-radius-pill);
    color: var(--gp-fg-muted);
    font-family: var(--gp-font-body);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 200ms, color 200ms;
  }

  a.gp-story-related-chip:hover {
    border-color: rgba(184, 232, 53, 0.42);
    color: var(--gp-primary);
  }

  .gp-story-continue-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gp-space-md);
  }

  @container (max-width: 720px) {
    .gp-story-continue-grid {
      grid-template-columns: 1fr;
    }

    .gp-story-chapter-list {
      columns: 1;
    }
  }
</style>
