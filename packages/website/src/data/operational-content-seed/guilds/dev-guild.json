    {
      "order": 1,
      "title": "Public by default",
      "body": "Use public repositories, public docs, and public grant updates whenever they can carry the claim."
    },
    {
      "order": 2,
      "title": "Integrate before rebuilding",
      "body": "Frame the guild around practical coordination infrastructure and integrations with tools such as EAS, Gitcoin, Allo, KarmaGAP, and Green Goods."
    },
    {
      "order": 3,
      "title": "Chapter-informed tooling",
      "body": "Show how tools support local chapters and real regenerative work, not software for its own sake."
    }
