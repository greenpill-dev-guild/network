---
import socialLinks from '../../content/social-links.json';

// Each column holds at most four links (Afo, November 2026): Connect keeps
// X / Twitter, Telegram, LinkedIn and YouTube, Farcaster is gone, and the
// Regen Hub sits under Resources. Outside links, the GitHub one in the
// bottom row and the steward booking link included, come from
// content/social-links.json, so an editor changes each in one place; the
// Garden ramp and its assessment read the same booking link. A link left
// without a URL is not shown (Keystatic also requires these fields).
const columns = [
  {
    heading: 'Network',
    items: [
      { label: 'Chapters', href: '/chapters' },
      { label: 'Dev Guild', href: '/guilds/dev-guild' },
      { label: 'Writers Guild', href: '/guilds/writers-guild' },
      { label: 'Code of Conduct', href: socialLinks.codeOfConduct },
    ],
  },
  {
    heading: 'Get involved',
    items: [
      { label: 'Start in the Garden', href: '/garden' },
      { label: 'Events calendar', href: socialLinks.events },
      { label: 'Join the map', href: '/#join-map' },
      { label: 'Talk to a steward', href: socialLinks.stewardCall },
    ],
  },
  {
    heading: 'Resources',
    items: [
      { label: 'Library', href: '/library' },
      { label: 'Stories', href: '/stories' },
      { label: 'Podcast', href: '/library#podcast' },
      { label: 'Regen Hub', href: socialLinks.hub },
    ],
  },
  {
    heading: 'Connect',
    items: [
      { label: 'X / Twitter', href: socialLinks.twitter },
      { label: 'Telegram', href: socialLinks.telegram },
      { label: 'LinkedIn', href: socialLinks.linkedin },
      { label: 'YouTube', href: socialLinks.youtube },
    ],
  },
];

// Built hourly, so the year stays current without an edit.
const year = new Date().getFullYear();
---

<footer class="gp-site-footer">
  <div class="gp-footer-grid">
    {columns.map((column) => (
      <div class="gp-footer-column">
        <div class="gp-footer-heading">{column.heading}</div>
        <nav aria-label={column.heading}>
          {column.items.filter((item) => item.href).map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    ))}
  </div>

  <div class="gp-footer-bottom">
    <span>© {year} Greenpill Network</span>
    {socialLinks.github && <a href={socialLinks.github}>Built in the open on GitHub</a>}
  </div>
</footer>

<style>
  .gp-site-footer {
    position: relative;
    margin-top: 0;
    padding: var(--gp-space-4xl) clamp(var(--gp-space-lg), 6vw, var(--gp-space-4xl)) var(--gp-space-3xl);
    border-top: 1px solid var(--gp-border-soft);
  }

  .gp-footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gp-space-2xl);
    align-items: start;
    max-width: var(--gp-container-2xl);
    margin-inline: auto;
  }

  .gp-footer-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .gp-footer-heading {
    color: var(--gp-primary);
    font-family: var(--gp-font-body);
    font-size: var(--gp-overline);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .gp-footer-column nav {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-sm);
  }

  .gp-footer-column a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--gp-fg-muted);
    font-size: var(--gp-body-sm);
    line-height: 1.4;
    text-decoration: none;
    transition: color 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-footer-column a:hover {
    color: var(--gp-primary);
  }

  .gp-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--gp-space-sm) var(--gp-space-lg);
    max-width: var(--gp-container-2xl);
    margin: var(--gp-space-3xl) auto 0;
    padding-top: var(--gp-space-lg);
    border-top: 1px solid var(--gp-border-soft);
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .gp-footer-bottom a {
    color: var(--gp-fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--gp-border);
    text-underline-offset: 0.2em;
    transition: color 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-footer-bottom a:hover {
    color: var(--gp-primary);
  }

  @media (max-width: 900px) {
    .gp-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .gp-site-footer {
      padding: var(--gp-space-3xl) var(--gp-space-lg) var(--gp-space-xl);
    }

    .gp-footer-grid {
      gap: var(--gp-space-xl) var(--gp-space-lg);
    }

    .gp-footer-bottom {
      flex-direction: column;
    }
  }
</style>
