---
import Overline from './Overline.astro';
import Text from './Text.astro';

/**
 * CtaStrip: the page-level call to action (DESIGN.md > Components > Calls to
 * action). Overline, headline and muted body on the left; the actions slot
 * (one primary Button, at most one ghost Button) on the right. Copy and
 * actions stack when the container is 760px wide or less.
 *
 * - `lift` (default): a `surface` panel with a soft border. Lime stays on the
 *   primary button; the panel itself carries no lime border, tint or glow.
 * - `soft`: no panel, only a hairline rule above.
 */
interface Props {
  overline?: string;
  title: string;
  body?: string;
  tone?: 'lift' | 'soft';
  class?: string;
}

const {
  overline,
  title,
  body,
  tone = 'lift',
  class: className,
} = Astro.props;
const classes = ['gp-cta-strip', `is-${tone}`, className].filter(Boolean).join(' ');
---

<div class={classes}>
  <div class="gp-cta-copy">
    {overline && <Overline text={overline} />}
    <Text variant="h2">{title}</Text>
    {body && <Text variant="body" class="gp-cta-body">{body}</Text>}
  </div>
  <div class="gp-cta-actions">
    <slot />
  </div>
</div>

<style>
  .gp-cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gp-space-xl);
  }

  .gp-cta-strip.is-lift {
    padding-block: var(--gp-space-3xl);
    padding-inline: var(--gp-space-2xl);
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-xl);
    background: var(--gp-surface);
  }

  .gp-cta-strip.is-soft {
    padding-block: var(--gp-space-2xl);
    border-block-start: 1px solid var(--gp-border-soft);
    background: transparent;
  }

  .gp-cta-copy {
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-sm);
    inline-size: 100%;
    max-inline-size: 620px;
    min-inline-size: 0;
  }

  /* Text's own rules set the body colour; naming .gp-text outranks them. */
  .gp-cta-copy :global(.gp-text.gp-cta-body) {
    color: var(--gp-fg-muted);
  }

  .gp-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gp-space-sm);
    flex: none;
  }

  @container (max-width: 760px) {
    .gp-cta-strip {
      align-items: flex-start;
      flex-direction: column;
    }

    .gp-cta-strip.is-lift {
      padding-block: var(--gp-space-2xl);
      padding-inline: var(--gp-space-lg);
    }

    .gp-cta-actions {
      inline-size: 100%;
      min-inline-size: 0;
    }
  }
</style>
