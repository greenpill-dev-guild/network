---
interface Props {
  id?: string;
  placeholder?: string;
  label?: string;
  /** `null` leaves the field out of a native form submission. */
  name?: string | null;
  class?: string;
  autocomplete?: string;
  required?: boolean;
  maxlength?: number;
  spellcheck?: 'true' | 'false';
  'aria-describedby'?: string;
}

const {
  placeholder = 'you@email.com',
  label,
  name = 'email',
  class: className,
  ...attrs
} = Astro.props;
const classes = ['gp-email-field', className].filter(Boolean).join(' ');
---

<label class={classes}>
  {label && <span>{label}</span>}
  <input type="email" name={name} placeholder={placeholder} {...attrs} />
</label>

<style>
  .gp-email-field {
    display: flex;
    flex: 1 1 220px;
    flex-direction: column;
    gap: var(--gp-space-sm);
    min-width: min(100%, 220px);
  }

  .gp-email-field span {
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-label-md);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .gp-email-field input {
    appearance: none;
    width: 100%;
    min-height: 48px;
    padding: 0 18px;
    /* The outline is what shows where the field is, so it needs 3:1
       (WCAG 1.4.11): green-300 reads 3.3:1 on the illustrated background
       and 4.3:1 against the field's own fill. The old green-500 border
       read 1.0:1 over a bright stroke and 2.4:1 on the plain canvas. */
    border: 1px solid var(--gp-green-300);
    border-radius: var(--gp-radius-pill);
    background: var(--gp-green-900);
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-body-md);
    line-height: 1;
    outline: none;
  }

  .gp-email-field input::placeholder {
    color: var(--gp-fg-dim);
  }

  .gp-email-field input:focus {
    border-color: var(--gp-primary);
  }

  /* After the focus rule, so a field marked invalid keeps its error border. */
  .gp-email-field input[aria-invalid='true'] {
    border-color: var(--gp-error);
  }
</style>
