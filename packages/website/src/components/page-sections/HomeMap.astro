---
import { getOperationalChapters } from '../../lib/operational-content';
import { PUBLIC_MAP_THEMES } from '@greenpill-network/shared/map-state';
import {
  derivePublicBioregionMetadataFromCoordinates,
} from '@greenpill-network/shared/map-nodes';
import { WORLD_LAND_RINGS, type WorldLandRing } from '../../data/world-land-rings';

// Add-node walkthrough theme choices use the canonical public theme list.
const mapThemes = PUBLIC_MAP_THEMES;

// Edge color carries theme meaning; node fill carries node identity. The base
// IDs come from the shared public map contract; aliases keep older content IDs
// readable without duplicating the canonical palette.
const THEME_ALIASES: Record<string, { target: string; label: string }> = {
  currency: { target: 'mutual', label: 'Mutual Aid' },
  'public-goods': { target: 'public', label: 'Public Goods' },
  'local-regeneration': { target: 'trees', label: 'Local Regeneration' },
  'knowledge-commons': { target: 'education', label: 'Knowledge Commons' },
  'coordination-tools': { target: 'opensrc', label: 'Coordination Tools' },
  opensource: { target: 'opensrc', label: 'Open Source' },
  'open-source': { target: 'opensrc', label: 'Open Source' },
};

const canonicalThemeInfo = Object.fromEntries(
  mapThemes.map((theme) => [theme.id, { label: theme.label, color: theme.color }])
) as Record<string, { label: string; color: string }>;

const THEME_INFO: Record<string, { label: string; color: string }> = {
  ...canonicalThemeInfo,
  ...Object.fromEntries(
    Object.entries(THEME_ALIASES).map(([alias, config]) => {
      const target = canonicalThemeInfo[config.target] ?? canonicalThemeInfo.public;
      return [alias, { label: config.label, color: target?.color ?? '#B8E835' }];
    })
  ),
};

// Equirectangular projection. Node coordinates stay on the full 0..200 ×
// 0..100 world grid, while the default visible view crops most Antarctica.
const VIEW_W = 200;
const VIEW_H = 100;
const MAP_VIEW_H = 88;
const lonToX = (lon: number) => ((lon + 180) / 360) * VIEW_W;
const latToY = (lat: number) => ((90 - lat) / 180) * VIEW_H;

function pointInPolygon(lon: number, lat: number, poly: WorldLandRing) {
  let inside = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, yi] = poly[i];
    const [xj, yj] = poly[j];
    const intersect =
      yi > lat !== yj > lat && lon < ((xj - xi) * (lat - yi)) / (yj - yi + 1e-9) + xi;
    if (intersect) inside = !inside;
  }
  return inside;
}

// Build landmass dot grid once at build time. Natural Earth rings stay server
// side; the browser only receives SVG dots.
const COLS = 160;
const ROWS = 80;
const cellW = VIEW_W / COLS;
const cellH = VIEW_H / ROWS;
type LandDot = { cx: number; cy: number };
const landDots: LandDot[] = [];
for (let row = 0; row < ROWS; row++) {
  const lat = 90 - (row + 0.5) * (180 / ROWS);
  for (let col = 0; col < COLS; col++) {
    const lon = -180 + (col + 0.5) * (360 / COLS);
    let inside = false;
    for (const poly of WORLD_LAND_RINGS) {
      if (pointInPolygon(lon, lat, poly)) {
        inside = true;
        break;
      }
    }
    if (inside) {
      landDots.push({
        cx: col * cellW + cellW / 2,
        cy: row * cellH + cellH / 2,
      });
    }
  }
}

type ChapterNode = {
  id: string;
  type: 'chapter';
  name: string;
  city: string;
  region: string;
  bioregion: string;
  bioregionId: string;
  bioregionSource: string;
  themes: string[];
  x: number;
  y: number;
  href: string;
  size: number;
};

const chapters = await getOperationalChapters();

const chapterNodes: ChapterNode[] = chapters
  .filter((c) => typeof c.data.lat === 'number' && typeof c.data.long === 'number')
  .map((c) => {
    const bioregion = derivePublicBioregionMetadataFromCoordinates(c.data.lat, c.data.long);
    const size = 1.38;
    const chapterNodeId = `chapter:${c.id}`;
    return {
      id: chapterNodeId,
      type: 'chapter' as const,
      name: c.data.name,
      city: c.data.city || '',
      region: c.data.region || '',
      bioregion: bioregion?.name || '',
      bioregionId: bioregion?.id || '',
      bioregionSource: bioregion?.source || '',
      themes: [],
      x: lonToX(c.data.long),
      y: latToY(c.data.lat),
      href: `/chapters/${c.id}`,
      size,
    };
  });

// Mycelial threads are loaded from the public map-state endpoint. Chapters
// remain SSR anchors; public stewards and members are progressively enhanced
// from /map/state.
type Edge = {
  fromId: string;
  toId: string;
  fromX: number;
  fromY: number;
  toX: number;
  toY: number;
  theme: string;
  d: string;
  delay: number;
};
const edges: Edge[] = [];

const themeColor = (slug: string) => THEME_INFO[slug]?.color ?? '#B8E835';

const chapterCount = chapterNodes.length;
const nodeTypeFilters = [
  { id: 'chapter', label: 'Chapters' },
  { id: 'steward', label: 'Stewards' },
  { id: 'member', label: 'Members' },
] as const;
// Honest in the sparse state: chapters always render at build time, while
// steward/member nodes appear only when approved public submissions exist.
const statsA11y = `World map of ${chapterCount} Greenpill chapters. Approved steward and member nodes appear as people join the public map.`;
---

<figure class="gp-home-map" aria-labelledby="gp-home-map-title">
  <figcaption id="gp-home-map-title" class="gp-home-map-sr">{statsA11y}</figcaption>

  <div class="gp-home-map-canvas" data-home-map>
    <div class="gp-home-map-topo" aria-hidden="true"></div>

    <svg
      class="gp-home-map-svg"
      viewBox={`0 0 ${VIEW_W} ${MAP_VIEW_H}`}
      preserveAspectRatio="xMidYMid meet"
      role="group"
      aria-label={statsA11y}
    >
      {/* graticule — subtle lat/long grid */}
      <g class="gp-home-map-graticule" aria-hidden="true">
        {[15, 30, 45, 60, 75, 85].map((y) => (
          <line x1="0" x2={VIEW_W} y1={y} y2={y} />
        ))}
        {[30, 60, 90, 120, 150, 180].map((x) => (
          <line x1={x} x2={x} y1="0" y2={MAP_VIEW_H} />
        ))}
      </g>

      {/* world dot landmass */}
      <g class="gp-home-map-world" aria-hidden="true">
        {landDots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r="0.42" />
        ))}
      </g>

      <g class="gp-home-map-bioregion-outline" data-home-map-bioregion-outline aria-hidden="true"></g>

      {/* mycelial threads — theme-tinted relationship edges. pathLength
          normalizes every path so the stroke-dash grow-in lands the same
          duration regardless of arc length. */}
      <g class="gp-home-map-threads" aria-hidden="true">
        {edges.map((edge, idx) => {
          const growDelay = (idx % 12) * 0.12;
          return (
            <path
              class="gp-home-map-thread is-entering"
              data-from={edge.fromId}
              data-to={edge.toId}
              data-theme={edge.theme}
              d={edge.d}
              pathLength="1"
              stroke={themeColor(edge.theme)}
              style={`--thread-color: ${themeColor(edge.theme)}; --thread-grow-delay: ${growDelay}s; animation-delay: ${growDelay}s;`}
            />
          );
        })}
      </g>
      <g class="gp-home-map-threads" data-home-map-dynamic-threads aria-hidden="true"></g>
      {/* Per-shared-theme parallel strands for the selected node only. Built
          client-side by intersecting the two endpoints' public themes — no
          payload change. Kept in its own group so it never affects the base
          thread/edge-hit sets. */}
      <g class="gp-home-map-selection-strands" data-home-map-selection-strands aria-hidden="true"></g>
      <g class="gp-home-map-thread-hits" data-home-map-dynamic-thread-hits aria-hidden="true"></g>

      {/* chapter nodes — lime anchors with stable invisible hit targets */}
      <g class="gp-home-map-chapters">
        {chapterNodes.map((c) => (
          <a
            class="gp-home-map-node-link is-chapter"
            href={c.href}
            data-node-id={c.id}
            data-node-type="chapter"
            data-node-name={c.name}
            data-node-role="Chapter"
            data-node-place={c.city || c.region}
            data-node-bioregion={c.bioregion}
            data-node-bioregion-id={c.bioregionId}
            data-node-bioregion-source={c.bioregionSource}
            data-node-themes={c.themes.join(' ')}
          >
            <title>{`${c.name}${c.city ? ` · ${c.city}` : ''}`}</title>
            <circle class="gp-home-map-node-hit" cx={c.x} cy={c.y} r="4.8" />
            <circle class="gp-home-map-node-halo" cx={c.x} cy={c.y} r={c.size + 1.45} data-base-r={c.size + 1.45} />
            <circle class="gp-home-map-node-ring" cx={c.x} cy={c.y} r={c.size + 0.45} data-base-r={c.size + 0.45} />
            <circle class="gp-home-map-node-dot" cx={c.x} cy={c.y} r={c.size} data-base-r={c.size} />
          </a>
        ))}
      </g>

      {/* public people nodes — approved submitted stewards/members and
          local-pending nodes injected client-side from /map/state. Empty at
          build time so the map renders and degrades gracefully when the agent
          is unavailable. */}
      <g class="gp-home-map-members" data-home-map-members></g>

      {/* Exact-overlap fan-out affordances for co-located people pins.
          Rendered client-side above the people layer; empty at build time. */}
      <g class="gp-home-map-clusters" data-home-map-clusters></g>
    </svg>

    {/* Counts reflect the current theme-filtered dataset and stay stable while
        the type toggles isolate chapters, stewards, or members. Chapters render
        from the public snapshot; steward/member counts update from /map/state
        as approved public submissions arrive. */}
    <div class="gp-home-map-legend" aria-label="Filter visible map node type">
      {nodeTypeFilters.map((type) => (
        <button
          type="button"
          class={`gp-home-map-legend-item is-${type.id}`}
          data-legend-type={type.id}
          data-legend-filter={type.id}
          aria-pressed="false"
        >
          <span class={`gp-home-map-legend-mark is-${type.id}`} aria-hidden="true"></span>
          <span class="gp-home-map-legend-label">{type.label}</span>
          <span class="gp-home-map-legend-count" data-home-map-type-count={type.id}>
            {type.id === 'chapter' ? chapterCount : 0}
          </span>
        </button>
      ))}
    </div>

    <div class="gp-home-map-freshness" data-home-map-freshness data-state="live" role="status" aria-live="polite" hidden>
      <span class="gp-home-map-freshness-dot" aria-hidden="true"></span>
      <span data-home-map-freshness-label>Live</span>
    </div>

    {/* Focus card — populated by inline script on hover/focus */}
    <div class="gp-home-map-focus" data-home-map-focus role="status" aria-live="polite" aria-hidden="true">
      <span class="gp-home-map-focus-role" data-focus-role></span>
      <span class="gp-home-map-focus-name" data-focus-name></span>
      <span class="gp-home-map-focus-meta" data-focus-meta></span>
      <span class="gp-home-map-focus-themes" data-focus-themes></span>
    </div>

    <div class="gp-home-map-edge-tooltip" data-home-map-edge-tooltip aria-hidden="true">
      <span class="gp-home-map-edge-tooltip-kicker" data-edge-tooltip-kicker></span>
      <span class="gp-home-map-edge-tooltip-title" data-edge-tooltip-title></span>
      <span class="gp-home-map-edge-tooltip-meta" data-edge-tooltip-meta></span>
    </div>

    {/* Selected-node inspector. Desktop floats near the active node without
        resizing the map; mobile anchors as a compact bar over the lower canvas. */}
    <div class="gp-home-map-selected" data-home-map-selected hidden role="region" aria-label="Selected map node">
      <button type="button" class="gp-home-map-selected-close" data-selected-close aria-label="Close selected node">
        <span aria-hidden="true">×</span>
      </button>
      <p class="gp-home-map-selected-kicker" data-selected-kicker>Network node</p>
      <p class="gp-home-map-selected-name" data-selected-name></p>
      <p class="gp-home-map-selected-place" data-selected-place></p>
      <p class="gp-home-map-selected-bioregion" data-selected-bioregion></p>
      <div class="gp-home-map-selected-links" data-selected-links hidden></div>
      <div class="gp-home-map-selected-themes" data-selected-themes></div>
      <p class="gp-home-map-selected-note" data-selected-note></p>
      <div class="gp-home-map-selected-edge-list" data-selected-edge-list hidden>
        <p class="gp-home-map-selected-edge-title">Connections</p>
        <div class="gp-home-map-selected-edge-items" data-selected-edge-items></div>
      </div>

      <div class="gp-home-map-update" data-home-map-update hidden>
        <button type="button" class="gp-home-map-update-trigger" data-update-trigger>Edit this node</button>

        <form class="gp-home-map-update-form" data-update-form hidden novalidate>
          <label class="gp-home-map-update-field" for="gp-home-map-update-email">
            <span>Owner email</span>
          </label>
          <input id="gp-home-map-update-email" type="email" name="email" inputmode="email" autocomplete="email" required placeholder="you@example.org" />
          <div class="gp-home-map-update-actions">
            <button type="button" class="gp-home-map-update-cancel" data-update-cancel>Cancel</button>
            <button type="submit" class="gp-home-map-update-submit">Send edit link</button>
          </div>
          <p class="gp-home-map-update-error" data-update-error role="alert"></p>
        </form>

        <p class="gp-home-map-update-success" data-update-success role="status" hidden>
          If this email matches the node owner, we'll send an edit link.
        </p>
      </div>
      <p class="gp-home-map-selected-live gp-home-map-sr" data-selected-live aria-live="polite"></p>
    </div>

    <div class="gp-home-map-controls" data-home-map-controls aria-label="Map controls">
      <div class="gp-home-map-filter-panel is-themes" data-filter-panel="theme" hidden>
        {mapThemes.map((theme) => (
          <button
            type="button"
            class="gp-home-map-filter-option is-theme"
            data-theme-filter={theme.id}
            aria-pressed="true"
            style={`--theme-color: ${theme.color};`}
          >
            <span class="gp-home-map-filter-marker" aria-hidden="true"></span>
            <span>{theme.label}</span>
          </button>
        ))}
      </div>

      <div class="gp-home-map-control-row">
        <div class="gp-home-map-filter-tabs">
          <button type="button" data-filter-toggle="theme" aria-expanded="false">Themes</button>
          <button type="button" data-home-map-list-toggle aria-expanded="false" aria-controls="gp-home-map-node-list">List</button>
        </div>
        <div class="gp-home-map-zoom-controls" data-home-map-zoom-controls aria-label="Map zoom controls">
          <button type="button" data-home-map-zoom="out" aria-label="Zoom out">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line x1="5" y1="12" x2="19" y2="12" /></svg>
          </button>
          <button type="button" data-home-map-zoom="reset" aria-label="Reset to full map">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 9V5a1 1 0 0 1 1-1h4" />
              <path d="M20 9V5a1 1 0 0 0-1-1h-4" />
              <path d="M4 15v4a1 1 0 0 0 1 1h4" />
              <path d="M20 15v4a1 1 0 0 1-1 1h-4" />
            </svg>
          </button>
          <button type="button" data-home-map-zoom="in" aria-label="Zoom in">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
          </button>
        </div>
      </div>
    </div>

    <dialog
      class="gp-home-map-list-drawer"
      id="gp-home-map-node-list"
      data-home-map-list
      aria-labelledby="gp-home-map-list-title"
      hidden
    >
      <header class="gp-home-map-list-head">
        <div>
          <p class="gp-home-map-list-kicker">Visible nodes</p>
          <h3 id="gp-home-map-list-title">Map list</h3>
        </div>
        <div class="gp-home-map-list-actions">
          <span data-home-map-list-count>0</span>
          <button type="button" data-home-map-list-close aria-label="Close map list">×</button>
        </div>
      </header>
      <div class="gp-home-map-list-items" data-home-map-list-items></div>
    </dialog>
  </div>

  {/* Theme labels/colors for client-rendered member chips, so the script does
      not need to import the shared map-state module into the browser bundle. */}
  <script type="application/json" data-home-map-theme-info set:html={JSON.stringify(THEME_INFO)}></script>

  {/* Find-your-people walkthrough. The visible trigger lives in the homepage
      hero CTA; local pending state is still written only after server accept. */}
  <dialog class="gp-home-map-addnode-dialog" data-home-map-addnode-dialog aria-labelledby="gp-home-map-addnode-dialog-title">
    <div class="gp-home-map-addnode-topo" aria-hidden="true"></div>
    <button type="button" class="gp-home-map-addnode-back" data-walkthrough-back hidden aria-label="Go back">
      <span aria-hidden="true">←</span>
    </button>
    <button type="button" class="gp-home-map-addnode-close" data-addnode-close aria-label="Close find-your-people dialog">
      <span aria-hidden="true">×</span>
    </button>

    <form id="gp-home-map-addnode-form" class="gp-home-map-addnode-form" data-home-map-addnode-form novalidate>
      <h2 id="gp-home-map-addnode-dialog-title" class="gp-home-map-sr" data-addnode-dialog-title>What are you here to grow?</h2>
      <section class="gp-home-map-addnode-step is-active" data-walkthrough-step="themes">
        <h2 id="gp-home-map-addnode-title">What are you here to grow?</h2>
        <p class="gp-home-map-addnode-copy">Choose 1 to 4 themes to continue. These choose the color of your threads on the map and find your people.</p>

        <div class="gp-home-map-addnode-theme-options" data-home-map-themes>
          {mapThemes.map((theme) => (
            <button
              type="button"
              class="gp-home-map-addnode-theme"
              data-theme-choice={theme.id}
              aria-pressed="false"
              style={`--theme-color: ${theme.color};`}
            >
              <span class="gp-home-map-addnode-theme-dot" aria-hidden="true"></span>
              <span>{theme.label}</span>
            </button>
          ))}
        </div>

        <p class="gp-home-map-addnode-theme-count" id="gp-home-map-addnode-theme-count" data-home-map-theme-count aria-live="polite">Choose 1 to 4 themes to continue.</p>
      </section>

      <section class="gp-home-map-addnode-step" data-walkthrough-step="identity" hidden>
        <h2>Drop your pin.</h2>
        <p class="gp-home-map-addnode-copy">Name yourself, place yourself, and add the private email stewards can use only for future edit links.</p>

        <div class="gp-home-map-addnode-grid">
          <label>
            <span>Display name</span>
            <input name="name" autocomplete="name" required placeholder="What should the network call you?" />
          </label>
          <label>
            <span>Private email</span>
            <input name="contact" autocomplete="email" type="email" required placeholder="you@example.org" />
          </label>
        </div>

        <label class="gp-home-map-addnode-note">
          <span class="gp-home-map-addnode-label-row">
            <span>Tagline</span>
            <span class="gp-home-map-addnode-theme-count" data-tagline-count aria-live="polite">0 / 72</span>
          </span>
          <input name="publicNote" required maxlength="72" placeholder="e.g. compost evangelist turning rooftops into food forests" />
        </label>

        <div class="gp-home-map-addnode-location">
          <label class="gp-home-map-addnode-city" data-location-text>
            <span>City or place name</span>
            <input type="text" name="placeQuery" autocomplete="address-level2" list="gp-home-map-cities" placeholder="Start typing, or name where your pin is…" />
            <datalist id="gp-home-map-cities" data-location-datalist></datalist>
          </label>

          <div class="gp-home-map-addnode-map-field">
            <span>Or place yourself on the map</span>
            <div class="gp-home-map-addnode-mini-map" data-location-map>
              <div class="gp-home-map-addnode-mini-topo" aria-hidden="true"></div>
              <svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="xMidYMid meet" aria-label="Tap or drag to place your pin on the world map">
                <g aria-hidden="true">
                  {landDots.map((d) => (
                    <circle cx={d.cx} cy={d.cy} r="0.42" />
                  ))}
                </g>
                <circle data-location-pin cx="100" cy="50" r="2.8" hidden />
              </svg>
              <span data-location-map-hint>· tap or drag to place ·</span>
            </div>
          </div>

          <input type="hidden" name="place" data-location-place />
          <input type="hidden" name="lat" data-location-lat />
          <input type="hidden" name="long" data-location-long />

          <p class="gp-home-map-addnode-location-status" data-location-status>Type a city or drop a pin on the map.</p>
        </div>
      </section>

      <section class="gp-home-map-addnode-step" data-walkthrough-step="review" hidden>
        <h2>Look right before you take root.</h2>
        <p class="gp-home-map-addnode-copy" data-home-map-mode-copy>In moderated mode, your node appears on your device while stewards review it. Your email stays private and is used only for future edit links.</p>

        <div class="gp-home-map-addnode-preview">
          <span class="gp-home-map-addnode-preview-dot" aria-hidden="true"></span>
          <div>
            <strong data-review-name>You</strong>
            <span data-review-place>Member · —</span>
          </div>
        </div>

        <div class="gp-home-map-addnode-review">
          <div>
            <span>Themes</span>
            <div data-review-themes></div>
            <button type="button" data-edit-step="themes">Edit themes</button>
          </div>
          <div>
            <span>Tagline</span>
            <p data-review-note>None yet</p>
            <button type="button" data-edit-step="identity">Edit tagline</button>
          </div>
          <div>
            <span>Private email</span>
            <p data-review-email>Saved privately for future edit links.</p>
            <button type="button" data-edit-step="identity">Edit email</button>
          </div>
        </div>

        <p class="gp-home-map-addnode-status" data-home-map-addnode-status role="status"></p>
      </section>
    </form>

    <div class="gp-home-map-addnode-footer">
      {/* Standalone recovery: a returning owner who cannot find/select their pin
          (cache cleared, new device) requests a manage link by email alone. The
          confirmation is the same whether or not the email matches. */}
      <div class="gp-home-map-addnode-manage" data-home-map-manage>
        <p class="gp-home-map-addnode-manage-lead">Already added yourself?</p>
        <button
          type="button"
          class="gp-home-map-addnode-manage-toggle"
          data-manage-toggle
          aria-expanded="false"
          aria-controls="gp-home-map-manage-form"
        >Email me a manage link</button>
        <form class="gp-home-map-addnode-manage-form" id="gp-home-map-manage-form" data-manage-form hidden novalidate>
          <label class="gp-home-map-addnode-manage-field" for="gp-home-map-manage-email">
            <span>Your private email</span>
            <input id="gp-home-map-manage-email" type="email" name="email" inputmode="email" autocomplete="email" required placeholder="you@example.org" />
          </label>
          <button type="submit" class="gp-home-map-addnode-manage-submit">Send manage link</button>
          <p class="gp-home-map-addnode-manage-status" data-manage-status role="status" aria-live="polite" hidden>
            If that email matches a published node, we've emailed a manage link.
          </p>
        </form>
      </div>

      <div class="gp-home-map-addnode-actions">
        <button type="button" class="gp-home-map-addnode-next" data-walkthrough-next aria-describedby="gp-home-map-addnode-theme-count" disabled>Continue →</button>
        <button type="submit" form="gp-home-map-addnode-form" class="gp-home-map-addnode-submit" data-walkthrough-submit hidden>Plant me on the map →</button>
      </div>
    </div>
  </dialog>
</figure>

<script>
  import {
    PENDING_NODE_UPDATED_EVENT,
    localPendingNodeSignature,
    loadLocalPendingNodes,
    normalizePublicMapThemeSlug,
    normalizePublicMapThemeSlugs,
    reconcileLocalPendingNodes,
    saveLocalPendingNode,
  } from '@greenpill-network/shared/map-node-storage';
  import type { PublicEcoregionDataset, PublicEcoregionRegion } from '@greenpill-network/shared/public-ecoregions';

  type DynamicMapNodeType = 'chapter' | 'steward' | 'member';

  type DynamicMapNode = {
    key: string;
    sourceId: string;
    type: DynamicMapNodeType;
    name: string;
    place: string;
    chapterSlug: string;
    bioregion: string;
    bioregionId: string;
    bioregionSource: string;
    publicNote: string;
    profileUrl: string;
    themes: string[];
    lat: number;
    long: number;
    approved: boolean;
    pending: boolean;
    owned: boolean;
  };

  type MapViewBox = {
    x: number;
    y: number;
    width: number;
    height: number;
  };

  type EdgeEndpoint = {
    id: string;
    name: string;
    type: 'chapter' | 'steward' | 'member';
  };

  type EdgeMeta = {
    edgeId: string;
    from: EdgeEndpoint;
    to: EdgeEndpoint;
    kind: string;
    theme: string;
    themeLabel: string;
    themeColor: string;
    source: string;
    weight: number;
    bioregion: string;
    bioregionId: string;
    bioregionSource: string;
  };

  (() => {
    const root = document.querySelector('[data-home-map]') as HTMLElement | null;
    if (!root) return;
    // root is the canvas (its .is-focused class drives the SVG focus styles).
    // The controls, selected card/bar, update form, and add-node form live in the
    // surrounding <figure>, so query those from the figure scope, not root.
    const scope: ParentNode = root.closest('.gp-home-map') ?? document;
    // Astro scopes component <style> via a generated attribute. Elements created
    // in JS must carry the same attribute, or the scoped node/chip styles (fill,
    // halo, ring, theme chips) will not apply and nodes render unstyled.
    const astroCidAttr = root.getAttributeNames().find((n) => n.startsWith('data-astro-cid-')) ?? '';
    const applyScope = (el: Element) => { if (astroCidAttr) el.setAttribute(astroCidAttr, ''); };

    // Equirectangular projection — must match the build-time SSR projection
    // (viewBox 0..200 x 0..100) so injected nodes land on the same grid.
    const VIEW_W = 200;
    const VIEW_H = 100;
    const VISIBLE_VIEW_H = 88;
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const NODE_HIT_RADIUS = 4.8;
    const lonToX = (lon: number) => ((lon + 180) / 360) * VIEW_W;
    const latToY = (lat: number) => ((90 - lat) / 180) * VIEW_H;

    const isLocalHost = ['localhost', '127.0.0.1', '0.0.0.0', '::1'].includes(window.location.hostname);
    const agentBaseUrl = isLocalHost ? 'http://localhost:3303' : 'https://agent.greenpill.network';

    const membersGroup = root.querySelector('[data-home-map-members]') as SVGGElement | null;
    const dynamicThreadsGroup = root.querySelector('[data-home-map-dynamic-threads]') as SVGGElement | null;
    const dynamicThreadHitsGroup = root.querySelector('[data-home-map-dynamic-thread-hits]') as SVGGElement | null;
    const selectionStrandsGroup = root.querySelector('[data-home-map-selection-strands]') as SVGGElement | null;
    const bioregionOutlineGroup = root.querySelector('[data-home-map-bioregion-outline]') as SVGGElement | null;
    const svgEl = root.querySelector('.gp-home-map-svg') as SVGSVGElement | null;
    const focusEl = root.querySelector('[data-home-map-focus]') as HTMLElement | null;
    const focusRole = root.querySelector('[data-focus-role]') as HTMLElement | null;
    const focusName = root.querySelector('[data-focus-name]') as HTMLElement | null;
    const focusMeta = root.querySelector('[data-focus-meta]') as HTMLElement | null;
    const focusThemes = root.querySelector('[data-focus-themes]') as HTMLElement | null;
    const edgeTooltip = root.querySelector('[data-home-map-edge-tooltip]') as HTMLElement | null;
    const edgeTooltipKicker = root.querySelector('[data-edge-tooltip-kicker]') as HTMLElement | null;
    const edgeTooltipTitle = root.querySelector('[data-edge-tooltip-title]') as HTMLElement | null;
    const edgeTooltipMeta = root.querySelector('[data-edge-tooltip-meta]') as HTMLElement | null;
    const zoomButtons = Array.from(scope.querySelectorAll('[data-home-map-zoom]')) as HTMLButtonElement[];
    const freshnessEl = root.querySelector('[data-home-map-freshness]') as HTMLElement | null;
    const freshnessLabel = root.querySelector('[data-home-map-freshness-label]') as HTMLElement | null;
    const listDrawer = root.querySelector('[data-home-map-list]') as HTMLDialogElement | null;
    const listToggle = root.querySelector('[data-home-map-list-toggle]') as HTMLButtonElement | null;
    const listClose = root.querySelector('[data-home-map-list-close]') as HTMLButtonElement | null;
    const listItems = root.querySelector('[data-home-map-list-items]') as HTMLElement | null;
    const listCount = root.querySelector('[data-home-map-list-count]') as HTMLElement | null;
    let ecoregionDatasetPromise: Promise<PublicEcoregionDataset> | null = null;
    let ecoregionsById: Map<string, PublicEcoregionRegion> | null = null;
    let bioregionOutlineRequest = 0;

    // Theme labels/colors for member chips, serialized from SSR.
    const themeInfo: Record<string, { label: string; color: string }> = (() => {
      const node = document.querySelector('[data-home-map-theme-info]');
      try {
        return node?.textContent ? JSON.parse(node.textContent) : {};
      } catch {
        return {};
      }
    })();
    const themeLabel = (slug: string) => themeInfo[slug]?.label ?? slug.replace(/-/g, ' ');
    const themeCompactLabel = (slug: string) => ({
      water: 'Water',
      waste: 'Waste',
      opensrc: 'Open Src',
      impact: 'Impact',
      trees: 'Biodiv',
      food: 'Food',
      energy: 'Energy',
      education: 'Edu',
      events: 'Events',
      funding: 'Funding',
      mutual: 'Mutual',
      stories: 'Stories',
      ai: 'AI',
      desci: 'DeSci',
      gov: 'Gov',
      public: 'Public',
      currency: 'Mutual',
      'public-goods': 'Public',
      'local-regeneration': 'Regen',
      'knowledge-commons': 'Edu',
      'coordination-tools': 'Open Src',
      opensource: 'Open Src',
      'open-source': 'Open Src',
    } as Record<string, string>)[slug] ?? themeLabel(slug);
    const themeColor = (slug: string) => themeInfo[slug]?.color ?? '#B8E835';
    const normalizeThemeSlug = (slug: unknown) => normalizePublicMapThemeSlug(slug);
    const normalizeThemeSlugs = (themes: unknown) => normalizePublicMapThemeSlugs(themes);
    const clean = (value: unknown) => (typeof value === 'string' ? value.trim() : '');
    const finiteNumber = (value: unknown) => {
      const num = typeof value === 'number' ? value : Number(value);
      return Number.isFinite(num) ? num : null;
    };
    const publicBioregion = (value: unknown) => clean(value);
    const publicBioregionId = (value: unknown) => clean(value);
    const publicBioregionSource = (value: unknown) => clean(value);
    // Public profile/social/chapter links only; reject javascript:/data: and other
    // unsafe schemes so a link can only ever be http(s) or a same-site path.
    const cleanHref = (value: unknown) => {
      const href = clean(value);
      return /^https?:\/\//i.test(href) || href.startsWith('/') ? href : '';
    };
    const chapterHref = (slug: unknown) => {
      const cleaned = clean(slug).replace(/^\/+|\/+$/g, '');
      return cleaned ? `/chapters/${cleaned}` : '';
    };
    const OWNED_NODE_STORAGE_KEY = 'greenpill.ownedMapNodes.v1';
    const loadOwnedNodeKeys = () => {
      try {
        const raw = window.localStorage.getItem(OWNED_NODE_STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return new Set(Array.isArray(parsed) ? parsed.map(clean).filter(Boolean) : []);
      } catch {
        return new Set<string>();
      }
    };
    const saveOwnedNodeKeys = (keys: Iterable<string>) => {
      try {
        window.localStorage.setItem(OWNED_NODE_STORAGE_KEY, JSON.stringify([...new Set([...keys].filter(Boolean))]));
      } catch {
        // Private browsing or storage quota failures should not block the map.
      }
    };
    const ownedNodeSignature = (node: Record<string, any>) => localPendingNodeSignature({
      name: node.name ?? node.displayName,
      lat: node.lat ?? node.latitude,
      long: node.long ?? node.longitude,
    });
    const ownedNodeKeysFor = (node: Record<string, any>, key = '') => [
      clean(key),
      clean(node.sourceId || node.id),
      clean(node.id),
      ownedNodeSignature(node),
    ].filter(Boolean);
    const rememberOwnedNode = (node: Record<string, any>, key = '') => {
      const next = loadOwnedNodeKeys();
      ownedNodeKeysFor(node, key).forEach((item) => next.add(item));
      saveOwnedNodeKeys(next);
    };
    const isOwnedNode = (node: Record<string, any>, key = '') => {
      const owned = loadOwnedNodeKeys();
      return ownedNodeKeysFor(node, key).some((item) => owned.has(item));
    };

    const loadEcoregions = async () => {
      if (!ecoregionDatasetPromise) {
        ecoregionDatasetPromise = import('@greenpill-network/shared/public-ecoregions')
          .then((module) => module.PUBLIC_ECOREGIONS);
      }
      const dataset = await ecoregionDatasetPromise;
      if (!ecoregionsById) {
        ecoregionsById = new Map(dataset.regions.map((region) => [region.id, region]));
      }
      return dataset;
    };

    const clearBioregionOutline = () => {
      bioregionOutlineRequest += 1;
      bioregionOutlineGroup?.replaceChildren();
      root.classList.remove('has-bioregion-outline');
    };

    const pointInRing = (
      lon: number,
      lat: number,
      ring: PublicEcoregionRegion['polygons'][number][number]
    ) => {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const [xi, yi] = ring[i];
        const [xj, yj] = ring[j];
        const intersects = yi > lat !== yj > lat && lon < ((xj - xi) * (lat - yi)) / (yj - yi + 1e-9) + xi;
        if (intersects) inside = !inside;
      }
      return inside;
    };

    const pointInPolygon = (
      lon: number,
      lat: number,
      polygon: PublicEcoregionRegion['polygons'][number]
    ) => {
      const [outer, ...holes] = polygon;
      if (!outer || !pointInRing(lon, lat, outer)) return false;
      return !holes.some((hole) => pointInRing(lon, lat, hole));
    };

    const bboxContains = (bbox: PublicEcoregionRegion['bbox'], lon: number, lat: number, tolerance = 0) => (
      lon >= bbox[0] - tolerance &&
      lon <= bbox[2] + tolerance &&
      lat >= bbox[1] - tolerance &&
      lat <= bbox[3] + tolerance
    );

    const distanceToSegmentSq = (point: [number, number], start: [number, number], end: [number, number]) => {
      const dx = end[0] - start[0];
      const dy = end[1] - start[1];
      if (dx === 0 && dy === 0) return (point[0] - start[0]) ** 2 + (point[1] - start[1]) ** 2;
      const t = Math.max(0, Math.min(1, ((point[0] - start[0]) * dx + (point[1] - start[1]) * dy) / (dx * dx + dy * dy)));
      const x = start[0] + t * dx;
      const y = start[1] + t * dy;
      return (point[0] - x) ** 2 + (point[1] - y) ** 2;
    };

    const distanceToOuterRingsSq = (lon: number, lat: number, region: PublicEcoregionRegion) => {
      let nearest = Number.POSITIVE_INFINITY;
      region.polygons.forEach((polygon) => {
        const outer = polygon[0];
        if (!outer) return;
        for (let i = 0; i < outer.length - 1; i += 1) {
          nearest = Math.min(nearest, distanceToSegmentSq([lon, lat], outer[i], outer[i + 1]));
        }
      });
      return nearest;
    };

    const lookupEcoregionFromCoordinates = (
      dataset: PublicEcoregionDataset,
      lat: unknown,
      long: unknown
    ) => {
      const latitude = finiteNumber(lat);
      const longitude = finiteNumber(long);
      if (latitude === null || longitude === null) return null;
      const tolerance = 0.45;
      let nearest: { region: PublicEcoregionRegion; distanceSq: number } | null = null;

      for (const region of dataset.regions) {
        if (!bboxContains(region.bbox, longitude, latitude, tolerance)) continue;
        if (region.polygons.some((polygon) => pointInPolygon(longitude, latitude, polygon))) return region;
        const distanceSq = distanceToOuterRingsSq(longitude, latitude, region);
        if (!nearest || distanceSq < nearest.distanceSq) nearest = { region, distanceSq };
      }

      return nearest && nearest.distanceSq <= tolerance * tolerance ? nearest.region : null;
    };

    const drawBioregionOutline = (
      region: PublicEcoregionRegion,
      member: Pick<DynamicMapNode, 'bioregion' | 'bioregionSource'>
    ) => {
      if (!bioregionOutlineGroup) return;
      bioregionOutlineGroup.replaceChildren();
      root.classList.add('has-bioregion-outline');
      bioregionOutlineGroup.style.setProperty('--bioregion-color', region.color || 'var(--gp-primary)');
      bioregionOutlineGroup.dataset.bioregionId = region.id;
      bioregionOutlineGroup.dataset.bioregionSource = member.bioregionSource || region.source;

      region.polygons.forEach((polygon) => {
        const path = document.createElementNS(SVG_NS, 'path');
        applyScope(path);
        path.setAttribute('class', 'gp-home-map-bioregion-path');
        path.setAttribute(
          'd',
          polygon.map((ring) => (
            ring.map(([lon, lat], index) => (
              `${index === 0 ? 'M' : 'L'} ${lonToX(lon).toFixed(2)} ${latToY(lat).toFixed(2)}`
            )).join(' ') + ' Z'
          )).join(' ')
        );
        const title = document.createElementNS(SVG_NS, 'title');
        title.textContent = member.bioregion || region.name;
        path.append(title);
        bioregionOutlineGroup.append(path);
      });
    };

    const renderBioregionOutline = (member: DynamicMapNode) => {
      if (!bioregionOutlineGroup) return;
      const request = ++bioregionOutlineRequest;
      bioregionOutlineGroup.replaceChildren();
      root.classList.remove('has-bioregion-outline');

      void loadEcoregions().then((dataset) => {
        if (request !== bioregionOutlineRequest) return;
        const byId = ecoregionsById ?? new Map(dataset.regions.map((region) => [region.id, region]));
        const region = member.bioregionId
          ? byId.get(member.bioregionId)
          : lookupEcoregionFromCoordinates(dataset, member.lat, member.long);
        if (!region) return;
        drawBioregionOutline(region, member);
      }).catch(() => {
        if (request === bioregionOutlineRequest) root.classList.remove('has-bioregion-outline');
      });
    };

    const themeFilterButtons = Array.from(scope.querySelectorAll('[data-theme-filter]')) as HTMLButtonElement[];
    const filterToggleButtons = Array.from(scope.querySelectorAll('[data-filter-toggle]')) as HTMLButtonElement[];
    const filterPanels = Array.from(scope.querySelectorAll('[data-filter-panel]')) as HTMLElement[];
    const legendItems = Array.from(scope.querySelectorAll('[data-legend-type]')) as HTMLButtonElement[];
    const legendCountByType = new Map(
      Array.from(scope.querySelectorAll('[data-home-map-type-count]')).map((el) => [
        clean((el as HTMLElement).dataset.homeMapTypeCount),
        el as HTMLElement,
      ])
    );
    const activeThemes = new Set(themeFilterButtons.map((button) => clean(button.dataset.themeFilter)).filter(Boolean));
    const allThemeCount = activeThemes.size;
    let activeTypeFilter: '' | 'chapter' | 'steward' | 'member' = '';
    let openFilterPanel = '';
    let applyMapFilters = () => {};
    let syncSelectedOverlay = () => {};
    let renderNodeList = () => {};
    let closeNodeList = (_options: { restoreFocus?: boolean } = {}) => {};

    const filterTypeFor = (value: unknown): 'chapter' | 'steward' | 'member' => {
      const type = clean(value).toLowerCase();
      if (type === 'chapter') return 'chapter';
      if (type === 'steward') return 'steward';
      return 'member';
    };

    const nodeThemes = (node: Element): string[] => (
      normalizeThemeSlugs(
        clean((node as HTMLElement).dataset.nodeThemes || node.getAttribute('data-node-themes'))
          .split(/\s+/)
      )
    );

    const themeIsActive = (theme: string) => (
      !allThemeCount || activeThemes.size === allThemeCount || activeThemes.has(theme)
    );

    const toFiniteNumber = (value: unknown) => {
      const num = typeof value === 'number' ? value : Number(value);
      return Number.isFinite(num) ? num : null;
    };

    const baseRadius = (circle: SVGCircleElement | null) => {
      const num = Number(circle?.getAttribute('data-base-r') || circle?.getAttribute('r'));
      return Number.isFinite(num) ? num : 0;
    };

    const scaleNodeCircle = (circle: SVGCircleElement | null, scale: number) => {
      const base = baseRadius(circle);
      if (!base) return;
      circle.setAttribute('r', Math.max(0.12, base * scale).toFixed(2));
    };

    const densityScaleFor = (nearestDistance: number, totalVisible: number) => {
      const totalScale = totalVisible >= 40 ? 0.72 : totalVisible >= 24 ? 0.82 : totalVisible >= 14 ? 0.9 : 1;
      const neighborScale = nearestDistance < 2.4
        ? 0.58
        : nearestDistance < 4.2
          ? 0.68
          : nearestDistance < 6.2
            ? 0.78
            : nearestDistance < 8.5
              ? 0.9
              : 1;
      return Math.min(totalScale, neighborScale);
    };

    const applyNodeDensityScale = () => {
      const nodes = Array.from(root.querySelectorAll('.gp-home-map-node-link:not(.is-filtered-out)'))
        .map((node) => {
          const dot = node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
          const x = toFiniteNumber(dot?.getAttribute('cx'));
          const y = toFiniteNumber(dot?.getAttribute('cy'));
          const type = filterTypeFor(node.getAttribute('data-node-type'));
          return x === null || y === null ? null : { node, type, x, y };
        })
        .filter(Boolean) as Array<{ node: Element; type: 'chapter' | 'steward' | 'member'; x: number; y: number }>;
      const peopleNodes = nodes.filter((entry) => entry.type !== 'chapter');

      nodes.forEach((entry) => {
        if (entry.type === 'chapter') {
          scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null, 1);
          scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-ring') as SVGCircleElement | null, 1);
          scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-halo') as SVGCircleElement | null, 1);
          return;
        }
        const nearest = peopleNodes.reduce((min, other) => {
          if (other.node === entry.node) return min;
          return Math.min(min, Math.hypot(entry.x - other.x, entry.y - other.y));
        }, Number.POSITIVE_INFINITY);
        const scale = densityScaleFor(nearest, peopleNodes.length);
        scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null, scale);
        scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-ring') as SVGCircleElement | null, scale);
        scaleNodeCircle(entry.node.querySelector('.gp-home-map-node-halo') as SVGCircleElement | null, scale);
      });
    };

    const seedForEdge = (value: string) => Array.from(value).reduce((acc, char) => (
      ((acc * 31) + char.charCodeAt(0)) % 100000
    ), 17);

    const edgeRand = (seed: number) => {
      let state = seed || 1;
      return () => {
        state = (state * 9301 + 49297) % 233280;
        return state / 233280;
      };
    };

    const buildMycelialPath = (
      a: { x: number; y: number },
      b: { x: number; y: number },
      seed: number
    ) => {
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 0.1) return `M ${a.x.toFixed(2)} ${a.y.toFixed(2)}`;
      const rand = edgeRand(seed);
      const nx = -dy / dist;
      const ny = dx / dist;
      const segments = Math.max(4, Math.min(12, Math.round(dist / 9)));
      const points: Array<[number, number]> = [];
      for (let i = 0; i <= segments; i += 1) {
        const t = i / segments;
        const taper = Math.sin(t * Math.PI);
        const wobble = (rand() - 0.5) * Math.min(8, dist * 0.16) * taper;
        points.push([
          a.x + dx * t + nx * wobble,
          a.y + dy * t + ny * wobble,
        ]);
      }

      let d = `M ${points[0][0].toFixed(2)} ${points[0][1].toFixed(2)}`;
      for (let i = 0; i < points.length - 1; i += 1) {
        const p0 = points[Math.max(0, i - 1)];
        const p1 = points[i];
        const p2 = points[i + 1];
        const p3 = points[Math.min(points.length - 1, i + 2)];
        const k = 0.2;
        const c1x = p1[0] + (p2[0] - p0[0]) * k;
        const c1y = p1[1] + (p2[1] - p0[1]) * k;
        const c2x = p2[0] - (p3[0] - p1[0]) * k;
        const c2y = p2[1] - (p3[1] - p1[1]) * k;
        d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)} ${c2x.toFixed(2)} ${c2y.toFixed(2)} ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
      }
      return d;
    };

    const FULL_VIEW_BOX: MapViewBox = { x: 0, y: 0, width: VIEW_W, height: VISIBLE_VIEW_H };
    const MIN_VIEW_BOX_WIDTH = 46;
    const viewBoxAspect = FULL_VIEW_BOX.width / FULL_VIEW_BOX.height;
    let currentViewBox: MapViewBox = { ...FULL_VIEW_BOX };
    // Cluster recompute hook — assigned once the clustering module initializes.
    // Declared here (before setMapViewBox) so the viewBox setter can poke it
    // without a temporal-dead-zone error during the initial render.
    let clusterDirty: () => void = () => {};

    const formatViewBox = (box: MapViewBox) => (
      `${box.x.toFixed(2)} ${box.y.toFixed(2)} ${box.width.toFixed(2)} ${box.height.toFixed(2)}`
    );

    const clampViewBox = (box: MapViewBox): MapViewBox => {
      const width = Math.min(FULL_VIEW_BOX.width, Math.max(MIN_VIEW_BOX_WIDTH, box.width));
      const height = Math.min(FULL_VIEW_BOX.height, width / viewBoxAspect);
      const maxX = FULL_VIEW_BOX.x + FULL_VIEW_BOX.width - width;
      const maxY = FULL_VIEW_BOX.y + FULL_VIEW_BOX.height - height;
      return {
        x: Math.min(Math.max(FULL_VIEW_BOX.x, box.x), maxX),
        y: Math.min(Math.max(FULL_VIEW_BOX.y, box.y), maxY),
        width,
        height,
      };
    };

    const setMapViewBox = (box: MapViewBox) => {
      currentViewBox = clampViewBox(box);
      svgEl?.setAttribute('viewBox', formatViewBox(currentViewBox));
      root.classList.toggle('is-zoomed', currentViewBox.width < FULL_VIEW_BOX.width - 0.5);
      syncSelectedOverlay();
      clusterDirty();
    };

    const setMapViewBoxCentered = (cx: number, cy: number, width: number) => {
      const height = width / viewBoxAspect;
      setMapViewBox({
        x: cx - width / 2,
        y: cy - height / 2,
        width,
        height,
      });
    };

    const resetMapView = () => setMapViewBox(FULL_VIEW_BOX);

    const zoomMapBy = (factor: number) => {
      const centerX = currentViewBox.x + currentViewBox.width / 2;
      const centerY = currentViewBox.y + currentViewBox.height / 2;
      setMapViewBoxCentered(centerX, centerY, currentViewBox.width * factor);
    };

    const isTouchMap = () => (
      window.matchMedia('(pointer: coarse)').matches || root.getBoundingClientRect().width <= 520
    );

    const nodeCenter = (node: Element) => {
      const dot = node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
      const x = toFiniteNumber(dot?.getAttribute('cx'));
      const y = toFiniteNumber(dot?.getAttribute('cy'));
      return x === null || y === null ? null : { x, y };
    };

    const svgPointForBox = (event: PointerEvent | MouseEvent, box: MapViewBox) => {
      if (!svgEl) return null;
      const rect = svgEl.getBoundingClientRect();
      const scale = Math.min(rect.width / box.width, rect.height / box.height);
      if (!Number.isFinite(scale) || scale <= 0) return null;
      const renderedWidth = box.width * scale;
      const renderedHeight = box.height * scale;
      const offsetX = (rect.width - renderedWidth) / 2;
      const offsetY = (rect.height - renderedHeight) / 2;
      const x = box.x + (event.clientX - rect.left - offsetX) / scale;
      const y = box.y + (event.clientY - rect.top - offsetY) / scale;
      if (
        x < box.x ||
        x > box.x + box.width ||
        y < box.y ||
        y > box.y + box.height
      ) return null;
      return { x, y };
    };

    const svgPointForEvent = (event: PointerEvent | MouseEvent) => svgPointForBox(event, currentViewBox);

    const clientScaleForBox = (box: MapViewBox) => {
      if (!svgEl) return 1;
      const rect = svgEl.getBoundingClientRect();
      const scale = Math.min(rect.width / box.width, rect.height / box.height);
      return Number.isFinite(scale) && scale > 0 ? scale : 1;
    };

    zoomButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const action = clean(button.dataset.homeMapZoom);
        if (action === 'reset') resetMapView();
        if (action === 'in') zoomMapBy(0.74);
        if (action === 'out') zoomMapBy(1.35);
      });
    });

    // ---- Hover / focus card (lightweight, pointer-events:none) -------------
    let selectedFocusTarget: Element | null = null;
    let activeFocusNodeId = '';
    let selectedEdgeId = '';
    const edgeMetaById = new Map<string, EdgeMeta>();
    const edgeHitById = new Map<string, SVGPathElement>();

    const settleThreadMotion = (thread: SVGPathElement, className: 'is-entering' | 'is-revealing') => {
      const duration = className === 'is-entering' ? 2200 : 1100;
      window.setTimeout(() => thread.classList.remove(className), duration);
    };

    const markThreadRevealing = (thread: SVGPathElement) => {
      thread.classList.remove('is-revealing');
      void thread.getBoundingClientRect();
      thread.classList.add('is-revealing');
      settleThreadMotion(thread, 'is-revealing');
    };

    // Replays the one-shot arrival comet — used to reveal connections that were
    // held back (is-pending-reveal) while a node was selected. Decision 8.
    const markThreadEntering = (thread: SVGPathElement) => {
      thread.classList.remove('is-pending-reveal', 'is-entering');
      void thread.getBoundingClientRect();
      thread.classList.add('is-entering');
      settleThreadMotion(thread, 'is-entering');
    };

    const registerThread = (thread: SVGPathElement) => {
      if (thread.dataset.threadRegistered === 'true') return;
      thread.dataset.threadRegistered = 'true';
      thread.addEventListener('animationend', (event) => {
        const animationName = (event as AnimationEvent).animationName;
        if (animationName === 'gpMapThreadGrow') thread.classList.remove('is-entering');
        if (animationName === 'gpMapAdjacentThread') thread.classList.remove('is-revealing');
      });
      if (thread.classList.contains('is-entering')) settleThreadMotion(thread, 'is-entering');
    };

    const ENDPOINT_ROLE_LABELS: Record<string, string> = { chapter: 'Chapter', steward: 'Steward', member: 'Member' };
    const endpointRoleLabel = (type: string) => (
      ENDPOINT_ROLE_LABELS[type] || (type ? type.charAt(0).toUpperCase() + type.slice(1) : 'Node')
    );
    // Relationship type, named from the two endpoint roles (steward first). The
    // web is person-to-person — there is no steward-chapter kind.
    const edgePairLabel = (edge: EdgeMeta) => {
      const order: Record<string, number> = { steward: 0, member: 1, chapter: 2 };
      const [a, b] = [edge.from.type, edge.to.type].sort((x, y) => (order[x] ?? 9) - (order[y] ?? 9));
      return `${endpointRoleLabel(a)} ↔ ${endpointRoleLabel(b)}`;
    };

    const oppositeEndpoint = (edge: EdgeMeta, nodeId: string): EdgeEndpoint => (
      edge.from.id === nodeId ? edge.to : edge.from
    );

    const visibleThreadForEdge = (edgeId: string) => (
      root.querySelector(`.gp-home-map-thread[data-edge-id="${CSS.escape(edgeId)}"]:not(.is-filtered-out)`) as SVGPathElement | null
    );

    const connectedEdgesFor = (nodeId: string) => (
      Array.from(edgeMetaById.values())
        .filter((edge) => edge.from.id === nodeId || edge.to.id === nodeId)
        .filter((edge) => Boolean(visibleThreadForEdge(edge.edgeId)))
    );

    const positionEdgeTooltip = (event: PointerEvent | MouseEvent) => {
      if (!edgeTooltip) return;
      const rootRect = root.getBoundingClientRect();
      const tooltipRect = edgeTooltip.getBoundingClientRect();
      const padding = 10;
      const rawX = event.clientX - rootRect.left + 14;
      const rawY = event.clientY - rootRect.top + 14;
      const x = Math.min(Math.max(padding, rawX), Math.max(padding, rootRect.width - tooltipRect.width - padding));
      const y = Math.min(Math.max(padding, rawY), Math.max(padding, rootRect.height - tooltipRect.height - padding));
      edgeTooltip.style.left = `${x}px`;
      edgeTooltip.style.top = `${y}px`;
    };

    const showEdgeTooltip = (edgeId: string, event: PointerEvent | MouseEvent) => {
      const edge = edgeMetaById.get(edgeId);
      if (!edge || !edgeTooltip || !edgeTooltipKicker || !edgeTooltipTitle || !edgeTooltipMeta || isTouchMap()) return;
      edgeTooltipKicker.textContent = edgePairLabel(edge);
      edgeTooltipTitle.textContent = `${edge.from.name} → ${edge.to.name}`;
      edgeTooltipMeta.textContent = edge.themeLabel + (edge.bioregion ? ` · ${edge.bioregion}` : '');
      edgeTooltip.style.setProperty('--edge-color', edge.themeColor);
      edgeTooltip.setAttribute('aria-hidden', 'false');
      positionEdgeTooltip(event);
    };

    const hideEdgeTooltip = () => {
      if (!edgeTooltip) return;
      edgeTooltip.setAttribute('aria-hidden', 'true');
    };

    const applyEdgeHighlight = (edgeId: string) => {
      selectedEdgeId = edgeId;
      root.querySelectorAll('.gp-home-map-thread, .gp-home-map-thread-hit').forEach((edge) => {
        edge.classList.toggle('is-edge-selected', clean((edge as HTMLElement).dataset.edgeId) === edgeId);
      });
      scope.querySelectorAll('[data-selected-edge-row]').forEach((row) => {
        const selected = clean((row as HTMLElement).dataset.selectedEdgeRow) === edgeId;
        row.classList.toggle('is-active', selected);
        row.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    };

    const clearEdgeHighlight = () => {
      selectedEdgeId = '';
      root.querySelectorAll('.gp-home-map-thread, .gp-home-map-thread-hit').forEach((edge) => {
        edge.classList.remove('is-edge-selected');
      });
      scope.querySelectorAll('[data-selected-edge-row]').forEach((row) => {
        row.classList.remove('is-active');
        row.setAttribute('aria-pressed', 'false');
      });
    };

    const syncEdgeHitState = (thread: SVGPathElement) => {
      const edgeId = clean(thread.dataset.edgeId);
      const hit = edgeId ? edgeHitById.get(edgeId) : null;
      if (!hit) return;
      hit.classList.toggle('is-adj', thread.classList.contains('is-adj'));
      hit.classList.toggle('is-dim', thread.classList.contains('is-dim'));
      hit.classList.toggle('is-type-filter-match', thread.classList.contains('is-type-filter-match'));
      hit.classList.toggle('is-filtered-out', thread.classList.contains('is-filtered-out'));
      hit.classList.toggle('is-edge-selected', selectedEdgeId === edgeId);
    };

    const registerEdgeHit = (hit: SVGPathElement) => {
      if (hit.dataset.edgeHitRegistered === 'true') return;
      hit.dataset.edgeHitRegistered = 'true';
      hit.addEventListener('pointerenter', (event) => {
        const edgeId = clean(hit.dataset.edgeId);
        if (!edgeId || !(hit.classList.contains('is-adj') || hit.classList.contains('is-type-filter-match'))) return;
        showEdgeTooltip(edgeId, event);
      });
      hit.addEventListener('pointermove', (event) => {
        if (edgeTooltip?.getAttribute('aria-hidden') === 'false') positionEdgeTooltip(event);
      });
      hit.addEventListener('pointerleave', hideEdgeTooltip);
    };

    const clearFocusState = () => {
      activeFocusNodeId = '';
      root.classList.remove('is-focused');
      root.querySelectorAll('.gp-home-map-thread').forEach((t) => t.classList.remove('is-adj', 'is-dim', 'is-revealing', 'is-selected-adj'));
      root.querySelectorAll('.gp-home-map-thread-hit').forEach((t) => t.classList.remove('is-adj', 'is-dim'));
      root.querySelectorAll('.gp-home-map-node-link').forEach((l) => l.classList.remove('is-adj', 'is-dim', 'is-edge-target'));
      clearSelectionStrands();
      hideEdgeTooltip();
      clearEdgeHighlight();
      if (focusEl) focusEl.setAttribute('aria-hidden', 'true');
    };

    const clearFocus = () => {
      if (selectedFocusTarget && !selectedFocusTarget.classList.contains('is-filtered-out')) {
        setFocus(selectedFocusTarget);
        return;
      }
      clearFocusState();
    };

    // On deselect the map softly re-reveals its resting web, and any connections
    // that polled in while a node was selected (held back as is-pending-reveal)
    // now comet in — so live arrivals are captured rather than flashed mid-view.
    const revealDefaultState = () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread.is-pending-reveal').forEach((thread) => {
        if (reduceMotion) {
          thread.classList.remove('is-pending-reveal');
          return;
        }
        markThreadEntering(thread);
      });
      if (reduceMotion) return;
      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread:not(.is-filtered-out):not(.is-pending-reveal)').forEach((thread) => {
        thread.classList.remove('is-resettling');
        void thread.getBoundingClientRect();
        thread.classList.add('is-resettling');
        const onEnd = () => {
          thread.classList.remove('is-resettling');
          thread.removeEventListener('animationend', onEnd);
        };
        thread.addEventListener('animationend', onEnd);
      });
    };

    // Public links only: an external profile/social URL (new tab) and, for
    // stewards, the same-site chapter page. cleanHref already rejected unsafe
    // schemes. Returns the count so callers can hide an empty row.
    const renderNodeLinks = (
      container: HTMLElement | null,
      node: { profileUrl?: string; chapterSlug?: string; type?: string; name?: string }
    ) => {
      if (!container) return 0;
      container.textContent = '';
      const safeName = clean(node.name) || 'this node';
      let count = 0;
      const appendLink = (href: string, label: string, aria: string, external: boolean) => {
        const a = document.createElement('a');
        applyScope(a);
        a.className = 'gp-home-map-selected-link';
        a.href = href;
        if (external) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
        a.textContent = label;
        a.setAttribute('aria-label', aria);
        container.append(a);
        count += 1;
      };

      // A chapter's single link is its own public page.
      if (node.type === 'chapter') {
        const href = chapterHref(node.chapterSlug);
        if (href) appendLink(href, 'Visit chapter →', `Open the chapter page for ${safeName}`, false);
        return count;
      }

      // People carry exactly one external link: their profile.
      const profile = cleanHref(node.profileUrl);
      if (profile) appendLink(profile, 'Profile ↗', `Open ${safeName}'s profile in a new tab`, /^https?:\/\//i.test(profile));

      // A steward's chapter affiliation is an in-map jump (not an external link) —
      // it opens the chapter node on the map, from where its page can be visited.
      if (node.type === 'steward' && node.chapterSlug) {
        const chapterEl = root.querySelector(`.gp-home-map-node-link.is-chapter[data-node-id="${CSS.escape('chapter:' + node.chapterSlug)}"]`);
        const chapterName = clean(chapterEl?.getAttribute('data-node-name')) || 'their chapter';
        const button = document.createElement('button');
        applyScope(button);
        button.type = 'button';
        button.className = 'gp-home-map-selected-link is-chapter-jump';
        button.textContent = `${chapterName} →`;
        button.setAttribute('aria-label', `Show ${chapterName} on the map`);
        button.addEventListener('click', () => selectChapterBySlug(node.chapterSlug || '', button.matches(':focus-visible')));
        container.append(button);
        count += 1;
      }

      return count;
    };

    const setFocus = (target: Element) => {
      const id = target.getAttribute('data-node-id');
      const type = target.getAttribute('data-node-type');
      if (!id || !type) return;

      root.classList.add('is-focused');
      const revealFocus = activeFocusNodeId !== id;
      activeFocusNodeId = id;
      if (revealFocus) {
        hideEdgeTooltip();
        clearEdgeHighlight();
      }

      const adjacentIds = new Set<string>([id]);
      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread').forEach((t) => {
        const from = t.getAttribute('data-from');
        const to = t.getAttribute('data-to');
        if (from === id || to === id) {
          const wasAdjacent = t.classList.contains('is-adj');
          t.classList.add('is-adj');
          t.classList.remove('is-dim');
          if (revealFocus || !wasAdjacent) markThreadRevealing(t);
          if (from && from !== id) adjacentIds.add(from);
          if (to && to !== id) adjacentIds.add(to);
        } else {
          t.classList.remove('is-adj', 'is-revealing');
          t.classList.add('is-dim');
        }
        syncEdgeHitState(t);
      });

      root.querySelectorAll('.gp-home-map-node-link').forEach((l) => {
        const lid = l.getAttribute('data-node-id');
        if (!lid) return;
        l.classList.toggle('is-adj', adjacentIds.has(lid));
        l.classList.toggle('is-dim', !adjacentIds.has(lid));
      });

      if (focusEl && focusRole && focusName && focusMeta) {
        const raw = target.querySelector('title')?.textContent || '';
        const parts = raw.split('·').map((s) => s.trim());
        const targetEl = target as HTMLElement;
        focusName.textContent = clean(targetEl.dataset.nodeName) || parts[0] || '';
        const focusType = filterTypeFor(type);
        const roleLabel = clean(targetEl.dataset.nodeRole) || focusType.charAt(0).toUpperCase() + focusType.slice(1);
        const placeLabel = clean(targetEl.dataset.nodePlace) || parts.slice(1).join(' · ');
        focusRole.textContent = placeLabel ? `${roleLabel} · ${placeLabel}` : roleLabel;
        const bioregion = publicBioregion(targetEl.dataset.nodeBioregion);
        const note = clean(targetEl.dataset.nodePublicNote);
        focusMeta.textContent = focusType === 'chapter'
          ? ''
          : bioregion && note
            ? `${bioregion} · ${note}`
            : bioregion || note;
        if (focusThemes) {
          focusThemes.textContent = '';
          nodeThemes(target).slice(0, 4).forEach((slug) => {
            const chip = document.createElement('span');
            applyScope(chip);
            chip.textContent = themeLabel(slug);
            chip.style.setProperty('--chip-color', themeColor(slug));
            focusThemes.append(chip);
          });
        }
        const dot = target.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
        const cx = Number(dot?.getAttribute('cx'));
        const cy = Number(dot?.getAttribute('cy'));
        if (Number.isFinite(cx) && Number.isFinite(cy)) {
          const xPct = ((cx - currentViewBox.x) / currentViewBox.width) * 100;
          const yPct = ((cy - currentViewBox.y) / currentViewBox.height) * 100;
          focusEl.style.left = `${xPct}%`;
          focusEl.style.top = `${yPct}%`;
          focusEl.style.transform = `translate(${xPct < 60 ? 'var(--gp-map-card-offset)' : 'calc(-100% - var(--gp-map-card-offset))'}, ${yPct < 50 ? 'var(--gp-map-card-offset)' : 'calc(-100% - var(--gp-map-card-offset))'})`;
        }
        focusEl.dataset.nodeType = focusType;
        // The selected node already shows the persistent popover; don't stack the
        // transient hover card on top of it. Hovering OTHER nodes still shows it.
        focusEl.setAttribute('aria-hidden', target === selectedFocusTarget ? 'true' : 'false');
      }
    };

    // ---- Selected-node colour web + per-theme strands ----------------------
    // The selected node is the only place a line carries theme colour. Hovering
    // a different node never colourises — it only gets the neutral `.is-adj`
    // highlight, because colour rides `.is-selected-adj`, which is pinned to the
    // selected node's edges here and not touched by setFocus.
    const SELECTION_STRAND_GAP = 0.72;
    const MAX_SELECTION_STRANDS = 4;
    let lastSelectionStrandSignature = '';

    const centerForId = (id: string) => {
      const node = id
        ? root.querySelector(`.gp-home-map-node-link[data-node-id="${CSS.escape(id)}"]`)
        : null;
      return node ? nodeCenter(node) : null;
    };

    // Shared themes are derived from the two endpoints' public theme lists — both
    // already in the DOM, so this needs no /map/state payload change.
    const sharedThemesForEdge = (fromId: string, toId: string): string[] => {
      const fromNode = fromId ? root.querySelector(`.gp-home-map-node-link[data-node-id="${CSS.escape(fromId)}"]`) : null;
      const toNode = toId ? root.querySelector(`.gp-home-map-node-link[data-node-id="${CSS.escape(toId)}"]`) : null;
      if (!fromNode || !toNode) return [];
      const toThemes = new Set(nodeThemes(toNode));
      return nodeThemes(fromNode).filter((theme) => toThemes.has(theme));
    };

    const clearSelectionStrands = () => {
      if (selectionStrandsGroup) selectionStrandsGroup.textContent = '';
      lastSelectionStrandSignature = '';
    };

    // One strand per shared theme, only when an edge shares more than one theme.
    // Each strand springs from both node centres and bows out (per strand) through
    // the belly, so multi-theme links read as woven mycelial filaments rather than
    // rigid parallel rails — the endpoints stay pinned to the nodes, only the
    // middle fans. The centre strand runs thickest for a cored, grown feel.
    const buildSelectionStrandSpecs = (nodeId: string) => {
      const specs: Array<{ d: string; theme: string; index: number; width: number }> = [];
      if (!nodeId) return specs;
      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread.is-selected-adj:not(.is-filtered-out)').forEach((thread) => {
        const from = thread.getAttribute('data-from') || '';
        const to = thread.getAttribute('data-to') || '';
        const edgeTheme = thread.getAttribute('data-theme') || '';
        const shared = sharedThemesForEdge(from, to);
        const themesList = [...new Set((shared.length ? shared : [edgeTheme]).filter(Boolean))].slice(0, MAX_SELECTION_STRANDS);
        if (themesList.length <= 1) return;
        const a = centerForId(from);
        const b = centerForId(to);
        if (!a || !b) return;
        const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
        const nx = -(b.y - a.y) / len;
        const ny = (b.x - a.x) / len;
        const mid = (themesList.length - 1) / 2;
        themesList.forEach((theme, index) => {
          const offset = (index - mid) * SELECTION_STRAND_GAP;
          // Asymmetric control points (1.15 vs 0.85) give each filament a gentle,
          // non-circular bow so the bundle weaves instead of mirroring.
          const c1x = a.x + (b.x - a.x) * 0.33 + nx * offset * 1.15;
          const c1y = a.y + (b.y - a.y) * 0.33 + ny * offset * 1.15;
          const c2x = a.x + (b.x - a.x) * 0.67 + nx * offset * 0.85;
          const c2y = a.y + (b.y - a.y) * 0.67 + ny * offset * 0.85;
          const d = `M${a.x.toFixed(2)} ${a.y.toFixed(2)} C${c1x.toFixed(2)} ${c1y.toFixed(2)} ${c2x.toFixed(2)} ${c2y.toFixed(2)} ${b.x.toFixed(2)} ${b.y.toFixed(2)}`;
          const width = Math.max(0.18, 0.34 - Math.abs(index - mid) * 0.05);
          specs.push({ d, theme, index, width });
        });
      });
      return specs;
    };

    const renderSelectionStrands = (nodeId: string) => {
      if (!selectionStrandsGroup) return;
      const specs = buildSelectionStrandSpecs(nodeId);
      const signature = `${nodeId}|${specs.map((s) => `${s.theme}:${s.d}`).join('~')}`;
      // Idempotent across polls/filter passes — only rebuild (and re-run the
      // one-shot grow) when the strand set actually changes, so there is no loop.
      if (signature === lastSelectionStrandSignature) return;
      lastSelectionStrandSignature = signature;
      selectionStrandsGroup.textContent = '';
      specs.forEach((spec) => {
        const strand = document.createElementNS(SVG_NS, 'path');
        applyScope(strand);
        strand.setAttribute('class', 'gp-home-map-strand is-entering-strand');
        strand.setAttribute('d', spec.d);
        strand.setAttribute('pathLength', '1');
        strand.setAttribute('stroke', themeColor(spec.theme));
        strand.style.setProperty('--thread-color', themeColor(spec.theme));
        strand.style.strokeWidth = spec.width.toFixed(2);
        strand.style.animationDelay = `${(spec.index * 0.06).toFixed(2)}s`;
        selectionStrandsGroup.append(strand);
      });
    };

    // Pin theme colour to the selected node's edges (and only those). Cheap and
    // idempotent, so it is safe to re-run after filter/poll redraws.
    const markSelectedThreads = (nodeId: string) => {
      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread').forEach((thread) => {
        const from = thread.getAttribute('data-from');
        const to = thread.getAttribute('data-to');
        thread.classList.toggle('is-selected-adj', Boolean(nodeId) && (from === nodeId || to === nodeId));
      });
      renderSelectionStrands(nodeId);
    };

    // SVG hit targets can be visually small. Track the nearest visible node
    // from the map surface as well so chapter focus cards appear where users
    // expect them, even when the pointer lands just outside the painted dot.
    let pointerFocusTarget: Element | null = null;
    const nodeAtPointer = (event: PointerEvent | MouseEvent, minClientRadius = 0): Element | null => {
      const point = svgPointForEvent(event);
      if (!point) return null;
      const minViewRadius = minClientRadius > 0 ? minClientRadius / clientScaleForBox(currentViewBox) : 0;

      let nearest: { node: Element; distance: number } | null = null;
      root.querySelectorAll('.gp-home-map-node-link:not(.is-filtered-out)').forEach((node) => {
        const dot = node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
        const cx = Number(dot?.getAttribute('cx'));
        const cy = Number(dot?.getAttribute('cy'));
        const r = Number(dot?.getAttribute('r')) || 1.4;
        if (!Number.isFinite(cx) || !Number.isFinite(cy)) return;
        const distance = Math.hypot(point.x - cx, point.y - cy);
        const hitRadius = Math.max(NODE_HIT_RADIUS, r + 3.2, minViewRadius);
        if (distance > hitRadius) return;
        if (!nearest || distance < nearest.distance) nearest = { node, distance };
      });
      return nearest?.node ?? null;
    };

    const gesturePointers = new Map<number, PointerEvent>();
    let panStart: null | { clientX: number; clientY: number; viewBox: MapViewBox } = null;
    let pinchStart: null | {
      distance: number;
      midX: number;
      midY: number;
      centerX: number;
      centerY: number;
      viewBox: MapViewBox;
    } = null;
    let suppressNextNodeClick = false;
    let lastMapPointerWasTouch = false;
    let lastMapPointerAt = 0;

    const isRecentTouchMapClick = () => (
      lastMapPointerWasTouch && Date.now() - lastMapPointerAt < 900
    );

    const isGestureBlocked = (target: EventTarget | null) => (
      target instanceof Element &&
      Boolean(target.closest('.gp-home-map-controls, .gp-home-map-legend, .gp-home-map-focus, .gp-home-map-selected, .gp-home-map-edge-tooltip, .gp-home-map-list-drawer'))
    );

    const pointerDistance = (a: PointerEvent, b: PointerEvent) => Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);

    const midpoint = (a: PointerEvent, b: PointerEvent) => ({
      x: (a.clientX + b.clientX) / 2,
      y: (a.clientY + b.clientY) / 2,
    });

    const startPinch = () => {
      const pointers = Array.from(gesturePointers.values());
      if (pointers.length < 2) return;
      const [a, b] = pointers;
      const mid = midpoint(a, b);
      const midEvent = { clientX: mid.x, clientY: mid.y } as PointerEvent;
      const center = svgPointForBox(midEvent, currentViewBox) ?? {
        x: currentViewBox.x + currentViewBox.width / 2,
        y: currentViewBox.y + currentViewBox.height / 2,
      };
      pinchStart = {
        distance: Math.max(1, pointerDistance(a, b)),
        midX: mid.x,
        midY: mid.y,
        centerX: center.x,
        centerY: center.y,
        viewBox: { ...currentViewBox },
      };
      panStart = null;
    };

    const resetGesture = (pointerId?: number) => {
      if (typeof pointerId === 'number') gesturePointers.delete(pointerId);
      if (gesturePointers.size === 0) {
        panStart = null;
        pinchStart = null;
        return;
      }
      if (gesturePointers.size === 1) {
        const pointer = Array.from(gesturePointers.values())[0];
        panStart = { clientX: pointer.clientX, clientY: pointer.clientY, viewBox: { ...currentViewBox } };
        pinchStart = null;
      }
    };

    root.addEventListener('pointerdown', (event) => {
      if (isGestureBlocked(event.target)) return;
      lastMapPointerWasTouch = event.pointerType !== 'mouse';
      lastMapPointerAt = Date.now();
      const mouse = event.pointerType === 'mouse';
      // Touch: pan + pinch on touch maps. Mouse/trackpad: bounded drag-pan only
      // when zoomed in (the full map has nothing to pan) and with the primary
      // button — so hover/click on desktop is untouched until the user zooms.
      if (mouse) {
        if (!root.classList.contains('is-zoomed') || event.button !== 0) return;
      } else if (!isTouchMap()) {
        return;
      }
      if (!svgPointForEvent(event)) return;
      gesturePointers.set(event.pointerId, event);
      try {
        root.setPointerCapture?.(event.pointerId);
      } catch {
        // Synthetic browser-smoke events and interrupted touch streams can miss
        // capture; the gesture state still works from bubbled pointer events.
      }
      if (gesturePointers.size === 1) {
        // Fresh interaction — a stale suppress flag from a prior drag must not
        // swallow this tap/click.
        suppressNextNodeClick = false;
        panStart = { clientX: event.clientX, clientY: event.clientY, viewBox: { ...currentViewBox } };
        if (mouse) root.classList.add('is-grabbing');
      } else {
        startPinch();
      }
    });

    root.addEventListener('pointermove', (event) => {
      if (!gesturePointers.has(event.pointerId)) return;
      gesturePointers.set(event.pointerId, event);
      // Mouse drag-pan runs on desktop too; pinch stays touch-only (it needs two
      // pointers, which a mouse can't produce).
      if (!isTouchMap() && event.pointerType !== 'mouse') return;

      if (gesturePointers.size >= 2 && pinchStart) {
        const pointers = Array.from(gesturePointers.values());
        const [a, b] = pointers;
        const distance = Math.max(1, pointerDistance(a, b));
        const mid = midpoint(a, b);
        const scale = clientScaleForBox(pinchStart.viewBox);
        const ratio = distance / pinchStart.distance;
        const nextWidth = pinchStart.viewBox.width / ratio;
        const dx = (mid.x - pinchStart.midX) / scale;
        const dy = (mid.y - pinchStart.midY) / scale;
        setMapViewBoxCentered(pinchStart.centerX - dx, pinchStart.centerY - dy, nextWidth);
        suppressNextNodeClick = true;
        event.preventDefault();
        return;
      }

      if (gesturePointers.size === 1 && panStart) {
        const dxPixels = event.clientX - panStart.clientX;
        const dyPixels = event.clientY - panStart.clientY;
        if (Math.hypot(dxPixels, dyPixels) < 5) return;
        const scale = clientScaleForBox(panStart.viewBox);
        setMapViewBox({
          ...panStart.viewBox,
          x: panStart.viewBox.x - dxPixels / scale,
          y: panStart.viewBox.y - dyPixels / scale,
        });
        suppressNextNodeClick = true;
        event.preventDefault();
      }
    });

    ['pointerup', 'pointercancel', 'lostpointercapture'].forEach((eventName) => {
      root.addEventListener(eventName, (event) => {
        resetGesture((event as PointerEvent).pointerId);
        if (gesturePointers.size === 0) root.classList.remove('is-grabbing');
      });
    });

    // Single source of truth for drag-vs-click: a drag-pan that ends on a node
    // must neither navigate the chapter <a> nor open a panel. Runs in capture
    // phase (before the node/link click handlers and the link default); a normal
    // click leaves the flag false so this is a no-op.
    svgEl?.addEventListener('click', (event) => {
      if (!suppressNextNodeClick) return;
      suppressNextNodeClick = false;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, true);
    // Block native link/image drag while panning the zoomed map.
    root.addEventListener('dragstart', (event) => {
      if (root.classList.contains('is-grabbing')) event.preventDefault();
    });

    root.addEventListener('pointermove', (event) => {
      if (isTouchMap() && event.pointerType !== 'mouse') return;
      if (gesturePointers.size > 0) return;
      if (selectedFocusTarget) return;
      const target = nodeAtPointer(event);
      if (!target) {
        if (pointerFocusTarget) {
          pointerFocusTarget = null;
          clearFocus();
        }
        return;
      }
      if (target === pointerFocusTarget) return;
      pointerFocusTarget = target;
      setFocus(target);
    });

    // ---- Selected-node panel + owner edit-link request ---------------------
    const selectedEl = scope.querySelector('[data-home-map-selected]') as HTMLElement | null;
    const selectedKicker = scope.querySelector('[data-selected-kicker]') as HTMLElement | null;
    const selectedName = scope.querySelector('[data-selected-name]') as HTMLElement | null;
    const selectedPlace = scope.querySelector('[data-selected-place]') as HTMLElement | null;
    const selectedBioregion = scope.querySelector('[data-selected-bioregion]') as HTMLElement | null;
    const selectedThemesEl = scope.querySelector('[data-selected-themes]') as HTMLElement | null;
    const selectedNote = scope.querySelector('[data-selected-note]') as HTMLElement | null;
    const selectedLinks = scope.querySelector('[data-selected-links]') as HTMLElement | null;
    const selectedEdgeList = scope.querySelector('[data-selected-edge-list]') as HTMLElement | null;
    const selectedEdgeItems = scope.querySelector('[data-selected-edge-items]') as HTMLElement | null;
    const selectedClose = scope.querySelector('[data-selected-close]') as HTMLButtonElement | null;
    const selectedLive = scope.querySelector('[data-selected-live]') as HTMLElement | null;
    const updateWrap = scope.querySelector('[data-home-map-update]') as HTMLElement | null;
    const updateTrigger = scope.querySelector('[data-update-trigger]') as HTMLButtonElement | null;
    const updateForm = scope.querySelector('[data-update-form]') as HTMLFormElement | null;
    const updateCancel = scope.querySelector('[data-update-cancel]') as HTMLButtonElement | null;
    const updateError = scope.querySelector('[data-update-error]') as HTMLElement | null;
    const updateSuccess = scope.querySelector('[data-update-success]') as HTMLElement | null;
    const updateEmail = updateForm?.elements.namedItem('email') as HTMLInputElement | null;

    let activeSourceId = '';

    const cssPx = (name: string, fallback: number) => {
      const value = Number.parseFloat(window.getComputedStyle(root).getPropertyValue(name));
      return Number.isFinite(value) ? value : fallback;
    };

    const clampNumber = (value: number, min: number, max: number) => {
      const safeMax = Math.max(min, max);
      return Math.min(Math.max(value, min), safeMax);
    };

    const positionSelectedCard = (target: Element | null) => {
      if (!selectedEl || selectedEl.hidden || !target || isTouchMap()) return;
      const dot = target.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
      const cx = Number(dot?.getAttribute('cx'));
      const cy = Number(dot?.getAttribute('cy'));
      if (!Number.isFinite(cx) || !Number.isFinite(cy)) return;
      const xPct = ((cx - currentViewBox.x) / currentViewBox.width) * 100;
      const yPct = ((cy - currentViewBox.y) / currentViewBox.height) * 100;
      const rootRect = root.getBoundingClientRect();
      const cardRect = selectedEl.getBoundingClientRect();
      const offset = cssPx('--gp-map-card-offset', 22);
      const inset = 12;
      const anchorX = (xPct / 100) * rootRect.width;
      const anchorY = (yPct / 100) * rootRect.height;
      const desiredX = xPct < 60 ? anchorX + offset : anchorX - cardRect.width - offset;
      const desiredY = yPct < 50 ? anchorY + offset : anchorY - cardRect.height - offset;
      selectedEl.style.setProperty('--gp-selected-x', `${clampNumber(desiredX, inset, rootRect.width - cardRect.width - inset)}px`);
      selectedEl.style.setProperty('--gp-selected-y', `${clampNumber(desiredY, inset, rootRect.height - cardRect.height - inset)}px`);
      selectedEl.style.setProperty('--gp-selected-transform', 'none');
    };

    syncSelectedOverlay = () => {
      if (!selectedEl || selectedEl.hidden) {
        root.classList.remove('has-selected-node');
        root.style.removeProperty('--gp-map-selected-clearance');
        return;
      }
      root.classList.add('has-selected-node');
      const selectedHeight = selectedEl.getBoundingClientRect().height;
      if (Number.isFinite(selectedHeight) && selectedHeight > 0) {
        root.style.setProperty('--gp-map-selected-clearance', `${Math.ceil(selectedHeight + 18)}px`);
      }
      positionSelectedCard(selectedFocusTarget);
    };

    const resetUpdateState = () => {
      activeSourceId = '';
      if (updateForm) {
        updateForm.hidden = true;
        if (updateEmail) updateEmail.value = '';
      }
      if (updateError) updateError.textContent = '';
      if (updateSuccess) updateSuccess.hidden = true;
      if (updateTrigger) updateTrigger.hidden = false;
    };

    // One-shot "peek" so an overflowing theme carousel hints it scrolls, then
    // settles. User-triggered (row activation) and reduced-motion aware — never
    // an idle loop.
    const peekCarousel = (strip: HTMLElement | null) => {
      if (!strip) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const overflow = strip.scrollWidth - strip.clientWidth;
      if (overflow <= 4) return;
      // Assigning scrollLeft animates via the strip's CSS `scroll-behavior: smooth`
      // (browsers force it to instant under reduced motion). One-shot peek; no loop.
      strip.scrollLeft = overflow;
      window.setTimeout(() => { strip.scrollLeft = 0; }, 900);
    };

    const renderSelectedEdgeList = (nodeId: string) => {
      if (!selectedEdgeList || !selectedEdgeItems) return;
      selectedEdgeItems.textContent = '';
      const edges = connectedEdgesFor(nodeId);
      selectedEdgeList.hidden = edges.length === 0;
      edges.forEach((edge) => {
        const connected = oppositeEndpoint(edge, nodeId);
        const connectedEl = root.querySelector(`.gp-home-map-node-link[data-node-id="${CSS.escape(connected.id)}"]`);
        const shared = sharedThemesForEdge(edge.from.id, edge.to.id);
        const themeSlugs = [...new Set((shared.length ? shared : [edge.theme]).filter(Boolean))];

        const item = document.createElement('div');
        applyScope(item);
        item.className = 'gp-home-map-selected-edge-item';
        item.style.setProperty('--edge-color', edge.themeColor);

        // Name area — selecting it highlights the connection + connected node.
        const row = document.createElement('button');
        applyScope(row);
        row.type = 'button';
        row.className = 'gp-home-map-selected-edge-row';
        row.dataset.selectedEdgeRow = edge.edgeId;
        row.setAttribute('aria-pressed', selectedEdgeId === edge.edgeId ? 'true' : 'false');

        const mark = document.createElement('span');
        applyScope(mark);
        mark.className = 'gp-home-map-selected-edge-mark';
        mark.setAttribute('aria-hidden', 'true');

        const copy = document.createElement('span');
        applyScope(copy);
        copy.className = 'gp-home-map-selected-edge-copy';

        const name = document.createElement('span');
        applyScope(name);
        name.className = 'gp-home-map-selected-edge-name';
        name.textContent = connected.name || connected.id;

        const meta = document.createElement('span');
        applyScope(meta);
        meta.className = 'gp-home-map-selected-edge-meta';
        meta.textContent = endpointRoleLabel(connected.type);

        copy.append(name, meta);
        row.append(mark, copy);

        // Shared themes — single non-wrapping row; overflow scrolls (carousel)
        // so a long list never makes rows uneven.
        const themesStrip = document.createElement('div');
        applyScope(themesStrip);
        themesStrip.className = 'gp-home-map-selected-edge-themes';
        themeSlugs.slice(0, 6).forEach((slug) => {
          const chip = document.createElement('span');
          applyScope(chip);
          chip.className = 'gp-home-map-selected-edge-theme';
          chip.textContent = themeLabel(slug);
          chip.style.setProperty('--chip-color', themeColor(slug));
          themesStrip.append(chip);
        });

        row.addEventListener('click', () => {
          applyEdgeHighlight(edge.edgeId);
          root.querySelectorAll('.gp-home-map-node-link.is-edge-target').forEach((n) => n.classList.remove('is-edge-target'));
          if (connectedEl) connectedEl.classList.add('is-edge-target');
          peekCarousel(themesStrip);
        });
        item.append(row);

        // Open-link control — the connected person's public profile (new tab) or
        // their same-site chapter page. Separate from row selection.
        // One link per connection: the connected person's profile (new tab) only.
        const connProfile = cleanHref(connectedEl?.getAttribute('data-node-profile-url'));
        if (connProfile) {
          const open = document.createElement('a');
          applyScope(open);
          open.className = 'gp-home-map-selected-edge-open';
          open.href = connProfile;
          open.target = '_blank';
          open.rel = 'noopener noreferrer';
          open.textContent = '↗';
          open.setAttribute('aria-label', `Open ${connected.name || 'connection'}'s profile in a new tab`);
          open.addEventListener('click', (event) => event.stopPropagation());
          item.append(open);
        }

        item.append(themesStrip);
        selectedEdgeItems.append(item);
      });
      applyEdgeHighlight(selectedEdgeId);
    };

    const closeSelected = () => {
      const restoreFocus = Boolean(selectedEl?.contains(document.activeElement));
      const focusTarget = selectedFocusTarget;
      const shouldRecoverMobileView = isTouchMap() && root.classList.contains('is-zoomed');
      if (selectedEl) {
        selectedEl.hidden = true;
        delete selectedEl.dataset.selectedType;
      }
      clearBioregionOutline();
      resetUpdateState();
      selectedFocusTarget = null;
      root.querySelectorAll('.gp-home-map-node-link.is-selected').forEach((l) => l.classList.remove('is-selected'));
      if (selectedEdgeList) selectedEdgeList.hidden = true;
      if (selectedLive) selectedLive.textContent = '';
      syncSelectedOverlay();
      clearFocusState();
      revealDefaultState();
      if (shouldRecoverMobileView) resetMapView();
      if (
        restoreFocus &&
        focusTarget &&
        !focusTarget.classList.contains('is-filtered-out') &&
        typeof (focusTarget as HTMLElement).focus === 'function'
      ) {
        (focusTarget as HTMLElement).focus({ preventScroll: true });
      }
    };

    const openSelected = (member: DynamicMapNode, link: Element, viaKeyboard = false) => {
      if (!selectedEl) return;
      resetUpdateState();
      root.querySelectorAll('.gp-home-map-node-link.is-selected').forEach((l) => l.classList.remove('is-selected'));
      // Clear any prior connection-row target highlight when swapping nodes.
      root.querySelectorAll('.gp-home-map-node-link.is-edge-target').forEach((l) => l.classList.remove('is-edge-target'));
      link.classList.add('is-selected');
      selectedFocusTarget = link;
      selectedEdgeId = '';
      selectedEl.dataset.selectedType = member.type;
      const isChapter = member.type === 'chapter';

      if (selectedKicker) {
        const typeLabel = member.type.charAt(0).toUpperCase() + member.type.slice(1);
        selectedKicker.textContent = member.owned
          ? (member.pending ? 'Your pending node' : 'Your node')
          : member.pending ? `Pending ${member.type}` : typeLabel;
        selectedKicker.hidden = isChapter;
      }
      if (selectedName) selectedName.textContent = member.name;
      if (selectedPlace) {
        selectedPlace.textContent = member.place;
        selectedPlace.hidden = !member.place;
      }
      if (selectedBioregion) {
        const bioregion = publicBioregion(member.bioregion);
        selectedBioregion.textContent = bioregion;
        selectedBioregion.hidden = isChapter || !bioregion;
      }
      if (selectedThemesEl) {
        selectedThemesEl.textContent = '';
        if (!isChapter) {
          member.themes.slice(0, 4).forEach((slug) => {
            const chip = document.createElement('span');
            applyScope(chip);
            chip.textContent = themeLabel(slug);
            chip.style.setProperty('--chip-color', themeColor(slug));
            selectedThemesEl.append(chip);
          });
        }
        selectedThemesEl.hidden = isChapter || selectedThemesEl.childElementCount === 0;
      }
      if (selectedNote) {
        selectedNote.textContent = member.publicNote;
        selectedNote.hidden = isChapter || !member.publicNote;
      }
      if (selectedLinks) {
        selectedLinks.hidden = renderNodeLinks(selectedLinks, member) === 0;
      }
      if (isChapter) {
        clearBioregionOutline();
        if (selectedEdgeItems) selectedEdgeItems.textContent = '';
        if (selectedEdgeList) selectedEdgeList.hidden = true;
      } else {
        renderBioregionOutline(member);
        renderSelectedEdgeList(member.key);
      }

      // Owner edit-link is offered for approved submitted nodes only.
      if (updateWrap) updateWrap.hidden = isChapter || !member.approved;
      activeSourceId = !isChapter && member.approved ? member.sourceId : '';

      selectedEl.hidden = false;
      if (selectedLive) selectedLive.textContent = `${member.name} selected on the map.`;
      syncSelectedOverlay();
      if (isChapter) {
        // Chapters sit outside the person-to-person web — selecting one shows its
        // card but leaves the threads at rest (no neighbourhood zoom, no dimming,
        // no colour web). clearFocusState() also tears down any prior node's web.
        clearFocusState();
      } else {
        setFocus(link);
        // Theme colour + per-theme strands ride the selected node's edges only.
        markSelectedThreads(link.getAttribute('data-node-id') || member.key);
      }
      syncSelectedOverlay();
      // Keyboard-initiated selection moves focus into the popover so its Close,
      // links, and Edit controls are reachable without tabbing through every
      // remaining map node first. Pointer selection leaves focus on the node, so
      // there is no surprising focus jump on click (:focus-visible stays off for
      // pointers anyway). Escape or Close returns focus to the node — closeSelected
      // restores it whenever focus is inside the card. Blurring the node here is
      // safe: clearFocus re-applies setFocus(selectedFocusTarget), which preserves
      // the colour web (is-selected-adj is never touched by setFocus).
      if (viaKeyboard) selectedClose?.focus({ preventScroll: true });
      clusterDirty();
    };

    // Chapters keep their <a href> for no-JS navigation; with JS they open this
    // inspect card (which holds the same 'visit chapter' link) so a stray tap
    // explores instead of navigating the page away.
    const openChapterNode = (link: Element, viaKeyboard = false) => {
      const el = link as HTMLElement;
      const slug = clean(el.dataset.nodeId).replace(/^chapter:/, '');
      const chapter: DynamicMapNode = {
        key: clean(el.dataset.nodeId),
        sourceId: '',
        type: 'chapter',
        name: clean(el.dataset.nodeName) || 'Chapter',
        place: clean(el.dataset.nodePlace),
        chapterSlug: slug,
        bioregion: publicBioregion(el.dataset.nodeBioregion),
        bioregionId: publicBioregionId(el.dataset.nodeBioregionId),
        bioregionSource: publicBioregionSource(el.dataset.nodeBioregionSource),
        publicNote: '',
        profileUrl: '',
        themes: [],
        lat: 0,
        long: 0,
        approved: false,
        pending: false,
        owned: false,
      };
      openSelected(chapter, link, viaKeyboard);
    };

    // Cross-link from a steward card: open that steward's chapter node on the map.
    const selectChapterBySlug = (slug: string, viaKeyboard = false) => {
      if (!slug) return;
      const chapterEl = root.querySelector(`.gp-home-map-node-link.is-chapter[data-node-id="${CSS.escape('chapter:' + slug)}"]`);
      if (chapterEl) openChapterNode(chapterEl, viaKeyboard);
    };

    // ---- Embedded map filters ---------------------------------------------
    const syncFilterPanels = () => {
      filterPanels.forEach((panel) => {
        panel.hidden = panel.dataset.filterPanel !== openFilterPanel;
      });
      filterToggleButtons.forEach((button) => {
        const expanded = button.dataset.filterToggle === openFilterPanel;
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        button.classList.toggle('is-active', expanded);
      });
    };

    const closeFilterPanels = () => {
      if (!openFilterPanel) return;
      openFilterPanel = '';
      syncFilterPanels();
    };

    const setFilterPanel = (panelName: string) => {
      openFilterPanel = openFilterPanel === panelName ? '' : panelName;
      if (openFilterPanel) closeNodeList();
      syncFilterPanels();
    };

    const nodeMatchesFilters = (node: Element) => {
      const type = filterTypeFor(node.getAttribute('data-node-type'));
      if (activeTypeFilter && type !== activeTypeFilter) return false;
      return nodeMatchesThemeFilters(node);
    };

    const nodeMatchesThemeFilters = (node: Element) => {
      if (filterTypeFor(node.getAttribute('data-node-type')) === 'chapter') return true;
      if (!allThemeCount || activeThemes.size === allThemeCount) return true;
      return nodeThemes(node).some((theme) => activeThemes.has(theme));
    };

    const setNodeVisibility = (node: Element, visible: boolean) => {
      node.classList.toggle('is-filtered-out', !visible);
      node.setAttribute('aria-hidden', visible ? 'false' : 'true');
      const type = filterTypeFor(node.getAttribute('data-node-type'));
      if (!visible) {
        node.setAttribute('tabindex', '-1');
      } else if (type === 'chapter') {
        node.removeAttribute('tabindex');
      } else {
        node.setAttribute('tabindex', '0');
      }
    };

    applyMapFilters = () => {
      const visibleNodeIds = new Set<string>();
      const nodeTypeById = new Map<string, string>();
      const legendCounts: Record<string, number> = { chapter: 0, steward: 0, member: 0 };
      root.querySelectorAll('.gp-home-map-node-link').forEach((node) => {
        const type = filterTypeFor(node.getAttribute('data-node-type'));
        const id = node.getAttribute('data-node-id');
        if (id) nodeTypeById.set(id, type);
        if (nodeMatchesThemeFilters(node)) {
          legendCounts[type] = (legendCounts[type] ?? 0) + 1;
        }
        const visible = nodeMatchesFilters(node);
        setNodeVisibility(node, visible);
        if (visible && id) visibleNodeIds.add(id);
      });

      root.querySelectorAll<SVGPathElement>('.gp-home-map-thread').forEach((thread) => {
        const from = thread.getAttribute('data-from') || '';
        const to = thread.getAttribute('data-to') || '';
        const theme = thread.getAttribute('data-theme') || '';
        const visible = visibleNodeIds.has(from) && visibleNodeIds.has(to) && themeIsActive(theme);
        const isSameTypeThread = Boolean(
          activeTypeFilter &&
          visible &&
          nodeTypeById.get(from) === activeTypeFilter &&
          nodeTypeById.get(to) === activeTypeFilter
        );
        thread.classList.toggle('is-filtered-out', !visible);
        thread.classList.toggle('is-type-filter-match', isSameTypeThread);
        syncEdgeHitState(thread);
      });

      const selectedNode = root.querySelector('.gp-home-map-node-link.is-selected');
      if (selectedNode?.classList.contains('is-filtered-out')) closeSelected();
      const focusedNode = root.querySelector('.gp-home-map-node-link.is-adj.is-filtered-out');
      if (focusedNode) clearFocus();

      // Counts stay stable for the type toggles while still respecting narrowed
      // theme filters. This avoids layout jump when isolating a node type.
      legendItems.forEach((item) => {
        const type = clean(item.dataset.legendType);
        if (!type) return;
        item.hidden = false;
        const selected = activeTypeFilter === type;
        const label = item.querySelector('.gp-home-map-legend-label')?.textContent?.trim() || type;
        const countValue = legendCounts[type] ?? 0;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
        item.setAttribute(
          'aria-label',
          selected
            ? `Show all map nodes; ${label} currently isolated; ${countValue} match current filters`
            : `Show only ${label}; ${countValue} match current filters`
        );
        const count = legendCountByType.get(type);
        if (count) count.textContent = String(countValue);
      });
      // Filter affordance: a toggle shows a dot while its filter set is
      // narrowed, so closed panels still signal that the map view is filtered.
      filterToggleButtons.forEach((button) => {
        const narrowed = allThemeCount > 0 && activeThemes.size < allThemeCount;
        button.classList.toggle('is-filtering', narrowed);
      });

      applyNodeDensityScale();
      const activeFocusTarget = selectedFocusTarget ?? pointerFocusTarget;
      if (activeFocusTarget && !activeFocusTarget.classList.contains('is-filtered-out')) {
        setFocus(activeFocusTarget);
      }
      const selectedId = selectedNode?.getAttribute('data-node-id') || '';
      if (selectedId) {
        markSelectedThreads(selectedId);
        renderSelectedEdgeList(selectedId);
      }
      clusterDirty();
      renderNodeList();
    };

    filterToggleButtons.forEach((button) => {
      button.addEventListener('click', () => setFilterPanel(button.dataset.filterToggle || ''));
    });

    legendItems.forEach((button) => {
      button.addEventListener('click', () => {
        const type = filterTypeFor(button.dataset.legendType);
        activeTypeFilter = activeTypeFilter === type ? '' : type;
        applyMapFilters();
      });
    });

    themeFilterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const theme = clean(button.dataset.themeFilter);
        if (!theme) return;
        if (activeThemes.has(theme)) activeThemes.delete(theme);
        else activeThemes.add(theme);
        button.setAttribute('aria-pressed', activeThemes.has(theme) ? 'true' : 'false');
        applyMapFilters();
      });
    });

    // Fire-and-forget. The public response is intentionally neutral, so the UI
    // shows the same copy whether or not the email/node match — and even if the
    // network request fails — to avoid leaking ownership signal.
    const requestEditLink = (sourceId: string, email: string) => {
      if (!sourceId) return;
      void fetch(`${agentBaseUrl}/map-nodes/${encodeURIComponent(sourceId)}/edit-link`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      }).catch(() => {});
    };

    updateTrigger?.addEventListener('click', () => {
      if (!updateForm) return;
      updateTrigger.hidden = true;
      updateForm.hidden = false;
      if (updateError) updateError.textContent = '';
      updateEmail?.focus();
      window.requestAnimationFrame(syncSelectedOverlay);
    });

    updateCancel?.addEventListener('click', () => {
      if (updateForm) updateForm.hidden = true;
      if (updateError) updateError.textContent = '';
      if (updateEmail) updateEmail.value = '';
      if (updateTrigger) updateTrigger.hidden = false;
      window.requestAnimationFrame(syncSelectedOverlay);
    });

    updateForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const email = clean(updateEmail?.value).toLowerCase();
      if (updateEmail) updateEmail.value = email;
      if (!email || !updateEmail?.checkValidity()) {
        if (updateError) updateError.textContent = 'Enter a valid email address.';
        return;
      }

      const sourceId = activeSourceId;
      // Terminal, neutral UI first; clear the input so no email lingers in the DOM.
      updateForm.hidden = true;
      if (updateEmail) updateEmail.value = '';
      if (updateTrigger) updateTrigger.hidden = true;
      if (updateError) updateError.textContent = '';
      if (updateSuccess) updateSuccess.hidden = false;
      window.requestAnimationFrame(syncSelectedOverlay);

      requestEditLink(sourceId, email);
    });

    selectedClose?.addEventListener('click', closeSelected);
    root.addEventListener('click', (event) => {
      if (!selectedEl || selectedEl.hidden) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.gp-home-map-node-link, .gp-home-map-selected, .gp-home-map-controls, .gp-home-map-legend, .gp-home-map-edge-tooltip, .gp-home-map-list-drawer')) return;
      if (isTouchMap() && isRecentTouchMapClick() && nodeAtPointer(event as MouseEvent, 44)) return;
      closeSelected();
    });
    // Escape closes the selected-node card/bar from anywhere (keyboard + a11y).
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && selectedEl && !selectedEl.hidden) {
        closeSelected();
      }
    });

    // ---- Public person node injection --------------------------------------
    const injectedKeys = new Set<string>();
    const memberByKey = new Map<string, DynamicMapNode>();
    let lastDynamicThreadSignature = '';

    const makeCircle = (cls: string, cx: number, cy: number, r: number) => {
      const circle = document.createElementNS(SVG_NS, 'circle');
      circle.setAttribute('class', cls);
      circle.setAttribute('cx', cx.toFixed(2));
      circle.setAttribute('cy', cy.toFixed(2));
      circle.setAttribute('r', String(r));
      circle.setAttribute('data-base-r', String(r));
      applyScope(circle);
      return circle;
    };

    const memberFromRenderedNode = (link: Element, memberKey: string): DynamicMapNode | null => {
      const rawType = filterTypeFor(link.getAttribute('data-node-type'));
      if (rawType === 'chapter') return null;
      const center = nodeCenter(link);
      const pending = link.classList.contains('is-pending') || memberKey.startsWith('local:');
      const approved = memberKey.startsWith('submission:') && !pending;
      const sourceId = clean(memberKey).replace(/^submission:/, '').replace(/^local:/, '');
      const member = {
        key: memberKey,
        sourceId: approved ? sourceId : '',
        type: rawType === 'steward' ? 'steward' : 'member',
        name: clean((link as HTMLElement).dataset.nodeName) || clean(link.querySelector('title')?.textContent).split('·')[0].trim(),
        place: clean((link as HTMLElement).dataset.nodePlace),
        chapterSlug: clean((link as HTMLElement).dataset.nodeChapterSlug),
        bioregion: publicBioregion((link as HTMLElement).dataset.nodeBioregion),
        bioregionId: publicBioregionId((link as HTMLElement).dataset.nodeBioregionId),
        bioregionSource: publicBioregionSource((link as HTMLElement).dataset.nodeBioregionSource),
        publicNote: clean((link as HTMLElement).dataset.nodePublicNote),
        profileUrl: cleanHref((link as HTMLElement).dataset.nodeProfileUrl),
        themes: nodeThemes(link),
        lat: center ? 90 - (center.y / VIEW_H) * 180 : 0,
        long: center ? (center.x / VIEW_W) * 360 - 180 : 0,
        approved,
        pending,
      };
      return {
        ...member,
        owned: link.classList.contains('is-owned') || isOwnedNode({ ...member, id: memberKey }, memberKey),
      };
    };

    const openMemberNode = (link: Element, memberKey: string, viaKeyboard = false) => {
      const member = memberByKey.get(memberKey) ?? memberFromRenderedNode(link, memberKey);
      if (member) {
        memberByKey.set(member.key, member);
        openSelected(member, link, viaKeyboard);
      }
    };

    const visibleMapNodes = () => (
      Array.from(root.querySelectorAll('.gp-home-map-node-link:not(.is-filtered-out)')) as HTMLElement[]
    );

    const activateMapNode = (node: Element, viaKeyboard = false) => {
      const memberKey = (node as HTMLElement).dataset.memberKey;
      if (memberKey) {
        openMemberNode(node, memberKey, viaKeyboard);
        return;
      }
      if (node.classList.contains('is-chapter')) {
        openChapterNode(node, viaKeyboard);
        return;
      }
      setFocus(node);
    };

    const activateListNode = (node: HTMLElement) => {
      activateMapNode(node, true);
      if (isTouchMap()) closeNodeList({ restoreFocus: true });
    };

    const openNodeList = () => {
      if (!listDrawer || !listToggle) return;
      closeFilterPanels();
      listToggle.setAttribute('aria-expanded', 'true');
      root.classList.add('has-list-drawer');
      listDrawer.hidden = false;
      listDrawer.setAttribute('aria-modal', isTouchMap() ? 'true' : 'false');
      renderNodeList();
      if (isTouchMap() && typeof listDrawer.showModal === 'function' && !listDrawer.open) {
        listDrawer.showModal();
      } else if (!listDrawer.open) {
        listDrawer.setAttribute('open', '');
      }
      window.requestAnimationFrame(() => {
        const first = listDrawer.querySelector('button') as HTMLButtonElement | null;
        first?.focus({ preventScroll: true });
      });
    };

    const syncNodeListClosed = () => {
      if (!listDrawer || !listToggle) return;
      listDrawer.hidden = true;
      listDrawer.setAttribute('aria-modal', 'false');
      listToggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('has-list-drawer');
    };

    let restoreListFocusOnClose = false;
    closeNodeList = ({ restoreFocus = false }: { restoreFocus?: boolean } = {}) => {
      if (!listDrawer || !listToggle) return;
      restoreListFocusOnClose = restoreListFocusOnClose || restoreFocus;
      if (listDrawer.open && typeof listDrawer.close === 'function') {
        listDrawer.close();
      } else {
        listDrawer.removeAttribute('open');
        syncNodeListClosed();
        if (restoreListFocusOnClose) listToggle.focus({ preventScroll: true });
        restoreListFocusOnClose = false;
      }
    };

    renderNodeList = () => {
      if (!listItems || !listCount) return;
      const nodes = visibleMapNodes();
      listCount.textContent = String(nodes.length);
      if (listDrawer?.hidden) return;
      listItems.textContent = '';
      if (!nodes.length) {
        const empty = document.createElement('p');
        applyScope(empty);
        empty.className = 'gp-home-map-list-empty';
        empty.textContent = 'No visible nodes match these filters.';
        listItems.append(empty);
        return;
      }

      nodes.forEach((node) => {
        const row = document.createElement('button');
        applyScope(row);
        row.type = 'button';
        row.className = 'gp-home-map-list-row';
        const type = filterTypeFor(node.dataset.nodeType);
        row.dataset.nodeType = type;
        row.setAttribute('aria-label', `Select ${node.dataset.nodeName || 'map node'} on the map`);

        const mark = document.createElement('span');
        applyScope(mark);
        mark.className = `gp-home-map-list-mark is-${type}`;
        mark.setAttribute('aria-hidden', 'true');

        const copy = document.createElement('span');
        applyScope(copy);
        copy.className = 'gp-home-map-list-copy';

        const heading = document.createElement('span');
        applyScope(heading);
        heading.className = 'gp-home-map-list-name';
        heading.textContent = clean(node.dataset.nodeName) || 'Map node';

        const meta = document.createElement('span');
        applyScope(meta);
        meta.className = 'gp-home-map-list-meta';
        const place = clean(node.dataset.nodePlace);
        meta.textContent = `${endpointRoleLabel(type)}${place ? ` · ${place}` : ''}`;

        const themes = document.createElement('span');
        applyScope(themes);
        themes.className = 'gp-home-map-list-themes';
        const themeSlugs = nodeThemes(node);
        const visibleThemeSlugs = themeSlugs.slice(0, 2);
        visibleThemeSlugs.forEach((slug) => {
          const chip = document.createElement('span');
          applyScope(chip);
          const label = themeLabel(slug);
          chip.textContent = themeCompactLabel(slug);
          chip.title = label;
          chip.setAttribute('aria-label', label);
          chip.style.setProperty('--chip-color', themeColor(slug));
          themes.append(chip);
        });
        const hiddenThemeCount = themeSlugs.length - visibleThemeSlugs.length;
        if (hiddenThemeCount > 0) {
          const more = document.createElement('span');
          applyScope(more);
          more.className = 'is-more';
          more.textContent = `+${hiddenThemeCount}`;
          more.setAttribute('aria-label', `${hiddenThemeCount} more ${hiddenThemeCount === 1 ? 'theme' : 'themes'}`);
          themes.append(more);
        }

        copy.append(heading, meta, themes);

        row.append(mark, copy);
        row.addEventListener('click', () => activateListNode(node));
        listItems.append(row);
      });
    };

    listToggle?.addEventListener('click', () => {
      if (!listDrawer) return;
      if (listDrawer.hidden) openNodeList();
      else closeNodeList();
    });
    listClose?.addEventListener('click', () => closeNodeList({ restoreFocus: true }));
    listDrawer?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeNodeList({ restoreFocus: true });
    });
    listDrawer?.addEventListener('close', () => {
      syncNodeListClosed();
      if (restoreListFocusOnClose) listToggle?.focus({ preventScroll: true });
      restoreListFocusOnClose = false;
    });
    listDrawer?.addEventListener('click', (event) => {
      if (event.target === listDrawer) closeNodeList({ restoreFocus: true });
    });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (openFilterPanel && !target.closest('.gp-home-map-controls')) {
        closeFilterPanels();
      }
      if (listDrawer && !listDrawer.hidden && !target.closest('.gp-home-map-list-drawer, [data-home-map-list-toggle]')) {
        closeNodeList({ restoreFocus: true });
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeFilterPanels();
      if (listDrawer && !listDrawer.hidden) closeNodeList({ restoreFocus: true });
    });

    const registerNode = (link: Element) => {
      const previewFocus = () => {
        if (!selectedFocusTarget || selectedFocusTarget === link) setFocus(link);
      };
      link.addEventListener('mouseenter', previewFocus);
      link.addEventListener('focus', previewFocus);
      link.addEventListener('mouseleave', clearFocus);
      link.addEventListener('blur', clearFocus);
      const memberKey = (link as HTMLElement).dataset.memberKey;
      if (!memberKey) {
        if (link.classList.contains('is-chapter')) {
          // Intercept chapter activation (mouse + keyboard) to open the inspect
          // card instead of navigating. Enter on an <a> arrives as a synthetic
          // click, so the click handler covers it; Space needs its own guard.
          link.addEventListener('click', (event) => {
            if (suppressNextNodeClick) {
              suppressNextNodeClick = false;
              event.preventDefault();
              return;
            }
            event.preventDefault();
            openChapterNode(link, (link as HTMLElement).matches(':focus-visible'));
          });
          link.addEventListener('keydown', (event) => {
            if ((event as KeyboardEvent).key === ' ') {
              event.preventDefault();
              openChapterNode(link, true);
            }
          });
          return;
        }
        // Other static nodes (no href) just highlight themselves + their threads.
        if (!link.hasAttribute('href')) {
          const activate = () => setFocus(link);
          link.addEventListener('click', (event) => {
            if (suppressNextNodeClick) {
              suppressNextNodeClick = false;
              event.preventDefault();
              return;
            }
            activate();
          });
          link.addEventListener('keydown', (event) => {
            const key = (event as KeyboardEvent).key;
            if (key === 'Enter' || key === ' ') {
              event.preventDefault();
              activate();
            }
          });
        }
        return;
      }
    };

    root.addEventListener('click', (event) => {
      const eventTarget = event.target instanceof Element ? event.target : null;
      const target = event.target instanceof Element
        ? event.target.closest('.gp-home-map-node-link')
        : null;
      if (suppressNextNodeClick) {
        suppressNextNodeClick = false;
        event.preventDefault();
        return;
      }
      if (!target || !root.contains(target)) {
        if (!isTouchMap() || !isRecentTouchMapClick() || !eventTarget || !root.contains(eventTarget) || isGestureBlocked(eventTarget)) return;
        const nearestNode = nodeAtPointer(event as MouseEvent, 44);
        if (!nearestNode) return;
        event.preventDefault();
        activateMapNode(nearestNode);
        return;
      }
      const memberKey = (target as HTMLElement).dataset.memberKey;
      if (!memberKey) return;
      openMemberNode(target, memberKey);
    });

    root.addEventListener('keydown', (event) => {
      const key = event.key;
      if (key !== 'Enter' && key !== ' ') return;
      const target = event.target instanceof Element
        ? event.target.closest('.gp-home-map-node-link')
        : null;
      if (!target || !root.contains(target)) return;
      const memberKey = (target as HTMLElement).dataset.memberKey;
      if (!memberKey) return;
      event.preventDefault();
      openMemberNode(target, memberKey, true);
    });

    const injectMember = (member: DynamicMapNode) => {
      if (!membersGroup) return;
      const x = lonToX(member.long);
      const y = latToY(member.lat);
      if (injectedKeys.has(member.key)) {
        const existing = membersGroup.querySelector(`[data-node-id="${CSS.escape(member.key)}"]`) as SVGGElement | null;
        const current = memberByKey.get(member.key);
        const next = { ...current, ...member, owned: Boolean(current?.owned || member.owned) } as DynamicMapNode;
        memberByKey.set(member.key, next);
        if (existing && next.owned) {
          existing.classList.add('is-owned');
          existing.setAttribute('aria-label', `${next.name}, your ${next.pending ? `Pending ${next.type} node` : `${next.type} node`}${next.place ? `, ${next.place}` : ''}`);
          const title = existing.querySelector('title');
          if (title) title.textContent = `${next.name} · Your node${next.place ? ` · ${next.place}` : ''}`;
          if (!existing.querySelector('.gp-home-map-node-owner-ring')) {
            const halo = existing.querySelector('.gp-home-map-node-halo');
            existing.insertBefore(
              makeCircle('gp-home-map-node-owner-ring', x, y, next.type === 'steward' ? 3.5 : 3.35),
              halo
            );
          }
        }
        return;
      }
      injectedKeys.add(member.key);
      memberByKey.set(member.key, member);

      const group = document.createElementNS(SVG_NS, 'g');
      applyScope(group);
      group.setAttribute(
        'class',
        `gp-home-map-node-link is-${member.type}${member.pending ? ' is-pending' : ''}${member.owned ? ' is-owned' : ''}`
      );
      group.setAttribute('tabindex', '0');
      group.setAttribute('role', 'button');
      group.setAttribute('data-node-id', member.key);
      group.setAttribute('data-node-type', member.type);
      group.setAttribute('data-node-name', member.name);
      group.setAttribute(
        'data-node-role',
        member.pending ? `Pending ${member.type}` : member.type.charAt(0).toUpperCase() + member.type.slice(1)
      );
      group.setAttribute('data-node-place', member.place);
      if (member.chapterSlug) group.setAttribute('data-node-chapter-slug', member.chapterSlug);
      if (member.profileUrl) group.setAttribute('data-node-profile-url', member.profileUrl);
      group.setAttribute('data-node-bioregion', publicBioregion(member.bioregion));
      group.setAttribute('data-node-bioregion-id', publicBioregionId(member.bioregionId));
      group.setAttribute('data-node-bioregion-source', publicBioregionSource(member.bioregionSource));
      group.setAttribute('data-node-public-note', member.publicNote);
      group.setAttribute('data-node-themes', member.themes.join(' '));
      group.dataset.memberKey = member.key;
      const roleWord = member.pending ? `Pending ${member.type} node` : `${member.type} node`;
      group.setAttribute('aria-label', `${member.name}, ${member.owned ? 'your ' : ''}${roleWord}${member.place ? `, ${member.place}` : ''}`);

      const title = document.createElementNS(SVG_NS, 'title');
      const titleType = member.type.charAt(0).toUpperCase() + member.type.slice(1);
      title.textContent = `${member.name} · ${member.owned ? 'Your node' : titleType}${member.place ? ` · ${member.place}` : ''}`;
      group.append(title);
      const size = member.type === 'steward' ? 1.28 : 1.08;
      group.append(makeCircle('gp-home-map-node-hit', x, y, NODE_HIT_RADIUS));
      if (member.owned) group.append(makeCircle('gp-home-map-node-owner-ring', x, y, member.type === 'steward' ? 3.5 : 3.35));
      group.append(makeCircle('gp-home-map-node-halo', x, y, member.type === 'steward' ? 2.45 : 2.6));
      group.append(makeCircle('gp-home-map-node-ring', x, y, member.type === 'steward' ? 1.52 : 1.48));
      group.append(makeCircle('gp-home-map-node-dot', x, y, size));

      membersGroup.append(group);
      registerNode(group);
      applyMapFilters();
    };

    // Reconciliation: once a locally-stored pending node resurfaces as an
    // approved public node, remove the optimistic copy so the map never shows a
    // duplicate. Closes the selected card/bar if it was open on the removed node.
    const removeInjectedMember = (key: string) => {
      if (!injectedKeys.has(key)) return;
      injectedKeys.delete(key);
      memberByKey.delete(key);
      const node = membersGroup?.querySelector(`[data-node-id="${CSS.escape(key)}"]`);
      if (node) {
        if (node.classList.contains('is-selected')) closeSelected();
        node.remove();
      }
      applyMapFilters();
    };

    // ---- Exact-overlap fan-out ----------------------------------------------
    // Broad proximity clusters hide too much of the live-call map. Only people
    // sharing the exact same projected coordinate collapse into a stack affordance;
    // separate nearby pins remain available for zoom/pan exploration.
    const clustersGroup = root.querySelector('[data-home-map-clusters]') as SVGGElement | null;

    const OVERLAP_FAN_RADIUS_PX = 34; // fan-out satellite ring radius (screen px)

    type ClusterMember = { el: Element; key: string; center: { x: number; y: number } };
    let activeFan: ClusterMember[] | null = null;
    let clusterRecomputeTimer = 0;

    const reducedMotionPref = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pxToViewBox = (px: number) => px / clientScaleForBox(currentViewBox);
    const overlapKeyFor = (point: { x: number; y: number }) => `${point.x.toFixed(2)}:${point.y.toFixed(2)}`;

    const visiblePeoplePins = (): ClusterMember[] => {
      if (!membersGroup) return [];
      const out: ClusterMember[] = [];
      membersGroup.querySelectorAll('.gp-home-map-node-link:not(.is-filtered-out)').forEach((el) => {
        const center = nodeCenter(el);
        const key = el.getAttribute('data-node-id') || '';
        if (center && key) out.push({ el, key, center });
      });
      return out;
    };

    // Group only exact projected overlaps; no broad distance clustering.
    const groupPins = (pins: ClusterMember[]): ClusterMember[][] => {
      const byCoordinate = new Map<string, ClusterMember[]>();
      pins.forEach((pin) => {
        const key = overlapKeyFor(pin.center);
        byCoordinate.set(key, [...(byCoordinate.get(key) ?? []), pin]);
      });
      return Array.from(byCoordinate.values());
    };

    const centroidOf = (members: ClusterMember[]) => ({
      x: members.reduce((s, m) => s + m.center.x, 0) / members.length,
      y: members.reduce((s, m) => s + m.center.y, 0) / members.length,
    });

    const clusterPlaceLabel = (members: ClusterMember[]) => {
      const counts = new Map<string, number>();
      members.forEach((m) => {
        const place = clean(m.el.getAttribute('data-node-place'));
        if (place) counts.set(place, (counts.get(place) ?? 0) + 1);
      });
      let best = '';
      let bestN = 0;
      counts.forEach((n, place) => {
        if (n > bestN) {
          bestN = n;
          best = place;
        }
      });
      return best;
    };

    const setPinClustered = (el: Element, clustered: boolean) => {
      const shouldCluster = clustered && el !== selectedFocusTarget;
      el.classList.toggle('is-clustered', shouldCluster);
      el.setAttribute('tabindex', shouldCluster ? '-1' : '0');
      if (shouldCluster) el.setAttribute('aria-hidden', 'true');
      else el.removeAttribute('aria-hidden');
    };

    const clearClusters = () => {
      clustersGroup?.replaceChildren();
      membersGroup?.querySelectorAll('.is-clustered').forEach((el) => setPinClustered(el, false));
    };

    const collapseFan = () => {
      if (!activeFan) return;
      activeFan = null;
      root.classList.remove('is-cluster-fanning');
    };

    const fanOutCluster = (members: ClusterMember[], center: { x: number; y: number }, viaKeyboard: boolean) => {
      if (!clustersGroup) return;
      clustersGroup.replaceChildren();
      activeFan = members;
      root.classList.add('is-cluster-fanning');
      const radius = Math.max(pxToViewBox(OVERLAP_FAN_RADIUS_PX), 2.4);
      const animate = !reducedMotionPref();
      members.forEach((m, i) => {
        const angle = (i / members.length) * Math.PI * 2 - Math.PI / 2;
        const sx = center.x + Math.cos(angle) * radius;
        const sy = center.y + Math.sin(angle) * radius;
        const leader = document.createElementNS(SVG_NS, 'line');
        leader.setAttribute('class', 'gp-home-map-cluster-leader');
        leader.setAttribute('x1', center.x.toFixed(2));
        leader.setAttribute('y1', center.y.toFixed(2));
        leader.setAttribute('x2', sx.toFixed(2));
        leader.setAttribute('y2', sy.toFixed(2));
        applyScope(leader);
        clustersGroup.append(leader);
        const sat = document.createElementNS(SVG_NS, 'g');
        applyScope(sat);
        const isOwned = m.el.classList.contains('is-owned');
        sat.setAttribute('class', `gp-home-map-cluster-sat is-${m.el.getAttribute('data-node-type') || 'member'}${isOwned ? ' is-owned' : ''}${animate ? ' is-appearing' : ''}`);
        sat.setAttribute('role', 'button');
        sat.setAttribute('tabindex', '0');
        const name = m.el.getAttribute('data-node-name') || 'Map node';
        sat.setAttribute('aria-label', `${name}. ${isOwned ? 'Your node. ' : ''}Open node.`);
        const title = document.createElementNS(SVG_NS, 'title');
        title.textContent = isOwned ? `${name} · Your node` : name;
        sat.append(title);
        sat.append(makeCircle('gp-home-map-cluster-sat-hit', sx, sy, NODE_HIT_RADIUS));
        if (isOwned) sat.append(makeCircle('gp-home-map-cluster-sat-owner-ring', sx, sy, 3.2));
        sat.append(makeCircle('gp-home-map-cluster-sat-dot', sx, sy, 1.3));
        const pick = (vk: boolean) => {
          collapseFan();
          openMemberNode(m.el, m.key, vk);
        };
        sat.addEventListener('click', () => pick(sat.matches(':focus-visible')));
        sat.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            pick(true);
          }
        });
        clustersGroup.append(sat);
      });
      if (viaKeyboard) (clustersGroup.querySelector('.gp-home-map-cluster-sat') as SVGGElement | null)?.focus?.();
    };

    const expandCluster = (members: ClusterMember[], center: { x: number; y: number }, viaKeyboard: boolean) => {
      fanOutCluster(members, center, viaKeyboard);
    };

    const renderOverlapStack = (members: ClusterMember[]) => {
      if (!clustersGroup) return;
      const center = centroidOf(members);
      const place = clusterPlaceLabel(members);
      const selectedInStack = members.some((member) => member.el === selectedFocusTarget);
      const markerOffset = Math.max(pxToViewBox(10), 2);
      const markerCenter = selectedInStack
        ? { x: center.x + markerOffset, y: center.y - markerOffset }
        : center;
      const group = document.createElementNS(SVG_NS, 'g');
      applyScope(group);
      const ownedInStack = members.some((member) => member.el.classList.contains('is-owned'));
      group.setAttribute('class', `gp-home-map-overlap-stack${ownedInStack ? ' is-owned' : ''}${reducedMotionPref() ? '' : ' is-appearing'}`);
      group.setAttribute('role', 'button');
      group.setAttribute('tabindex', '0');
      group.setAttribute('data-home-map-cluster', '');
      group.setAttribute('aria-label', `${ownedInStack ? 'Your node is in this stack. ' : ''}People${place ? ` near ${place}` : ' at this location'}. Activate to fan out.`);
      const offset = Math.max(pxToViewBox(3), 0.8);
      group.append(makeCircle('gp-home-map-overlap-hit', markerCenter.x, markerCenter.y, NODE_HIT_RADIUS));
      group.append(makeCircle('gp-home-map-overlap-halo', markerCenter.x, markerCenter.y, 3.5));
      if (ownedInStack) group.append(makeCircle('gp-home-map-overlap-owner-ring', markerCenter.x, markerCenter.y, 4.25));
      group.append(makeCircle('gp-home-map-overlap-dot is-a', markerCenter.x - offset * 0.55, markerCenter.y + offset * 0.34, 1.05));
      group.append(makeCircle('gp-home-map-overlap-dot is-b', markerCenter.x + offset * 0.55, markerCenter.y + offset * 0.34, 1.05));
      group.append(makeCircle('gp-home-map-overlap-dot is-c', markerCenter.x, markerCenter.y - offset * 0.56, 1.05));
      const expand = (viaKeyboard: boolean) => expandCluster(members, markerCenter, viaKeyboard);
      group.addEventListener('click', () => expand(group.matches(':focus-visible')));
      group.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          expand(true);
        }
      });
      clustersGroup.append(group);
    };

    const recomputeClustersNow = () => {
      if (!clustersGroup || !membersGroup) return;
      collapseFan();
      clearClusters();
      groupPins(visiblePeoplePins()).forEach((group) => {
        if (group.length < 2) return;
        group.forEach((m) => setPinClustered(m.el, true));
        renderOverlapStack(group);
      });
    };

    const scheduleClusterRecompute = () => {
      window.clearTimeout(clusterRecomputeTimer);
      clusterRecomputeTimer = window.setTimeout(recomputeClustersNow, 90);
    };
    clusterDirty = scheduleClusterRecompute;

    // Clicking the map outside an open fan collapses it back to the stack marker.
    root.addEventListener('pointerdown', (event) => {
      if (!activeFan) return;
      if ((event.target as Element | null)?.closest('.gp-home-map-cluster-sat')) return;
      collapseFan();
      recomputeClustersNow();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (activeFan) {
        collapseFan();
        recomputeClustersNow();
        (clustersGroup?.querySelector('[data-home-map-cluster]') as SVGGElement | null)?.focus?.();
      }
    });

    const toMember = (
      raw: Record<string, any>,
      kind: 'approved-submission' | 'local-pending'
    ): DynamicMapNode | null => {
      const lat = toFiniteNumber(raw.lat ?? raw.latitude);
      const long = toFiniteNumber(raw.long ?? raw.longitude);
      if (lat === null || long === null) return null;
      const rawType = clean(raw.type || raw.nodeType || raw.role);
      const type = filterTypeFor(rawType);
      if (type === 'chapter') return null;
      const name = clean(raw.name || raw.displayName);
      if (!name) return null;
      const rawId = clean(raw.id) || `${lat},${long}`;
      const sourceId = clean(raw.sourceId || raw.id).replace(/^submission:/, '');
      const themes = normalizeThemeSlugs(raw.themes);
      const place = clean(raw.place || raw.placeName || raw.city);
      const approved = kind === 'approved-submission';
      const key = approved ? (rawId.startsWith('submission:') ? rawId : `submission:${sourceId}`) : `local:${clean(raw.id) || `${lat},${long}`}`;
      const member = {
        key,
        sourceId: approved ? sourceId : '',
        type,
        name,
        place,
        chapterSlug: clean(raw.chapterSlug || raw.chapter_slug),
        bioregion: publicBioregion(raw.bioregion),
        bioregionId: publicBioregionId(raw.bioregionId ?? raw.bioregion_id),
        bioregionSource: publicBioregionSource(raw.bioregionSource ?? raw.bioregion_source),
        publicNote: clean(raw.publicNote || raw.public_note),
        profileUrl: cleanHref(raw.profileUrl || raw.profile_url || raw.href),
        themes,
        lat,
        long,
        approved,
        pending: kind === 'local-pending',
      };
      return {
        ...member,
        key,
        owned: kind === 'local-pending' || isOwnedNode({ ...raw, name, lat, long, sourceId }, key),
      };
    };

    const renderDynamicThreads = (
      rawNodes: Array<Record<string, any>>,
      rawEdges: Array<Record<string, any>>
    ) => {
      if (!dynamicThreadsGroup) return;
      const existingThreads = new Map<string, SVGPathElement>();
      dynamicThreadsGroup.querySelectorAll<SVGPathElement>('.gp-home-map-thread').forEach((path) => {
        const id = clean(path.dataset.edgeId);
        if (id) existingThreads.set(id, path);
      });
      const existingHits = new Map<string, SVGPathElement>();
      dynamicThreadHitsGroup?.querySelectorAll<SVGPathElement>('.gp-home-map-thread-hit').forEach((path) => {
        const id = clean(path.dataset.edgeId);
        if (id) existingHits.set(id, path);
      });
      const nodeById = new Map<string, {
        x: number;
        y: number;
        type: 'chapter' | 'steward' | 'member';
        name: string;
      }>();
      root.querySelectorAll('.gp-home-map-node-link').forEach((node) => {
        const id = clean(node.getAttribute('data-node-id'));
        const dot = node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
        const x = toFiniteNumber(dot?.getAttribute('cx'));
        const y = toFiniteNumber(dot?.getAttribute('cy'));
        if (!id || x === null || y === null) return;
        nodeById.set(id, {
          x,
          y,
          type: filterTypeFor(node.getAttribute('data-node-type')),
          name: clean((node as HTMLElement).dataset.nodeName) || clean(node.querySelector('title')?.textContent).split('·')[0].trim() || id,
        });
      });
      rawNodes.forEach((node) => {
        const id = clean(node?.id);
        const lat = toFiniteNumber(node?.lat);
        const long = toFiniteNumber(node?.long);
        const type = filterTypeFor(node?.type);
        if (!id || lat === null || long === null) return;
        const existing = nodeById.get(id);
        nodeById.set(id, {
          x: existing?.x ?? lonToX(long),
          y: existing?.y ?? latToY(lat),
          type: existing?.type ?? type,
          name: existing?.name || clean(node?.name) || id,
        });
      });

      const nextThreadSpecs = rawEdges.map((edge, idx) => {
        const from = clean(edge?.from);
        const to = clean(edge?.to);
        const a = nodeById.get(from);
        const b = nodeById.get(to);
        if (!from || !to || !a || !b) return null;

        const theme = normalizeThemeSlug(edge?.theme);
        const color = themeColor(theme);
        const edgeId = clean(edge?.id) || `${from}:${to}:${theme}`;
        const d = buildMycelialPath(a, b, seedForEdge(edgeId));
        const growDelay = `${(idx % 12) * 0.12}s`;
        const kind = clean(edge?.kind) || 'related';
        const source = clean(edge?.source);
        const bioregion = publicBioregion(edge?.bioregion);
        const bioregionId = publicBioregionId(edge?.bioregionId ?? edge?.bioregion_id);
        const bioregionSource = publicBioregionSource(edge?.bioregionSource ?? edge?.bioregion_source);
        const weight = toFiniteNumber(edge?.weight) ?? 1;
        const meta: EdgeMeta = {
          edgeId,
          from: { id: from, name: a.name, type: a.type },
          to: { id: to, name: b.name, type: b.type },
          kind,
          theme,
          themeLabel: themeLabel(theme),
          themeColor: color,
          source,
          weight,
          bioregion,
          bioregionId,
          bioregionSource,
        };
        return { edgeId, from, to, theme, color, d, growDelay, kind, source, bioregion, bioregionId, bioregionSource, weight, meta };
      }).filter(Boolean) as Array<{
        edgeId: string;
        from: string;
        to: string;
        theme: string;
        color: string;
        d: string;
        growDelay: string;
        kind: string;
        source: string;
        bioregion: string;
        bioregionId: string;
        bioregionSource: string;
        weight: number;
        meta: EdgeMeta;
      }>;

      const signature = nextThreadSpecs.map((spec) => (
        `${spec.edgeId}|${spec.from}|${spec.to}|${spec.theme}|${spec.color}|${spec.d}|${spec.kind}|${spec.source}|${spec.bioregion}|${spec.bioregionId}|${spec.weight}`
      )).join('~');
      if (signature === lastDynamicThreadSignature) return;
      lastDynamicThreadSignature = signature;

      const nextThreadIds = new Set<string>();
      const setThreadAttribute = (path: SVGPathElement, name: string, value: string) => {
        if (path.getAttribute(name) !== value) path.setAttribute(name, value);
      };

      nextThreadSpecs.forEach((spec) => {
        nextThreadIds.add(spec.edgeId);
        edgeMetaById.set(spec.edgeId, spec.meta);
        const existingPath = existingThreads.get(spec.edgeId);
        const path = existingPath ?? document.createElementNS(SVG_NS, 'path');
        if (!existingPath) {
          applyScope(path);
          // While a node is selected, a freshly-arrived connection is held back
          // (rendered invisible) and revealed on deselect, so live polling never
          // flashes new lines across the focused view. Decision 8.
          const deferReveal = Boolean(selectedFocusTarget);
          path.setAttribute('class', deferReveal ? 'gp-home-map-thread is-pending-reveal' : 'gp-home-map-thread is-entering');
          path.setAttribute(
            'style',
            `--thread-color: ${spec.color}; --thread-grow-delay: ${spec.growDelay}; animation-delay: ${spec.growDelay};`
          );
          registerThread(path);
          dynamicThreadsGroup.append(path);
        }
        setThreadAttribute(path, 'data-edge-id', spec.edgeId);
        setThreadAttribute(path, 'data-from', spec.from);
        setThreadAttribute(path, 'data-to', spec.to);
        setThreadAttribute(path, 'data-theme', spec.theme);
        setThreadAttribute(path, 'data-kind', spec.kind);
        setThreadAttribute(path, 'data-source', spec.source);
        setThreadAttribute(path, 'data-bioregion-id', spec.bioregionId);
        setThreadAttribute(path, 'data-bioregion-source', spec.bioregionSource);
        setThreadAttribute(path, 'data-weight', String(spec.weight));
        setThreadAttribute(path, 'd', spec.d);
        setThreadAttribute(path, 'pathLength', '1');
        setThreadAttribute(path, 'stroke', spec.color);
        path.style.setProperty('--thread-color', spec.color);
        path.style.setProperty('--thread-grow-delay', spec.growDelay);

        if (dynamicThreadHitsGroup) {
          const existingHit = existingHits.get(spec.edgeId);
          const hit = existingHit ?? document.createElementNS(SVG_NS, 'path');
          if (!existingHit) {
            applyScope(hit);
            hit.setAttribute('class', 'gp-home-map-thread-hit');
            registerEdgeHit(hit);
            dynamicThreadHitsGroup.append(hit);
          }
          setThreadAttribute(hit, 'data-edge-id', spec.edgeId);
          setThreadAttribute(hit, 'data-from', spec.from);
          setThreadAttribute(hit, 'data-to', spec.to);
          setThreadAttribute(hit, 'data-theme', spec.theme);
          setThreadAttribute(hit, 'data-kind', spec.kind);
          setThreadAttribute(hit, 'data-bioregion-id', spec.bioregionId);
          setThreadAttribute(hit, 'data-bioregion-source', spec.bioregionSource);
          setThreadAttribute(hit, 'd', spec.d);
          setThreadAttribute(hit, 'pathLength', '1');
          hit.style.setProperty('--thread-color', spec.color);
          edgeHitById.set(spec.edgeId, hit);
          syncEdgeHitState(path);
        }
      });
      existingThreads.forEach((path, id) => {
        if (!nextThreadIds.has(id)) {
          edgeMetaById.delete(id);
          path.remove();
        }
      });
      existingHits.forEach((path, id) => {
        if (!nextThreadIds.has(id)) {
          edgeHitById.delete(id);
          path.remove();
        }
      });
      applyMapFilters();
    };

    const renderLocalPending = () => {
      loadLocalPendingNodes(window.localStorage).forEach((node) => {
        const member = toMember(node as Record<string, any>, 'local-pending');
        if (member) injectMember(member);
      });
    };

    // ---- Add-node intake mode copy -----------------------------------------
    const modeCopyEl = scope.querySelector('[data-home-map-mode-copy]') as HTMLElement | null;
    const setModeCopy = (mode: string) => {
      if (!modeCopyEl) return;
      modeCopyEl.textContent = mode === 'live'
        ? 'Live onboarding is on — your node appears on the public map right after you submit, and the map keeps refreshing as others join. Your email stays private and is used only for future edit links.'
        : 'In moderated mode, your node appears on your device while stewards review it. Your email stays private and is used only for future edit links.';
    };

    let intakeMode: 'moderated' | 'live' = 'moderated';

    // ---- /map/state fetch + live growth ------------------------------------
    // Fetched on load, again after every successful submit, and on a visible-page
    // watch so already-open browsers discover live mode without a refresh.
    const LIVE_POLL_INTERVAL_MS = 2000;
    const WATCH_POLL_INTERVAL_MS = 5000;
    // Abort a stalled /map/state fetch so a slow agent can't wedge the poll.
    const MAP_STATE_TIMEOUT_MS = 8000;
    let pollTimer: number | null = null;
    // Skip overlapping loads so requests never stack against the agent under
    // latency, and a late response can't clobber a newer one.
    let mapStateInFlight = false;
    let pollIntervalMs: number | null = null;
    let mapIsVisible = true;
    let mapVisibilityObserved = false;
    let replayAfterCurrentLoad = false;
    const renderMapMode = () => {
      if (!freshnessEl || !freshnessLabel) return;
      const isLive = intakeMode === 'live';
      freshnessEl.dataset.state = intakeMode;
      freshnessEl.hidden = !isLive;
      if (freshnessLabel.textContent !== 'Live') freshnessLabel.textContent = 'Live';
    };

    const stopPolling = () => {
      if (pollTimer !== null) {
        window.clearInterval(pollTimer);
        pollTimer = null;
      }
      pollIntervalMs = null;
    };

    const startPolling = (intervalMs = intakeMode === 'live' ? LIVE_POLL_INTERVAL_MS : WATCH_POLL_INTERVAL_MS) => {
      if (pollTimer !== null && pollIntervalMs === intervalMs) return;
      stopPolling();
      pollIntervalMs = intervalMs;
      pollTimer = window.setInterval(() => {
        if (document.visibilityState === 'visible') void loadMapState();
      }, intervalMs);
    };

    const replayVisibleMapReturn = () => {
      if (selectedFocusTarget) return;
      if (!mapIsVisible || document.visibilityState !== 'visible' || reducedMotionPref()) return;
      revealDefaultState();
    };

    const loadMapState = async (options: { replay?: boolean } = {}) => {
      if (mapStateInFlight) {
        if (options.replay) replayAfterCurrentLoad = true;
        return;
      }
      mapStateInFlight = true;
      const shouldReplay = Boolean(options.replay || replayAfterCurrentLoad);
      replayAfterCurrentLoad = false;
      let nextPollIntervalMs = WATCH_POLL_INTERVAL_MS;
      const controller = new AbortController();
      const abortTimer = window.setTimeout(() => controller.abort(), MAP_STATE_TIMEOUT_MS);
      try {
        const response = await fetch(`${agentBaseUrl}/map/state`, { cache: 'no-store', signal: controller.signal });
        if (!response.ok) {
          renderMapMode();
          return;
        }
        const state = await response.json();
        intakeMode = state?.intakeMode === 'live' ? 'live' : 'moderated';
        nextPollIntervalMs = intakeMode === 'live' ? LIVE_POLL_INTERVAL_MS : WATCH_POLL_INTERVAL_MS;
        setModeCopy(intakeMode);
        renderMapMode();

        const nodes = Array.isArray(state?.nodes) ? state.nodes : [];
        const approved = nodes.filter(
          (node: Record<string, any>) => node?.source === 'approved-submission'
        );
        const pendingSignatures = new Set(
          loadLocalPendingNodes(window.localStorage)
            .map((node) => localPendingNodeSignature(node as Record<string, any>))
            .filter(Boolean)
        );
        const approvedKeys = new Set<string>();
        approved.forEach((node: Record<string, any>) => {
          if (pendingSignatures.has(localPendingNodeSignature(node))) {
            rememberOwnedNode(node, clean(node.id || node.sourceId));
          }
          const member = toMember(node, 'approved-submission');
          if (member) {
            approvedKeys.add(member.key);
            injectMember(member);
          }
        });
        Array.from(memberByKey.values()).forEach((member) => {
          if (member.approved && !approvedKeys.has(member.key)) removeInjectedMember(member.key);
        });

        // Reconcile: drop optimistic local nodes that are now approved server-side
        // so an approved submission never renders twice on the same device.
        const { removed } = reconcileLocalPendingNodes(window.localStorage, approved);
        if (removed.length > 0) {
          removed.forEach((node) => removeInjectedMember(`local:${node.id}`));
          window.dispatchEvent(new Event(PENDING_NODE_UPDATED_EVENT));
        }

        renderDynamicThreads(
          nodes as Array<Record<string, any>>,
          Array.isArray(state?.edges) ? state.edges : []
        );
        const replayNow = shouldReplay || replayAfterCurrentLoad;
        replayAfterCurrentLoad = false;
        if (replayNow) replayVisibleMapReturn();

      } catch {
        // Agent unavailable, timed out, or aborted: keep the SSR baseline. No-op.
        renderMapMode();
      } finally {
        window.clearTimeout(abortTimer);
        mapStateInFlight = false;
        startPolling(nextPollIntervalMs);
      }
    };

    if ('IntersectionObserver' in window) {
      const mapVisibilityObserver = new IntersectionObserver((entries) => {
        const visible = entries.some((entry) => entry.isIntersecting && entry.intersectionRatio > 0.2);
        const wasVisible = mapIsVisible;
        mapIsVisible = visible;
        if (mapVisibilityObserved && visible && !wasVisible && document.visibilityState === 'visible') {
          void loadMapState({ replay: true });
        }
        mapVisibilityObserved = true;
      }, { threshold: [0, 0.2, 0.6] });
      mapVisibilityObserver.observe(root);
    }

    // Catch up immediately when a backgrounded tab returns to the foreground,
    // but replay the visible connection reveal only while the map is in view.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && mapIsVisible) void loadMapState({ replay: true });
    });

    // ---- Find-your-people walkthrough submission ----------------------------
    const addForm = scope.querySelector('[data-home-map-addnode-form]') as HTMLFormElement | null;
    const addStatus = scope.querySelector('[data-home-map-addnode-status]') as HTMLElement | null;
    const addDialog = scope.querySelector('[data-home-map-addnode-dialog]') as HTMLDialogElement | null;
    const addDialogTitle = scope.querySelector('[data-addnode-dialog-title]') as HTMLElement | null;
    const addTriggers = Array.from(document.querySelectorAll('[data-home-map-open]')) as HTMLButtonElement[];
    const addClose = scope.querySelector('[data-addnode-close]') as HTMLButtonElement | null;
    const stepEls = Array.from(scope.querySelectorAll('[data-walkthrough-step]')) as HTMLElement[];
    const progressEls = Array.from(scope.querySelectorAll('[data-walkthrough-progress]')) as HTMLElement[];
    const backButton = scope.querySelector('[data-walkthrough-back]') as HTMLButtonElement | null;
    const nextButton = scope.querySelector('[data-walkthrough-next]') as HTMLButtonElement | null;
    const submitButton = scope.querySelector('[data-walkthrough-submit]') as HTMLButtonElement | null;
    const themeChoiceButtons = Array.from(scope.querySelectorAll('[data-theme-choice]')) as HTMLButtonElement[];
    const themeCountEl = scope.querySelector('[data-home-map-theme-count]') as HTMLElement | null;
    const locationMap = scope.querySelector('[data-location-map]') as HTMLElement | null;
    const locationSvg = locationMap?.querySelector('svg') as SVGSVGElement | null;
    const locationPin = scope.querySelector('[data-location-pin]') as SVGCircleElement | null;
    const locationQuery = scope.querySelector('input[name="placeQuery"]') as HTMLInputElement | null;
    const locationDatalist = scope.querySelector('[data-location-datalist]') as HTMLDataListElement | null;
    const placeInput = scope.querySelector('[data-location-place]') as HTMLInputElement | null;
    const latInput = scope.querySelector('[data-location-lat]') as HTMLInputElement | null;
    const longInput = scope.querySelector('[data-location-long]') as HTMLInputElement | null;
    const locationStatus = scope.querySelector('[data-location-status]') as HTMLElement | null;
    const reviewName = scope.querySelector('[data-review-name]') as HTMLElement | null;
    const reviewPlace = scope.querySelector('[data-review-place]') as HTMLElement | null;
    const reviewThemes = scope.querySelector('[data-review-themes]') as HTMLElement | null;
    const reviewNote = scope.querySelector('[data-review-note]') as HTMLElement | null;
    const reviewEmail = scope.querySelector('[data-review-email]') as HTMLElement | null;
    const taglineCount = scope.querySelector('[data-tagline-count]') as HTMLElement | null;
    const editStepButtons = Array.from(scope.querySelectorAll('[data-edit-step]')) as HTMLButtonElement[];

    const MAX_THEME_COUNT = 4;
    const walkthroughSteps = ['themes', 'identity', 'review'];
    const selectedThemes = new Set<string>();
    let currentStep = 0;
    let lastAddTrigger: HTMLElement | null = null;
    let addDialogPageLocked = false;
    let addDialogScrollY = 0;
    const previousBodyScrollStyles = {
      position: '',
      insetInlineStart: '',
      top: '',
      width: '',
      overflowY: '',
      paddingInlineEnd: '',
    };

    const xToLon = (x: number) => (x / VIEW_W) * 360 - 180;
    const yToLat = (y: number) => 90 - (y / VIEW_H) * 180;
    const placeIndex = [
      ...Array.from(root.querySelectorAll('[data-node-type="chapter"]')).map((node) => {
        const dot = node.querySelector('.gp-home-map-node-dot') as SVGCircleElement | null;
        const x = Number(dot?.getAttribute('cx'));
        const y = Number(dot?.getAttribute('cy'));
        return {
          label: clean((node as HTMLElement).dataset.nodeName) || 'Greenpill chapter',
          lat: yToLat(y),
          long: xToLon(x),
        };
      }).filter((place) => Number.isFinite(place.lat) && Number.isFinite(place.long)),
      // A compact bundled spread of major world cities — enough to autocomplete and
      // auto-label most pins. Anywhere not listed still works: the pin gives the
      // coordinates and a free-typed name becomes the label.
      { label: 'Lagos', lat: 6.5244, long: 3.3792 },
      { label: 'Accra', lat: 5.6037, long: -0.187 },
      { label: 'Nairobi', lat: -1.2864, long: 36.8172 },
      { label: 'Cairo', lat: 30.0444, long: 31.2357 },
      { label: 'Cape Town', lat: -33.9249, long: 18.4241 },
      { label: 'Johannesburg', lat: -26.2041, long: 28.0473 },
      { label: 'Casablanca', lat: 33.5731, long: -7.5898 },
      { label: 'Addis Ababa', lat: 9.03, long: 38.74 },
      { label: 'Dar es Salaam', lat: -6.7924, long: 39.2083 },
      { label: 'Kinshasa', lat: -4.4419, long: 15.2663 },
      { label: 'London', lat: 51.5072, long: -0.1276 },
      { label: 'Berlin', lat: 52.52, long: 13.405 },
      { label: 'Paris', lat: 48.8566, long: 2.3522 },
      { label: 'Madrid', lat: 40.4168, long: -3.7038 },
      { label: 'Lisbon', lat: 38.7223, long: -9.1393 },
      { label: 'Amsterdam', lat: 52.3676, long: 4.9041 },
      { label: 'Rome', lat: 41.9028, long: 12.4964 },
      { label: 'Istanbul', lat: 41.0082, long: 28.9784 },
      { label: 'Warsaw', lat: 52.2297, long: 21.0122 },
      { label: 'Stockholm', lat: 59.3293, long: 18.0686 },
      { label: 'Kyiv', lat: 50.4501, long: 30.5234 },
      { label: 'Delhi', lat: 28.6139, long: 77.209 },
      { label: 'Mumbai', lat: 19.076, long: 72.8777 },
      { label: 'Bangalore', lat: 12.9716, long: 77.5946 },
      { label: 'Bangkok', lat: 13.7563, long: 100.5018 },
      { label: 'Singapore', lat: 1.3521, long: 103.8198 },
      { label: 'Jakarta', lat: -6.2088, long: 106.8456 },
      { label: 'Bali', lat: -8.3405, long: 115.092 },
      { label: 'Manila', lat: 14.5995, long: 120.9842 },
      { label: 'Seoul', lat: 37.5665, long: 126.978 },
      { label: 'Tokyo', lat: 35.6762, long: 139.6503 },
      { label: 'Shanghai', lat: 31.2304, long: 121.4737 },
      { label: 'Beijing', lat: 39.9042, long: 116.4074 },
      { label: 'Ho Chi Minh City', lat: 10.8231, long: 106.6297 },
      { label: 'Dhaka', lat: 23.8103, long: 90.4125 },
      { label: 'Karachi', lat: 24.8607, long: 67.0011 },
      { label: 'Dubai', lat: 25.2048, long: 55.2708 },
      { label: 'New York City', lat: 40.7128, long: -74.006 },
      { label: 'Toronto', lat: 43.6532, long: -79.3832 },
      { label: 'Vancouver', lat: 49.2827, long: -123.1207 },
      { label: 'Los Angeles', lat: 34.0522, long: -118.2437 },
      { label: 'Chicago', lat: 41.8781, long: -87.6298 },
      { label: 'Mexico City', lat: 19.4326, long: -99.1332 },
      { label: 'Bogota', lat: 4.711, long: -74.0721 },
      { label: 'Medellin', lat: 6.2442, long: -75.5812 },
      { label: 'Lima', lat: -12.0464, long: -77.0428 },
      { label: 'Santiago', lat: -33.4489, long: -70.6693 },
      { label: 'Buenos Aires', lat: -34.6037, long: -58.3816 },
      { label: 'Sao Paulo', lat: -23.5505, long: -46.6333 },
      { label: 'Rio de Janeiro', lat: -22.9068, long: -43.1729 },
      { label: 'Sydney', lat: -33.8688, long: 151.2093 },
      { label: 'Melbourne', lat: -37.8136, long: 144.9631 },
      { label: 'Auckland', lat: -36.8485, long: 174.7633 },
    ];

    const nearestPlace = (lat: number, long: number) => (
      placeIndex
        .map((place) => ({
          ...place,
          distance: Math.hypot(
            place.lat - lat,
            (place.long - long) * Math.cos(((place.lat + lat) / 2) * Math.PI / 180)
          ),
        }))
        .sort((a, b) => a.distance - b.distance)[0]
    );

    const setAddStatus = (message: string, tone: 'idle' | 'success' | 'error' = 'idle') => {
      if (!addStatus) return;
      addStatus.textContent = message;
      if (tone === 'idle') addStatus.removeAttribute('data-tone');
      else addStatus.dataset.tone = tone;
    };

    const createLocalId = () => (
      'randomUUID' in crypto
        ? `local-${crypto.randomUUID()}`
        : `local-${Date.now()}-${Math.round(Math.random() * 1e5)}`
    );

    const selectedThemeIds = () => Array.from(selectedThemes);

    const setLocation = (lat: number, long: number, label: string) => {
      if (!placeInput || !latInput || !longInput) return;
      placeInput.value = label;
      latInput.value = lat.toFixed(6);
      longInput.value = long.toFixed(6);
      if (locationStatus) locationStatus.textContent = `Pinning near ${label}`;
      if (locationPin) {
        locationPin.setAttribute('cx', lonToX(long).toFixed(2));
        locationPin.setAttribute('cy', latToY(lat).toFixed(2));
        locationPin.hidden = false;
      }
      syncWalkthroughState();
    };

    const syncReview = () => {
      if (!addForm) return;
      const data = new FormData(addForm);
      const name = clean(data.get('name')) || 'You';
      const place = clean(data.get('place'));
      const publicNote = clean(data.get('publicNote'));
      const privateEmail = clean(data.get('contact')).toLowerCase();
      if (reviewName) reviewName.textContent = name;
      if (reviewPlace) reviewPlace.textContent = `Member · ${place || '—'}`;
      if (reviewNote) reviewNote.textContent = publicNote || 'None yet';
      if (reviewEmail) reviewEmail.textContent = privateEmail || 'Saved privately for future edit links.';
      if (taglineCount) taglineCount.textContent = `${String(data.get('publicNote') ?? '').length} / 72`;
      if (reviewThemes) {
        reviewThemes.textContent = '';
        selectedThemeIds().forEach((slug) => {
          const chip = document.createElement('span');
          applyScope(chip);
          chip.textContent = themeLabel(slug);
          chip.style.setProperty('--chip-color', themeColor(slug));
          reviewThemes.append(chip);
        });
      }
    };

    function canAdvanceCurrentStep() {
      if (!addForm) return false;
      if (walkthroughSteps[currentStep] === 'themes') return selectedThemes.size > 0 && selectedThemes.size <= MAX_THEME_COUNT;
      if (walkthroughSteps[currentStep] !== 'identity') return true;
      const data = new FormData(addForm);
      const emailInput = addForm.elements.namedItem('contact') as HTMLInputElement | null;
      return Boolean(
        clean(data.get('name')) &&
        clean(data.get('publicNote')) &&
        clean(data.get('place')) &&
        toFiniteNumber(data.get('lat')) !== null &&
        toFiniteNumber(data.get('long')) !== null &&
        emailInput?.checkValidity()
      );
    }

    function syncWalkthroughState() {
      const activeStep = walkthroughSteps[currentStep];
      let activeStepTitle = '';
      stepEls.forEach((step) => {
        const active = step.dataset.walkthroughStep === activeStep;
        step.hidden = !active;
        step.classList.toggle('is-active', active);
        if (active) activeStepTitle = clean(step.querySelector('h2')?.textContent);
      });
      if (addDialogTitle) addDialogTitle.textContent = activeStepTitle || 'Find your people';
      progressEls.forEach((dot, index) => {
        dot.classList.toggle('is-active', index <= currentStep);
      });
      themeChoiceButtons.forEach((button) => {
        const theme = clean(button.dataset.themeChoice);
        const on = selectedThemes.has(theme);
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        button.disabled = !on && selectedThemes.size >= MAX_THEME_COUNT;
      });
      if (themeCountEl) {
        themeCountEl.textContent = selectedThemes.size === 0
          ? `Choose 1 to ${MAX_THEME_COUNT} themes to continue.`
          : selectedThemes.size >= MAX_THEME_COUNT
            ? `${selectedThemes.size} / ${MAX_THEME_COUNT} selected. Deselect one to choose another.`
            : `${selectedThemes.size} / ${MAX_THEME_COUNT} selected. Continue when you're ready.`;
      }
      if (backButton) backButton.hidden = currentStep === 0;
      if (nextButton) {
        nextButton.hidden = currentStep === walkthroughSteps.length - 1;
        nextButton.disabled = !canAdvanceCurrentStep();
        nextButton.textContent = currentStep === walkthroughSteps.length - 2 ? 'Review →' : 'Continue →';
      }
      if (submitButton) submitButton.hidden = currentStep !== walkthroughSteps.length - 1;
      syncReview();
    }

    const setWalkthroughStep = (stepName: string) => {
      const index = walkthroughSteps.indexOf(stepName);
      if (index < 0) return;
      currentStep = index;
      syncWalkthroughState();
      const firstField = stepEls[index]?.querySelector('button, input, textarea') as HTMLElement | null;
      firstField?.focus();
    };

    const resetWalkthrough = () => {
      addForm?.reset();
      selectedThemes.clear();
      currentStep = 0;
      if (placeInput) placeInput.value = '';
      if (latInput) latInput.value = '';
      if (longInput) longInput.value = '';
      if (locationPin) locationPin.hidden = true;
      if (locationStatus) locationStatus.textContent = 'Drop a pin on the map, then name your city — or pick one from the list.';
      setAddStatus('');
      syncWalkthroughState();
    };

    const lockAddDialogPageScroll = () => {
      if (addDialogPageLocked) return;
      addDialogPageLocked = true;
      addDialogScrollY = window.scrollY;
      const scrollbarGap = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
      previousBodyScrollStyles.position = document.body.style.position;
      previousBodyScrollStyles.insetInlineStart = document.body.style.insetInlineStart;
      previousBodyScrollStyles.top = document.body.style.top;
      previousBodyScrollStyles.width = document.body.style.width;
      previousBodyScrollStyles.overflowY = document.body.style.overflowY;
      previousBodyScrollStyles.paddingInlineEnd = document.body.style.paddingInlineEnd;
      document.documentElement.classList.add('gp-home-map-addnode-scroll-locked');
      document.body.style.position = 'fixed';
      document.body.style.insetInlineStart = '0';
      document.body.style.top = `-${addDialogScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflowY = 'hidden';
      if (scrollbarGap > 0) document.body.style.paddingInlineEnd = `${scrollbarGap}px`;
    };

    const unlockAddDialogPageScroll = () => {
      if (!addDialogPageLocked) return;
      addDialogPageLocked = false;
      document.documentElement.classList.remove('gp-home-map-addnode-scroll-locked');
      document.body.style.position = previousBodyScrollStyles.position;
      document.body.style.insetInlineStart = previousBodyScrollStyles.insetInlineStart;
      document.body.style.top = previousBodyScrollStyles.top;
      document.body.style.width = previousBodyScrollStyles.width;
      document.body.style.overflowY = previousBodyScrollStyles.overflowY;
      document.body.style.paddingInlineEnd = previousBodyScrollStyles.paddingInlineEnd;
      window.scrollTo(0, addDialogScrollY);
    };

    const openAddDialog = (trigger?: HTMLElement) => {
      if (!addDialog) return;
      closeFilterPanels();
      closeNodeList();
      lastAddTrigger = trigger ?? null;
      resetWalkthrough();
      lockAddDialogPageScroll();
      if (typeof addDialog.showModal === 'function') addDialog.showModal();
      else addDialog.setAttribute('open', '');
      window.requestAnimationFrame(() => {
        const firstField = addDialog.querySelector('[data-theme-choice]') as HTMLElement | null;
        firstField?.focus();
      });
    };

    const closeAddDialog = () => {
      if (!addDialog) return;
      if (addDialog.open && typeof addDialog.close === 'function') addDialog.close();
      else {
        addDialog.removeAttribute('open');
        unlockAddDialogPageScroll();
      }
    };

    addTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        openAddDialog(trigger);
      });
    });

    // Footer/global "add yourself" CTAs deep-link to /(hash)join-map and open
    // the same public-safe dialog. The hash is removed from the visible URL
    // right away so reloads and copied links do not re-trigger the dialog.
    const ADD_NODE_HASH = '#join-map';
    const openAddDialogFromHash = () => {
      if (window.location.hash !== ADD_NODE_HASH) return;
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
      openAddDialog();
    };
    window.addEventListener('hashchange', openAddDialogFromHash);
    openAddDialogFromHash();

    addClose?.addEventListener('click', closeAddDialog);

    // Standalone recovery entry — request a manage link by email alone. Mirrors
    // the per-node "Edit this node" form: validate, show the same neutral
    // confirmation immediately, clear the input, and fire-and-forget the request
    // so the UI never reflects whether the email matched a published node.
    const manageToggle = scope.querySelector('[data-manage-toggle]') as HTMLButtonElement | null;
    const manageForm = scope.querySelector('[data-manage-form]') as HTMLFormElement | null;
    const manageStatus = scope.querySelector('[data-manage-status]') as HTMLElement | null;
    const manageEmail = manageForm?.elements.namedItem('email') as HTMLInputElement | null;

    manageToggle?.addEventListener('click', () => {
      if (!manageForm) return;
      const willOpen = manageForm.hidden;
      manageForm.hidden = !willOpen;
      manageToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      if (willOpen) manageEmail?.focus();
    });

    manageForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const email = clean(manageEmail?.value).toLowerCase();
      if (manageEmail) manageEmail.value = email;
      if (!email || !manageEmail?.checkValidity()) {
        manageEmail?.reportValidity();
        return;
      }
      // Terminal, neutral confirmation first; clear the input so no email lingers.
      if (manageEmail) manageEmail.value = '';
      if (manageStatus) manageStatus.hidden = false;
      void fetch(`${agentBaseUrl}/map-nodes/edit-link-request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      }).catch(() => {});
    });

    addDialog?.addEventListener('close', () => {
      unlockAddDialogPageScroll();
      lastAddTrigger?.focus();
    });
    addDialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
    });
    addDialog?.addEventListener('click', (event) => {
      if (event.target === addDialog) {
        event.preventDefault();
        event.stopPropagation();
      }
    });

    themeChoiceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const theme = clean(button.dataset.themeChoice);
        if (!theme) return;
        if (selectedThemes.has(theme)) selectedThemes.delete(theme);
        else if (selectedThemes.size < MAX_THEME_COUNT) selectedThemes.add(theme);
        syncWalkthroughState();
      });
    });

    nextButton?.addEventListener('click', () => {
      if (!canAdvanceCurrentStep()) return;
      currentStep = Math.min(walkthroughSteps.length - 1, currentStep + 1);
      syncWalkthroughState();
    });
    backButton?.addEventListener('click', () => {
      currentStep = Math.max(0, currentStep - 1);
      syncWalkthroughState();
    });
    editStepButtons.forEach((button) => {
      button.addEventListener('click', () => setWalkthroughStep(button.dataset.editStep || ''));
    });

    addForm?.addEventListener('input', syncWalkthroughState);
    // Pin = coordinates. Drag or tap anywhere on the mini-map to place it; the
    // nearest bundled city auto-labels it, and a custom typed name takes
    // precedence so any place reads correctly.
    const cityIsKnown = (value: string) => {
      const lower = value.toLowerCase();
      return placeIndex.some((place) => place.label.toLowerCase() === lower);
    };
    const placeFromPointer = (event: PointerEvent) => {
      if (!locationSvg) return;
      const rect = locationSvg.getBoundingClientRect();
      const x = Math.min(VIEW_W, Math.max(0, ((event.clientX - rect.left) / rect.width) * VIEW_W));
      const y = Math.min(VIEW_H, Math.max(0, ((event.clientY - rect.top) / rect.height) * VIEW_H));
      const lat = yToLat(y);
      const long = xToLon(x);
      const typed = clean(locationQuery?.value);
      const label = typed.length >= 2 && !cityIsKnown(typed)
        ? typed
        : (nearestPlace(lat, long)?.label || 'your place');
      setLocation(lat, long, label);
    };
    let locationDragging = false;
    locationSvg?.addEventListener('pointerdown', (event) => {
      locationDragging = true;
      try { locationSvg?.setPointerCapture(event.pointerId); } catch {}
      placeFromPointer(event);
    });
    locationSvg?.addEventListener('pointermove', (event) => {
      if (locationDragging) placeFromPointer(event);
    });
    const endLocationDrag = (event: PointerEvent) => {
      if (!locationDragging) return;
      locationDragging = false;
      try { locationSvg?.releasePointerCapture(event.pointerId); } catch {}
    };
    locationSvg?.addEventListener('pointerup', endLocationDrag);
    locationSvg?.addEventListener('pointercancel', endLocationDrag);

    // Type to search the bundled list (a native datalist suggests matches). A
    // matched city jumps the pin; any other text becomes the label as long as a
    // pin supplies the coordinates — so a diverse set of places all work.
    locationQuery?.addEventListener('input', () => {
      const raw = clean(locationQuery.value);
      if (raw.length < 2) {
        if (locationStatus) locationStatus.textContent = 'Drop a pin on the map, or type your city.';
        return;
      }
      const query = raw.toLowerCase();
      const match = placeIndex.find((place) => place.label.toLowerCase() === query)
        || placeIndex.find((place) => place.label.toLowerCase().startsWith(query))
        || placeIndex.find((place) => place.label.toLowerCase().includes(query));
      if (match) {
        setLocation(match.lat, match.long, match.label);
        return;
      }
      const lat = toFiniteNumber(latInput?.value);
      const long = toFiniteNumber(longInput?.value);
      if (lat !== null && long !== null) {
        setLocation(lat, long, raw);
      } else {
        if (placeInput) placeInput.value = raw;
        if (locationStatus) locationStatus.textContent = `Drop a pin on the map to place “${raw}”.`;
        syncWalkthroughState();
      }
    });

    // Populate the city autocomplete from the bundled list (deduped).
    if (locationDatalist) {
      const seenCities = new Set<string>();
      placeIndex.forEach((place) => {
        const label = clean(place.label);
        if (!label || seenCities.has(label.toLowerCase())) return;
        seenCities.add(label.toLowerCase());
        const option = document.createElement('option');
        option.value = label;
        locationDatalist.append(option);
      });
    }

    addForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(addForm);
      const name = clean(data.get('name'));
      const place = clean(data.get('place'));
      const lat = toFiniteNumber(data.get('lat'));
      const long = toFiniteNumber(data.get('long'));
      const themes = selectedThemeIds();
      const publicNote = clean(data.get('publicNote'));
      const emailInput = addForm.elements.namedItem('contact') as HTMLInputElement | null;
      const email = clean(data.get('contact')).toLowerCase();
      if (emailInput) emailInput.value = email;

      if (!name || !publicNote || !place || lat === null || long === null || !emailInput?.checkValidity()) {
        setWalkthroughStep('identity');
        setAddStatus('Add a name, one-line tagline, place, and valid private email before submitting.', 'error');
        return;
      }
      if (themes.length < 1 || themes.length > MAX_THEME_COUNT) {
        setWalkthroughStep('themes');
        setAddStatus('Pick one to four themes before submitting.', 'error');
        return;
      }

      setAddStatus('Connecting threads...', 'idle');
      if (submitButton) submitButton.disabled = true;
      try {
        const response = await fetch(`${agentBaseUrl}/map-nodes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            displayName: name,
            placeName: place,
            lat,
            long,
            role: 'member',
            themes,
            publicNote,
            email,
            contactConsent: true,
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(payload?.error?.message || 'Submission failed.');
        }

        const node = payload?.node || payload;
        if (node?.status === 'approved') {
          const member = toMember({ ...node, sourceId: node.id }, 'approved-submission');
          if (member) {
            rememberOwnedNode({ ...node, name, lat, long, sourceId: node.id }, member.key);
            injectMember({ ...member, owned: true });
          }
          setAddStatus('Your node is approved and visible on the public map.', 'success');
        } else {
          saveLocalPendingNode(window.localStorage, {
            id: createLocalId(),
            name,
            place,
            lat,
            long,
            role: 'member',
            themes,
            publicNote,
          });
          window.dispatchEvent(new Event(PENDING_NODE_UPDATED_EVENT));
          renderLocalPending();
          setAddStatus('Saved on this device and submitted for steward review.', 'success');
        }
        void loadMapState();
        window.setTimeout(closeAddDialog, 700);
      } catch (error) {
        const message = error instanceof Error && error.name !== 'TypeError'
          ? error.message
          : 'We could not reach the network right now. Please try again.';
        setAddStatus(message, 'error');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    // ---- Init ---------------------------------------------------------------
    root.querySelectorAll('.gp-home-map-node-link').forEach(registerNode);
    root.querySelectorAll<SVGPathElement>('.gp-home-map-thread').forEach(registerThread);
    root.addEventListener('mouseleave', clearFocus);
    window.addEventListener(PENDING_NODE_UPDATED_EVENT, renderLocalPending);
    let mapResizeTimer = 0;
    const scheduleMapResizeSync = () => {
      window.clearTimeout(mapResizeTimer);
      mapResizeTimer = window.setTimeout(() => {
        setMapViewBox(currentViewBox);
        applyNodeDensityScale();
        const activeFocusTarget = selectedFocusTarget ?? pointerFocusTarget;
        if (activeFocusTarget && !activeFocusTarget.classList.contains('is-filtered-out')) {
          setFocus(activeFocusTarget);
        }
        syncSelectedOverlay();
        clusterDirty();
      }, 80);
    };
    if ('ResizeObserver' in window) {
      new ResizeObserver(scheduleMapResizeSync).observe(root);
    } else {
      window.addEventListener('resize', scheduleMapResizeSync);
    }

    applyMapFilters();
    renderLocalPending();
    loadMapState();
  })();
</script>

<style>
  .gp-home-map {
    --gp-map-chapter: var(--gp-primary);
    --gp-map-chapter-ring: var(--gp-green-950);
    --gp-map-member: var(--gp-green-100);
    --gp-map-member-ring: var(--gp-secondary);
    --gp-map-steward: var(--gp-secondary);
    /* Relationship lines are neutral chrome at rest — a quiet mint thread on the
       forest canvas. Theme hue (data) only appears on an actively selected node's
       web. The bright tone is the one-shot arrival/hover pass before settling. */
    --gp-map-thread: var(--gp-green-200);
    --gp-map-thread-bright: var(--gp-off-white);
    /* Shared on-map surface chrome (defined once, reused by the hover card,
       selected inspector, and inline controls). */
    --gp-map-pop-bg: color-mix(in srgb, var(--gp-green-950) 84%, transparent);
    --gp-map-pop-shadow: 0 18px 48px -18px rgba(0, 0, 0, 0.72);
    --gp-map-control-bg: rgba(7, 24, 15, 0.5);
    --gp-map-edge-fade: linear-gradient(to right, transparent 0, #000 6px, #000 calc(100% - 12px), transparent 100%);
    container-type: inline-size;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--gp-space-md);
  }

  :global(html.gp-home-map-addnode-scroll-locked) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .gp-home-map-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .gp-home-map-canvas {
    --gp-map-card-width: 280px;
    --gp-map-card-offset: 22px;
    position: relative;
    width: 100%;
    aspect-ratio: 200 / 88;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-xl);
    background:
      radial-gradient(ellipse at center, rgba(20, 68, 52, 0.65) 0%, rgba(11, 46, 35, 0.95) 100%);
    overflow: hidden;
    box-shadow: var(--gp-shadow-deep);
  }

  .gp-home-map-topo {
    position: absolute;
    inset: 0;
    background-image: url('/images/hifi/topo-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .gp-home-map-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .gp-home-map-canvas.has-selected-node .gp-home-map-svg {
    inset: 0;
    width: 100%;
    inline-size: 100%;
    max-inline-size: none;
  }

  .gp-home-map-graticule line {
    stroke: var(--gp-green-600);
    stroke-width: 0.04;
    opacity: 0.32;
    stroke-dasharray: 1 1.4;
  }

  .gp-home-map-world circle {
    fill: var(--gp-green-500);
    opacity: 0.5;
    transition: opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-home-map-canvas.is-focused .gp-home-map-world circle {
    opacity: 0.3;
  }

  .gp-home-map-bioregion-outline {
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-home-map-canvas.has-bioregion-outline .gp-home-map-bioregion-outline {
    opacity: 1;
  }

  .gp-home-map-bioregion-path {
    fill: color-mix(in srgb, var(--bioregion-color, var(--gp-primary)) 7%, transparent);
    stroke: color-mix(in srgb, var(--bioregion-color, var(--gp-primary)) 86%, var(--gp-off-white));
    stroke-width: 0.42;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1.5 0.9;
    opacity: 0.88;
    filter: drop-shadow(0 0 1.2px color-mix(in srgb, var(--bioregion-color, var(--gp-primary)) 64%, transparent));
  }

  .gp-home-map-thread {
    fill: none;
    /* Faint muted theme tint at rest — alive but calm. The per-edge --thread-color
       shows through, mixed toward the neutral base and held at low opacity so a
       resting line is quiet network context. Full saturation stays reserved for a
       selected node's web (.is-selected-adj). */
    stroke: color-mix(in srgb, var(--thread-color, var(--gp-map-thread)) 58%, var(--gp-map-thread));
    stroke-width: 0.26;
    stroke-linecap: round;
    opacity: 0.26;
    mix-blend-mode: screen;
    filter: none;
    transition: stroke-width 240ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 240ms cubic-bezier(0.4, 0, 0.2, 1),
      stroke 320ms cubic-bezier(0.4, 0, 0.2, 1);
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    animation: none;
  }

  /* Arrival pass — a brief neutral "comet" at near-full opacity that draws in,
     then settles to the quiet resting line above (the class is removed once the
     one-shot animation ends). One-shot only; no idle loop. */
  .gp-home-map-thread.is-entering {
    stroke: var(--gp-map-thread-bright);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gpMapThreadGrow 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Held back while a node is selected; cometed in on deselect (decision 8). */
  .gp-home-map-thread.is-pending-reveal {
    opacity: 0;
    animation: none;
  }

  /* Soft web re-reveal on deselect — a brief settle, gentler than the comet. */
  .gp-home-map-thread.is-resettling {
    animation: gpMapThreadResettle 620ms ease both;
  }

  .gp-home-map-thread.is-dim {
    opacity: 0.05;
    filter: none;
  }

  .gp-home-map-thread.is-type-filter-match {
    opacity: 0.84;
    stroke-width: 0.42;
    stroke: color-mix(in srgb, var(--thread-color, var(--gp-map-thread)) 72%, var(--gp-off-white));
    filter: drop-shadow(0 0 0.75px var(--thread-color));
  }

  .gp-home-map-thread.is-filtered-out {
    display: none;
  }

  .gp-home-map-thread.is-edge-selected {
    opacity: 1;
    stroke-width: 0.56;
    filter: drop-shadow(0 0 2px var(--thread-color));
  }

  .gp-home-map-thread-hit {
    fill: none;
    stroke: transparent;
    stroke-width: 3.8;
    stroke-linecap: round;
    pointer-events: none;
  }

  .gp-home-map-thread-hit.is-adj,
  .gp-home-map-thread-hit.is-type-filter-match {
    pointer-events: stroke;
  }

  .gp-home-map-thread-hit.is-filtered-out {
    display: none;
  }

  /* Node links */
  .gp-home-map-node-link {
    cursor: pointer;
    outline: none;
    transition: opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gp-home-map-node-link.is-dim {
    opacity: 0.16;
  }

  .gp-home-map-node-link.is-adj {
    opacity: 1;
  }

  .gp-home-map-node-link.is-filtered-out {
    display: none;
  }

  .gp-home-map-node-hit {
    fill: transparent;
    stroke: transparent;
    pointer-events: all;
  }

  .gp-home-map-node-dot,
  .gp-home-map-node-ring,
  .gp-home-map-node-halo {
    transition: r 200ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Chapter node treatment — lime anchor with a dark green edge */
  .gp-home-map-node-link.is-chapter .gp-home-map-node-dot {
    fill: var(--gp-map-chapter);
    stroke: var(--gp-green-950);
    stroke-width: 0.5;
  }
  .gp-home-map-node-link.is-chapter .gp-home-map-node-ring {
    fill: none;
    stroke: var(--gp-map-chapter-ring);
    stroke-width: 0.36;
    opacity: 0.9;
  }
  .gp-home-map-node-link.is-chapter .gp-home-map-node-halo {
    fill: var(--gp-map-chapter);
    opacity: 0.16;
  }
  .gp-home-map-node-link.is-chapter:hover .gp-home-map-node-halo,
  .gp-home-map-node-link.is-chapter:focus-visible .gp-home-map-node-halo,
  .gp-home-map-node-link.is-chapter.is-selected .gp-home-map-node-halo {
    opacity: 0.42;
  }
  .gp-home-map-node-link.is-chapter:focus-visible .gp-home-map-node-dot,
  .gp-home-map-node-link.is-chapter.is-selected .gp-home-map-node-dot {
    stroke: var(--gp-map-chapter-ring);
    stroke-width: 0.9;
  }

  /* Steward node treatment — warm gold, smaller, no ring */
  .gp-home-map-node-link.is-steward .gp-home-map-node-dot {
    fill: var(--gp-map-steward);
  }
  .gp-home-map-node-link.is-steward .gp-home-map-node-halo {
    fill: var(--gp-map-steward);
    opacity: 0.15;
    transition: opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gp-home-map-node-link.is-steward .gp-home-map-node-ring {
    fill: none;
    stroke: transparent;
  }
  .gp-home-map-node-link.is-steward:hover .gp-home-map-node-halo,
  .gp-home-map-node-link.is-steward:focus-visible .gp-home-map-node-halo {
    opacity: 0.5;
  }

  /* Member node treatment — light green, distinct from chapter anchors. */
  .gp-home-map-node-link.is-member .gp-home-map-node-dot,
  .gp-home-map-node-link.is-project .gp-home-map-node-dot,
  .gp-home-map-node-link.is-place .gp-home-map-node-dot {
    fill: var(--gp-map-member);
    stroke: var(--gp-green-950);
    stroke-width: 0.5;
  }
  .gp-home-map-node-link.is-member .gp-home-map-node-ring,
  .gp-home-map-node-link.is-project .gp-home-map-node-ring,
  .gp-home-map-node-link.is-place .gp-home-map-node-ring {
    fill: none;
    stroke: var(--gp-map-member-ring);
    stroke-width: 0.4;
    opacity: 0.6;
  }
  .gp-home-map-node-link.is-member .gp-home-map-node-halo,
  .gp-home-map-node-link.is-project .gp-home-map-node-halo,
  .gp-home-map-node-link.is-place .gp-home-map-node-halo {
    fill: var(--gp-map-member);
    opacity: 0.14;
    transition: opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gp-home-map-node-link.is-member:hover .gp-home-map-node-halo,
  .gp-home-map-node-link.is-member:focus-visible .gp-home-map-node-halo,
  .gp-home-map-node-link.is-member.is-selected .gp-home-map-node-halo,
  .gp-home-map-node-link.is-project:hover .gp-home-map-node-halo,
  .gp-home-map-node-link.is-project:focus-visible .gp-home-map-node-halo,
  .gp-home-map-node-link.is-project.is-selected .gp-home-map-node-halo,
  .gp-home-map-node-link.is-place:hover .gp-home-map-node-halo,
  .gp-home-map-node-link.is-place:focus-visible .gp-home-map-node-halo,
  .gp-home-map-node-link.is-place.is-selected .gp-home-map-node-halo {
    opacity: 0.46;
  }
  .gp-home-map-node-link.is-owned .gp-home-map-node-owner-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--gp-primary) 72%, var(--gp-off-white));
    stroke-width: 0.34;
    opacity: 0.9;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
  }
  .gp-home-map-node-link.is-owned.is-pending .gp-home-map-node-owner-ring {
    stroke-dasharray: 0.9 0.75;
    opacity: 0.95;
  }
  .gp-home-map-node-link.is-owned:hover .gp-home-map-node-owner-ring,
  .gp-home-map-node-link.is-owned:focus-visible .gp-home-map-node-owner-ring,
  .gp-home-map-node-link.is-owned.is-selected .gp-home-map-node-owner-ring {
    stroke-width: 0.48;
    opacity: 1;
  }
  .gp-home-map-node-link.is-member:focus-visible .gp-home-map-node-dot,
  .gp-home-map-node-link.is-member.is-selected .gp-home-map-node-dot,
  .gp-home-map-node-link.is-project:focus-visible .gp-home-map-node-dot,
  .gp-home-map-node-link.is-project.is-selected .gp-home-map-node-dot,
  .gp-home-map-node-link.is-place:focus-visible .gp-home-map-node-dot,
  .gp-home-map-node-link.is-place.is-selected .gp-home-map-node-dot {
    stroke: var(--gp-map-member-ring);
    stroke-width: 0.8;
  }
  /* Pending nodes live only in this browser; render them as provisional. */
  .gp-home-map-node-link.is-member.is-pending .gp-home-map-node-dot,
  .gp-home-map-node-link.is-project.is-pending .gp-home-map-node-dot,
  .gp-home-map-node-link.is-place.is-pending .gp-home-map-node-dot {
    fill: color-mix(in srgb, var(--gp-map-member) 64%, var(--gp-green-500));
    stroke: var(--gp-map-member-ring);
  }
  .gp-home-map-node-link.is-member.is-pending .gp-home-map-node-ring,
  .gp-home-map-node-link.is-project.is-pending .gp-home-map-node-ring,
  .gp-home-map-node-link.is-place.is-pending .gp-home-map-node-ring {
    stroke-dasharray: 0.8 0.8;
    opacity: 0.9;
  }
  @keyframes gpMapOwnedNodePulse {
    0%, 100% {
      opacity: 0.76;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  /* ---- Exact-overlap fan-out ------------------------------------------- */
  /* Only exact same-coordinate people hide behind this stack affordance. */
  .gp-home-map-node-link.is-clustered {
    opacity: 0;
    pointer-events: none;
  }
  .gp-home-map-overlap-stack,
  .gp-home-map-cluster-sat {
    cursor: pointer;
  }
  .gp-home-map-overlap-hit {
    fill: transparent;
  }
  .gp-home-map-overlap-halo {
    fill: var(--gp-map-member);
    opacity: 0.2;
  }
  .gp-home-map-overlap-dot {
    fill: var(--gp-map-member);
    stroke: var(--gp-green-950);
    stroke-width: 0.5;
  }
  .gp-home-map-overlap-dot.is-c {
    fill: var(--gp-map-steward);
  }
  .gp-home-map-overlap-stack:hover .gp-home-map-overlap-halo,
  .gp-home-map-overlap-stack:focus-visible .gp-home-map-overlap-halo {
    opacity: 0.42;
  }
  .gp-home-map-overlap-stack:focus-visible .gp-home-map-overlap-dot {
    stroke: var(--gp-primary);
    stroke-width: 0.9;
  }
  .gp-home-map-overlap-stack.is-appearing,
  .gp-home-map-cluster-sat.is-appearing {
    animation: gpMapClusterPop 240ms cubic-bezier(0.22, 1, 0.36, 1) 1;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Fan-out: leader lines + satellite pins around a coincident group. */
  .gp-home-map-cluster-leader {
    stroke: color-mix(in srgb, var(--gp-map-member) 60%, transparent);
    stroke-width: 0.3;
  }
  .gp-home-map-cluster-sat-hit {
    fill: transparent;
  }
  .gp-home-map-cluster-sat-dot {
    fill: var(--gp-map-member);
    stroke: var(--gp-green-950);
    stroke-width: 0.5;
  }
  .gp-home-map-cluster-sat-owner-ring,
  .gp-home-map-overlap-owner-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--gp-primary) 72%, var(--gp-off-white));
    stroke-width: 0.34;
    opacity: 0.92;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
  }
  .gp-home-map-cluster-sat.is-steward .gp-home-map-cluster-sat-dot {
    fill: var(--gp-map-steward);
  }
  .gp-home-map-cluster-sat:hover .gp-home-map-cluster-sat-dot,
  .gp-home-map-cluster-sat:focus-visible .gp-home-map-cluster-sat-dot {
    stroke: var(--gp-primary);
    stroke-width: 0.9;
  }
  @keyframes gpMapClusterPop {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gp-home-map-overlap-stack.is-appearing,
    .gp-home-map-cluster-sat.is-appearing,
    .gp-home-map-node-link.is-owned .gp-home-map-node-owner-ring,
    .gp-home-map-cluster-sat-owner-ring,
    .gp-home-map-overlap-owner-ring {
      animation: none;
    }
  }

  /* Hover/focus highlight — a node's connected lines brighten to a clearer
     neutral so you can see who it links to, WITHOUT colourising. Theme colour is
     reserved for an actively selected node (.is-selected-adj below). One-shot
     reveal only; no idle loop. */
  .gp-home-map-thread.is-adj {
    opacity: 0.82;
    stroke-width: 0.42;
    /* Brighten the same tint on hover/focus rather than desaturating to white, so
       the resting tint and the active state share a hue. Still short of the full
       saturated colour the selected web carries. */
    stroke: color-mix(in srgb, var(--thread-color, var(--gp-map-thread)) 72%, var(--gp-off-white));
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    filter: none;
    animation: none;
  }

  .gp-home-map-thread.is-adj.is-revealing {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: gpMapAdjacentThread 900ms cubic-bezier(0.22, 1, 0.36, 1) 1;
  }

  /* Selected node's web — the only place theme colour (data) paints a line. Set
     by markSelectedThreads() on the selected node's edges and cleared on
     deselect, so hovering another node never colourises (its lines only get the
     neutral .is-adj highlight). Declared after .is-adj/.is-dim so it wins on
     equal specificity; the parallel theme strands add the per-shared-theme
     density. */
  .gp-home-map-thread.is-selected-adj {
    opacity: 1;
    stroke: var(--thread-color, var(--gp-map-member));
    stroke-width: 0.58;
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 1.5px var(--thread-color));
  }

  /* Per-shared-theme parallel strands for the selected node (renderSelectionStrands).
     Decorative, non-interactive, in their own overlay group. One-shot grow. */
  .gp-home-map-strand {
    fill: none;
    stroke: var(--thread-color, var(--gp-map-member));
    stroke-width: 0.3;
    stroke-linecap: round;
    opacity: 0.92;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 1px var(--thread-color));
    pointer-events: none;
  }
  .gp-home-map-strand.is-entering-strand {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: gpMapStrandGrow 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Visible identity counts inside the map */
  .gp-home-map-legend {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: rgba(11, 38, 28, 0.78);
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 3;
    max-width: calc(100% - 24px);
    pointer-events: auto;
  }

  .gp-home-map-canvas.has-selected-node .gp-home-map-legend {
    inset-inline-end: 12px;
    max-width: calc(100% - 24px);
  }

  .gp-home-map-legend-item {
    appearance: none;
    box-sizing: border-box;
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 7px;
    border: 1px solid transparent;
    border-radius: var(--gp-radius-pill);
    background: transparent;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: background 160ms cubic-bezier(0.4, 0, 0.2, 1), border-color 160ms cubic-bezier(0.4, 0, 0.2, 1), color 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* The class display wins over the UA [hidden] rule, so hide explicitly. */
  .gp-home-map-legend-item[hidden] {
    display: none;
  }

  .gp-home-map-legend-item:hover,
  .gp-home-map-legend-item:focus-visible,
  .gp-home-map-legend-item.is-active {
    border-color: color-mix(in srgb, var(--gp-primary) 38%, transparent);
    background: color-mix(in srgb, var(--gp-primary) 13%, transparent);
  }

  .gp-home-map-legend-item.is-active .gp-home-map-legend-label {
    color: var(--gp-primary);
  }

  .gp-home-map-legend-mark {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex: none;
  }

  .gp-home-map-legend-mark.is-chapter {
    background: var(--gp-map-chapter);
    box-shadow: 0 0 0 1.5px var(--gp-map-chapter-ring);
  }

  .gp-home-map-legend-mark.is-steward {
    background: var(--gp-map-steward);
    box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--gp-green-950) 70%, transparent);
  }

  .gp-home-map-legend-mark.is-member {
    background: var(--gp-map-member);
    box-shadow: 0 0 0 1.5px var(--gp-green-950);
  }

  .gp-home-map-legend-label {
    font-family: var(--gp-font-mono);
    color: var(--gp-fg-dim);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .gp-home-map-legend-count {
    box-sizing: border-box;
    min-width: 4ch;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 7px;
    border: 1px solid color-mix(in srgb, var(--gp-primary) 36%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-fg) 8%, transparent);
    color: var(--gp-fg);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .gp-home-map-freshness {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    z-index: 4;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    inline-size: max-content;
    min-inline-size: 0;
    max-inline-size: calc(100% - 24px);
    min-height: 30px;
    padding: 0 11px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-green-900) 74%, transparent);
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
  }

  .gp-home-map-freshness[hidden] {
    display: none;
  }

  .gp-home-map-freshness [data-home-map-freshness-label] {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gp-home-map-freshness-dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 999px;
    background: var(--gp-map-member);
    box-shadow: 0 0 10px color-mix(in srgb, var(--gp-map-member) 58%, transparent);
  }

  .gp-home-map-freshness[data-state='live'] {
    color: var(--gp-fg);
    border-color: color-mix(in srgb, var(--gp-map-member) 42%, transparent);
  }

  /* Focus card */
  .gp-home-map-focus {
    position: absolute;
    left: 50%;
    top: 50%;
    display: none;
    flex-direction: column;
    gap: 7px;
    width: min(var(--gp-map-card-width), calc(100% - 24px));
    min-width: 0;
    max-width: calc(100% - 24px);
    padding: 13px 15px 14px;
    border: 1px solid color-mix(in srgb, var(--gp-map-member) 32%, transparent);
    border-radius: var(--gp-radius-md);
    background: var(--gp-map-pop-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--gp-fg);
    box-shadow: var(--gp-map-pop-shadow);
    z-index: 6;
    pointer-events: none;
    overflow-wrap: anywhere;
  }

  .gp-home-map-focus[aria-hidden='false'] {
    display: inline-flex;
  }

  .gp-home-map-focus-role {
    font-family: var(--gp-font-mono);
    color: var(--gp-map-member);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .gp-home-map-focus[data-node-type='chapter'] .gp-home-map-focus-role {
    color: var(--gp-map-chapter);
  }

  .gp-home-map-focus[data-node-type='steward'] .gp-home-map-focus-role {
    color: var(--gp-map-steward);
  }

  .gp-home-map-focus-name {
    font-family: var(--gp-font-display);
    color: var(--gp-secondary);
    font-size: 18px;
    line-height: 1.1;
  }

  .gp-home-map-focus-meta {
    font-family: var(--gp-font-body);
    color: var(--gp-fg-muted);
    font-size: 12px;
    line-height: 1.3;
  }

  .gp-home-map-focus-meta:empty {
    display: none;
  }

  .gp-home-map-focus-themes {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .gp-home-map-focus-themes:empty {
    display: none;
  }

  .gp-home-map-focus-themes span {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 2px 7px;
    border: 1px solid color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 54%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 16%, transparent);
    color: var(--gp-fg);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .gp-home-map-focus-connections {
    margin-top: 2px;
    padding-top: 7px;
    border-top: 1px solid rgba(250, 247, 238, 0.1);
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .gp-home-map-edge-tooltip {
    --edge-color: var(--gp-map-member);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    z-index: 7;
    display: none;
    min-width: 210px;
    max-width: min(280px, calc(100% - 20px));
    padding: 11px 13px 12px;
    border: 1px solid color-mix(in srgb, var(--edge-color) 56%, transparent);
    border-radius: var(--gp-radius-md);
    background: color-mix(in srgb, var(--gp-green-950) 96%, var(--edge-color));
    color: var(--gp-fg);
    box-shadow: 0 18px 42px -18px color-mix(in srgb, var(--gp-green-950) 78%, transparent);
    pointer-events: none;
  }

  .gp-home-map-edge-tooltip[aria-hidden='false'] {
    display: grid;
    gap: 5px;
  }

  .gp-home-map-edge-tooltip-kicker,
  .gp-home-map-edge-tooltip-meta {
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .gp-home-map-edge-tooltip-kicker {
    color: var(--edge-color);
  }

  .gp-home-map-edge-tooltip-title {
    color: var(--gp-secondary);
    font-family: var(--gp-font-body);
    font-size: var(--gp-label-sm);
    font-weight: 800;
    line-height: 1.25;
  }

  /* Embedded HiFi-style map controls */
  .gp-home-map-controls {
    position: absolute;
    inset-inline-start: 12px;
    inset-block-end: 12px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: min(var(--gp-container-md), calc(100% - var(--gp-space-lg)));
  }

  .gp-home-map-canvas.has-selected-node .gp-home-map-controls {
    max-width: min(var(--gp-container-md), calc(100% - var(--gp-space-lg)));
  }

  .gp-home-map-filter-panel {
    width: min(var(--gp-container-md), calc(100vw - (var(--gp-space-xl) * 2)));
    max-height: min(290px, 58cqw);
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-md);
    background: rgba(11, 38, 28, 0.92);
    box-shadow: var(--gp-shadow-card-lg);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .gp-home-map-filter-panel[hidden] {
    display: none;
  }

  .gp-home-map-filter-panel.is-themes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-height: none;
    overflow: visible;
  }

  .gp-home-map-filter-panel.is-themes[hidden] {
    display: none;
  }

  .gp-home-map-filter-option {
    min-height: 38px;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border: 0;
    border-radius: var(--gp-radius-sm);
    background: transparent;
    color: var(--gp-fg);
    font: inherit;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: opacity 160ms ease, background 160ms ease;
  }

  .gp-home-map-filter-option[aria-pressed='false'] {
    opacity: 0.38;
  }

  .gp-home-map-filter-panel.is-themes .gp-home-map-filter-option {
    grid-template-columns: 12px minmax(0, 1fr);
    gap: var(--gp-space-xs);
    min-height: 40px;
    padding: 5px 6px;
    font-size: var(--gp-caption);
    line-height: 1.1;
  }

  .gp-home-map-filter-panel.is-themes .gp-home-map-filter-option span:last-child {
    overflow-wrap: anywhere;
  }

  .gp-home-map-filter-option:hover,
  .gp-home-map-filter-option:focus-visible {
    background: rgba(250, 247, 238, 0.06);
    outline: none;
  }

  .gp-home-map-filter-marker {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--theme-color, var(--gp-map-member));
    box-shadow: 0 0 8px color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 55%, transparent);
  }

  .gp-home-map-filter-option.is-chapter .gp-home-map-filter-marker {
    background: var(--gp-map-chapter);
    box-shadow: 0 0 0 1.5px var(--gp-map-chapter-ring);
  }

  .gp-home-map-filter-option.is-steward .gp-home-map-filter-marker {
    background: var(--gp-map-steward);
  }

  .gp-home-map-filter-option.is-member .gp-home-map-filter-marker {
    background: var(--gp-map-member);
    box-shadow: 0 0 0 1.5px var(--gp-green-950);
  }

  .gp-home-map-filter-tabs {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    padding: 4px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: rgba(11, 38, 28, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .gp-home-map-filter-tabs button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 0;
    border-radius: var(--gp-radius-pill);
    padding: 8px 15px;
    background: transparent;
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }

  .gp-home-map-filter-tabs button:hover,
  .gp-home-map-filter-tabs button:focus-visible,
  .gp-home-map-filter-tabs button.is-active {
    background: var(--gp-map-member);
    color: var(--gp-green-900);
    outline: none;
  }

  /* Narrowed-filter indicator — the dot stays visible after the panel closes
     so a filtered map never reads as the full network. */
  .gp-home-map-filter-tabs button.is-filtering::after {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }

  .gp-home-map-zoom-controls {
    /* Visible on every viewport — desktop needs zoom + the drag-pan it unlocks,
       not just touch. */
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-green-950) 74%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .gp-home-map-zoom-controls svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Drag-to-pan affordance once the map is zoomed in. */
  .gp-home-map-canvas.is-zoomed .gp-home-map-svg {
    cursor: grab;
  }
  .gp-home-map-canvas.is-grabbing .gp-home-map-svg,
  .gp-home-map-canvas.is-grabbing .gp-home-map-node-link {
    cursor: grabbing;
  }

  .gp-home-map-zoom-controls button {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--gp-radius-pill);
    padding: 8px 12px;
    background: transparent;
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-label-sm);
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
  }

  .gp-home-map-zoom-controls button:hover,
  .gp-home-map-zoom-controls button:focus-visible,
  .gp-home-map-canvas.is-zoomed .gp-home-map-zoom-controls [data-home-map-zoom='reset'] {
    background: var(--gp-map-member);
    color: var(--gp-green-900);
  }

  .gp-home-map-control-row {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 8px;
    max-width: 100%;
  }

  .gp-home-map-list-drawer {
    position: absolute;
    inset-inline-start: 12px;
    inset-block-end: 72px;
    z-index: 7;
    width: min(380px, calc(100% - 24px));
    max-height: min(420px, calc(100% - 96px));
    max-width: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-lg);
    background: color-mix(in srgb, var(--gp-green-950) 96%, transparent);
    color: var(--gp-fg);
    box-shadow: var(--gp-map-pop-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: auto;
  }

  .gp-home-map-list-drawer[hidden] {
    display: none;
  }

  .gp-home-map-list-drawer:not([open]) {
    display: none;
  }

  .gp-home-map-list-drawer::backdrop {
    background: color-mix(in srgb, var(--gp-green-950) 72%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .gp-home-map-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gp-home-map-list-kicker {
    margin: 0 0 4px;
    color: var(--gp-map-member);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .gp-home-map-list-head h3 {
    margin: 0;
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: var(--gp-title-lg);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
  }

  .gp-home-map-list-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .gp-home-map-list-actions span {
    min-width: 4ch;
    display: inline-flex;
    justify-content: center;
    padding: 4px 8px;
    border: 1px solid color-mix(in srgb, var(--gp-primary) 36%, transparent);
    border-radius: var(--gp-radius-pill);
    color: var(--gp-fg);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 800;
  }

  .gp-home-map-list-actions button {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-green-950) 62%, transparent);
    color: var(--gp-fg-muted);
    font: inherit;
    font-size: var(--gp-title-md);
    line-height: 1;
    cursor: pointer;
  }

  .gp-home-map-list-items {
    display: grid;
    gap: 7px;
    min-height: 0;
    overflow: auto;
    padding-inline-end: 2px;
  }

  .gp-home-map-list-row {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-block-size: calc(var(--gp-space-lg) * 3);
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--gp-off-white) 12%, transparent);
    border-radius: var(--gp-radius-md);
    background: color-mix(in srgb, var(--gp-off-white) 4%, transparent);
    color: var(--gp-fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .gp-home-map-list-row:hover,
  .gp-home-map-list-row:focus-visible {
    border-color: color-mix(in srgb, var(--gp-primary) 48%, transparent);
    background: color-mix(in srgb, var(--gp-off-white) 7%, transparent);
    outline: none;
  }

  .gp-home-map-list-mark {
    width: 10px;
    height: 10px;
    margin-block-start: var(--gp-space-xs);
    border-radius: 999px;
    background: var(--gp-map-member);
    box-shadow: 0 0 0 1.5px var(--gp-green-950);
  }

  .gp-home-map-list-mark.is-chapter {
    background: var(--gp-map-chapter);
    box-shadow: 0 0 0 1.5px var(--gp-map-chapter-ring);
  }

  .gp-home-map-list-mark.is-steward {
    background: var(--gp-map-steward);
  }

  .gp-home-map-list-copy {
    display: grid;
    gap: var(--gp-space-xs);
    min-width: 0;
  }

  .gp-home-map-list-name {
    color: var(--gp-fg);
    font-size: var(--gp-label-sm);
    font-weight: 800;
    line-height: 1.2;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gp-home-map-list-meta {
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gp-home-map-list-themes {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 4px;
    min-width: 0;
    max-width: 100%;
  }

  .gp-home-map-list-themes:empty {
    display: none;
  }

  .gp-home-map-list-themes span {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 20px;
    padding: 2px 7px;
    border: 1px solid color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 50%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 13%, transparent);
    color: var(--gp-fg);
    font-size: var(--gp-caption);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .gp-home-map-list-themes span.is-more {
    border-color: var(--gp-border-soft);
    background: color-mix(in srgb, var(--gp-green-950) 62%, transparent);
    color: var(--gp-fg-muted);
    white-space: nowrap;
  }

  .gp-home-map-list-empty {
    margin: 0;
    color: var(--gp-fg-muted);
    font-size: var(--gp-label-sm);
    line-height: 1.35;
  }

  /* Selected-node card: a stable floating card anchored near the active node.
     It mirrors the hover-card footprint so clicking from hover does not resize
     or shift the map on desktop. Compact mobile rules turn this same region into
     the lower map bar. */
  .gp-home-map-selected {
    position: absolute;
    inset-inline-start: var(--gp-selected-x, 50%);
    inset-inline-end: auto;
    inset-block-start: var(--gp-selected-y, 50%);
    inset-block-end: auto;
    z-index: 8;
    width: min(var(--gp-map-card-width), calc(100% - 24px));
    inline-size: min(var(--gp-map-card-width), calc(100% - 24px));
    min-width: 0;
    max-width: calc(100% - 24px);
    max-height: calc(100% - 24px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 11px 13px 12px;
    border: 1px solid color-mix(in srgb, var(--gp-map-member) 32%, transparent);
    border-radius: var(--gp-radius-md);
    background: var(--gp-map-pop-bg);
    color: var(--gp-fg);
    box-shadow: var(--gp-map-pop-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: auto;
    overflow-wrap: anywhere;
    pointer-events: auto;
    transform: var(--gp-selected-transform, translate(var(--gp-map-card-offset), var(--gp-map-card-offset)));
  }
  .gp-home-map-selected[hidden] { display: none; }

  .gp-home-map-canvas.has-selected-node .gp-home-map-selected-edge-list:not([hidden]) {
    display: block;
  }

  .gp-home-map-selected-close {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-end: 8px;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: rgba(7, 24, 15, 0.6);
    color: var(--gp-fg-muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .gp-home-map-selected-close:hover { color: var(--gp-fg); }

  .gp-home-map-selected[data-selected-type='chapter'] {
    gap: 8px;
  }

  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-selected-kicker,
  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-selected-bioregion,
  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-selected-note,
  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-selected-themes,
  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-selected-edge-list,
  .gp-home-map-selected[data-selected-type='chapter'] .gp-home-map-update {
    display: none;
  }

  .gp-home-map-selected-kicker {
    margin: 0;
    padding-inline-end: 38px;
    font-family: var(--gp-font-mono);
    color: var(--gp-map-member);
    font-size: var(--gp-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .gp-home-map-selected-name {
    margin: 0;
    padding-inline-end: 38px;
    font-family: var(--gp-font-display);
    color: var(--gp-secondary);
    font-size: var(--gp-title-md);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .gp-home-map-selected-place {
    margin: 0;
    color: var(--gp-fg-muted);
    font-size: 13px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .gp-home-map-selected-place:empty,
  .gp-home-map-selected-place[hidden] { display: none; }

  .gp-home-map-selected-bioregion,
  .gp-home-map-selected-note {
    margin: 0;
    color: var(--gp-fg-muted);
    font-size: 13px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .gp-home-map-selected-bioregion {
    color: var(--gp-map-member);
    font-family: var(--gp-font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .gp-home-map-selected-note[hidden] {
    display: none;
  }

  .gp-home-map-selected-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .gp-home-map-selected-links[hidden] { display: none; }
  .gp-home-map-selected-link {
    appearance: none;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 11px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: var(--gp-map-control-bg);
    color: var(--gp-fg);
    font-family: var(--gp-font-body);
    font-size: var(--gp-caption);
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .gp-home-map-selected-link:hover,
  .gp-home-map-selected-link:focus-visible {
    color: var(--gp-primary);
    border-color: color-mix(in srgb, var(--gp-primary) 55%, transparent);
    background: var(--gp-green-800);
  }

  .gp-home-map-selected-themes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .gp-home-map-selected-themes:empty,
  .gp-home-map-selected-themes[hidden] { display: none; }
  .gp-home-map-selected-themes span {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 2px 9px;
    border: 1px solid color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 60%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--chip-color, var(--gp-map-member)) 16%, transparent);
    color: var(--gp-fg);
    font-size: 12px;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .gp-home-map-selected-edge-list {
    display: none;
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid rgba(250, 247, 238, 0.1);
  }

  .gp-home-map-selected-edge-list[hidden] {
    display: none;
  }

  .gp-home-map-selected-edge-title {
    margin: 0 0 8px;
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .gp-home-map-selected-edge-items {
    display: grid;
    gap: 7px;
  }

  .gp-home-map-selected-edge-row {
    --edge-color: var(--gp-map-member);
    min-height: 44px;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--edge-color) 38%, transparent);
    border-radius: var(--gp-radius-sm);
    background: color-mix(in srgb, var(--edge-color) 10%, var(--gp-green-950));
    color: var(--gp-fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .gp-home-map-selected-edge-row:hover,
  .gp-home-map-selected-edge-row:focus-visible,
  .gp-home-map-selected-edge-row.is-active {
    border-color: color-mix(in srgb, var(--edge-color) 72%, transparent);
    background: color-mix(in srgb, var(--edge-color) 18%, var(--gp-green-950));
  }

  .gp-home-map-selected-edge-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--edge-color);
    box-shadow: 0 0 10px color-mix(in srgb, var(--edge-color) 62%, transparent);
  }

  .gp-home-map-selected-edge-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .gp-home-map-selected-edge-name {
    color: var(--gp-fg);
    font-size: var(--gp-label-sm);
    font-weight: 800;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .gp-home-map-selected-edge-meta {
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 750;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  /* Connection item: name button (selects) + open-link control + a single
     non-wrapping shared-theme carousel, so a long theme list never makes rows
     uneven. (The list itself is mobile-only — see the container query below.) */
  .gp-home-map-selected-edge-item {
    --edge-color: var(--gp-map-member);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name open"
      "themes themes";
    align-items: center;
    gap: 5px 8px;
  }
  .gp-home-map-selected-edge-item .gp-home-map-selected-edge-row { grid-area: name; }
  .gp-home-map-selected-edge-open { grid-area: open; }
  .gp-home-map-selected-edge-themes { grid-area: themes; }

  .gp-home-map-selected-edge-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-pill);
    background: var(--gp-map-control-bg);
    color: var(--gp-fg-muted);
    font-size: var(--gp-body-sm);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .gp-home-map-selected-edge-open:hover,
  .gp-home-map-selected-edge-open:focus-visible {
    color: var(--gp-primary);
    border-color: color-mix(in srgb, var(--gp-primary) 55%, transparent);
  }

  .gp-home-map-selected-edge-themes {
    display: flex;
    flex-wrap: nowrap;
    gap: 5px;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    mask-image: var(--gp-map-edge-fade);
    -webkit-mask-image: var(--gp-map-edge-fade);
  }
  .gp-home-map-selected-edge-themes::-webkit-scrollbar { display: none; }
  .gp-home-map-selected-edge-themes:empty { display: none; }
  .gp-home-map-selected-edge-theme {
    display: inline-flex;
    align-items: center;
    flex: none;
    scroll-snap-align: start;
    min-height: 22px;
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--chip-color, var(--edge-color)) 50%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--chip-color, var(--edge-color)) 16%, transparent);
    color: var(--gp-fg);
    font-size: var(--gp-caption);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  /* The connected node a tapped connection row points to. */
  .gp-home-map-node-link.is-edge-target .gp-home-map-node-halo {
    opacity: 0.62;
  }

  /* Owner edit-link request — neutral on every outcome. */
  .gp-home-map-update { margin-top: 8px; }
  .gp-home-map-update[hidden] { display: none; }
  .gp-home-map-update-trigger {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid color-mix(in srgb, var(--gp-map-member) 55%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-map-member) 14%, transparent);
    color: var(--gp-map-member);
    font-family: var(--gp-font-body);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: background 160ms ease;
  }
  .gp-home-map-update-trigger:hover {
    background: color-mix(in srgb, var(--gp-map-member) 24%, transparent);
  }
  .gp-home-map-update-trigger[hidden] { display: none; }

  .gp-home-map-update-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
  }
  .gp-home-map-update-form[hidden] { display: none; }
  .gp-home-map-update-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .gp-home-map-update-field span {
    color: var(--gp-fg-muted);
    font-size: 12px;
    font-weight: 700;
  }
  .gp-home-map-update-form input {
    width: 100%;
    box-sizing: border-box;
    min-height: 44px;
    border: 1px solid var(--gp-border-soft);
    border-radius: var(--gp-radius-md);
    padding: 10px 12px;
    background: rgba(2, 12, 7, 0.7);
    color: var(--gp-fg);
    font: inherit;
    outline: none;
  }
  .gp-home-map-update-field input:focus {
    border-color: color-mix(in srgb, var(--gp-map-member) 78%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gp-map-member) 14%, transparent);
  }
  .gp-home-map-update-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gp-home-map-update-actions button {
    min-height: 44px;
    flex: 1 1 auto;
    border-radius: var(--gp-radius-pill);
    padding: 8px 16px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .gp-home-map-update-cancel {
    border: 1px solid var(--gp-border-soft);
    background: transparent;
    color: var(--gp-fg-muted);
  }
  .gp-home-map-update-submit {
    border: 0;
    background: var(--gp-map-member);
    color: var(--gp-green-950);
  }
  .gp-home-map-update-error {
    margin: 0;
    color: var(--gp-secondary);
    font-size: var(--gp-label-sm);
  }
  .gp-home-map-update-error:empty { display: none; }
  .gp-home-map-update-success {
    margin: 6px 0 0;
    color: var(--gp-map-member);
    font-size: 14px;
    line-height: 1.4;
  }
  .gp-home-map-update-success[hidden] { display: none; }

  /* Find-your-people walkthrough — modal layer, no map layout jump. */
  .gp-home-map-addnode-dialog {
    position: relative;
    box-sizing: border-box;
    width: min(920px, calc(100vw - 32px));
    height: auto;
    max-height: min(760px, calc(100svh - 32px));
    margin: auto;
    padding: 24px 26px 0;
    border: 1px solid color-mix(in srgb, var(--gp-map-member) 34%, transparent);
    border-radius: var(--gp-radius-xl);
    background:
      radial-gradient(circle at 18% 8%, rgba(184, 232, 53, 0.12), transparent 30%),
      linear-gradient(145deg, rgba(18, 72, 52, 0.98), rgba(6, 26, 18, 0.99));
    color: var(--gp-fg);
    box-shadow: 0 28px 88px -28px rgba(0, 0, 0, 0.82);
    overflow: hidden;
  }

  .gp-home-map-addnode-dialog::backdrop {
    background: rgba(2, 12, 7, 0.74);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .gp-home-map-addnode-dialog:not([open]) {
    display: none;
  }

  .gp-home-map-addnode-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .gp-home-map-addnode-topo {
    position: absolute;
    inset: 0;
    background-image: url('/images/hifi/topo-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .gp-home-map-addnode-close {
    position: absolute;
    top: 22px;
    right: 22px;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--gp-off-white) 18%, transparent);
    border-radius: var(--gp-radius-pill);
    background: color-mix(in srgb, var(--gp-green-950) 68%, transparent);
    color: var(--gp-fg-muted);
    font: inherit;
    font-size: var(--gp-title-lg);
    line-height: 1;
    cursor: pointer;
  }

  .gp-home-map-addnode-back {
    position: absolute;
    inset-block-start: 22px;
    inset-inline-start: 22px;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(250, 247, 238, 0.18);
    border-radius: var(--gp-radius-pill);
    background: rgba(7, 24, 15, 0.68);
    color: var(--gp-fg-muted);
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .gp-home-map-addnode-close:hover,
  .gp-home-map-addnode-close:focus-visible,
  .gp-home-map-addnode-back:hover,
  .gp-home-map-addnode-back:focus-visible {
    color: var(--gp-fg);
    border-color: color-mix(in srgb, var(--gp-map-member) 50%, transparent);
    outline: none;
  }

  .gp-home-map-addnode-progress {
    display: none;
  }

  .gp-home-map-addnode-progress span {
    width: 42px;
    height: 4px;
    border-radius: var(--gp-radius-pill);
    background: rgba(250, 247, 238, 0.16);
  }

  .gp-home-map-addnode-progress span.is-active {
    background: var(--gp-map-member);
    box-shadow: 0 0 16px color-mix(in srgb, var(--gp-map-member) 44%, transparent);
  }

  .gp-home-map-addnode-form {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .gp-home-map-addnode-step {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: auto;
    padding: 0 0 14px;
    scrollbar-width: none;
  }

  .gp-home-map-addnode-step::-webkit-scrollbar {
    display: none;
  }

  .gp-home-map-addnode-step[hidden] {
    display: none;
  }

  .gp-home-map-addnode-dialog h2 {
    align-self: center;
    max-width: min(100% - 104px, 760px);
    margin: 0;
    color: var(--gp-secondary);
    font-family: var(--gp-font-display);
    font-size: 38px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.02;
    text-align: center;
    white-space: nowrap;
  }

  .gp-home-map-addnode-step[data-walkthrough-step='themes'] {
    align-items: center;
    padding-block-end: 24px;
    text-align: center;
  }

  .gp-home-map-addnode-step[data-walkthrough-step='themes'] h2 {
    max-width: 100%;
  }

  .gp-home-map-addnode-copy,
  .gp-home-map-addnode-mode,
  .gp-home-map-addnode-location-status,
  .gp-home-map-addnode-status {
    margin: 0;
    color: var(--gp-fg-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .gp-home-map-addnode-copy {
    align-self: center;
    width: min(100% - 104px, 52ch);
    max-width: 52ch;
    text-align: center;
  }

  .gp-home-map-addnode-step[data-walkthrough-step='themes'] .gp-home-map-addnode-copy {
    max-width: 48ch;
    margin-inline: auto;
  }

  .gp-home-map-addnode-theme-options {
    align-self: center;
    width: min(100%, 620px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-block: auto 4px;
  }

  .gp-home-map-addnode-step[data-walkthrough-step='themes'] .gp-home-map-addnode-theme-count {
    margin-block-end: 8px;
  }

  .gp-home-map-addnode-theme {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 42%, rgba(250, 247, 238, 0.14));
    border-radius: var(--gp-radius-pill);
    padding: 7px 10px;
    background: color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 10%, rgba(2, 12, 7, 0.42));
    color: var(--gp-fg);
    font: inherit;
    font-size: var(--gp-label-sm);
    font-weight: 750;
    line-height: 1.15;
    text-align: left;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, opacity 160ms ease, transform 160ms ease;
  }

  .gp-home-map-addnode-theme:hover,
  .gp-home-map-addnode-theme:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 70%, transparent);
    outline: none;
  }

  .gp-home-map-addnode-theme[aria-pressed='true'] {
    background: color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 28%, rgba(2, 12, 7, 0.38));
    border-color: var(--theme-color, var(--gp-map-member));
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 16%, transparent);
  }

  .gp-home-map-addnode-theme:disabled {
    opacity: 0.36;
    cursor: not-allowed;
    transform: none;
  }

  .gp-home-map-addnode-theme-dot {
    width: 12px;
    height: 12px;
    flex: none;
    border-radius: 999px;
    background: var(--theme-color, var(--gp-map-member));
    box-shadow: 0 0 14px color-mix(in srgb, var(--theme-color, var(--gp-map-member)) 56%, transparent);
  }

  .gp-home-map-addnode-theme-count {
    align-self: center;
    margin: 0;
    padding: 8px 12px;
    border: 1px solid rgba(250, 247, 238, 0.12);
    border-radius: var(--gp-radius-pill);
    background: rgba(2, 12, 7, 0.28);
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .gp-home-map-addnode-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .gp-home-map-addnode-form label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
    text-align: start;
  }

  .gp-home-map-addnode-form label > span,
  .gp-home-map-addnode-map-field > span,
  .gp-home-map-addnode-location-head > span {
    align-self: flex-start;
    color: var(--gp-map-member);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.1;
  }

  .gp-home-map-addnode-label-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gp-home-map-addnode-label-row .gp-home-map-addnode-theme-count {
    flex: none;
  }

  .gp-home-map-addnode-form input,
  .gp-home-map-addnode-form textarea {
    width: 100%;
    box-sizing: border-box;
    min-height: 48px;
    border: 1px solid rgba(250, 247, 238, 0.14);
    border-radius: var(--gp-radius-md);
    padding: 12px 13px;
    background: rgba(2, 12, 7, 0.55);
    color: var(--gp-fg);
    font: inherit;
    text-align: start;
    outline: none;
  }

  .gp-home-map-addnode-form textarea {
    min-height: 88px;
    resize: vertical;
  }

  .gp-home-map-addnode-form input:focus,
  .gp-home-map-addnode-form textarea:focus {
    border-color: color-mix(in srgb, var(--gp-map-member) 76%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gp-map-member) 14%, transparent);
  }

  .gp-home-map-addnode-location {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
  }

  .gp-home-map-addnode-location-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gp-home-map-addnode-location-head button,
  .gp-home-map-addnode-review button {
    border: 0;
    background: transparent;
    color: var(--gp-map-member);
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    cursor: pointer;
  }

  .gp-home-map-addnode-location-head button:hover,
  .gp-home-map-addnode-location-head button:focus-visible,
  .gp-home-map-addnode-review button:hover,
  .gp-home-map-addnode-review button:focus-visible {
    color: var(--gp-secondary);
    outline: none;
  }

  .gp-home-map-addnode-map-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
    text-align: start;
  }

  .gp-home-map-addnode-mini-map {
    position: relative;
    aspect-ratio: 2 / 1;
    min-height: 156px;
    border: 1px solid color-mix(in srgb, var(--gp-map-member) 24%, transparent);
    border-radius: var(--gp-radius-md);
    background: radial-gradient(ellipse at center, rgba(20, 68, 52, 0.72), rgba(7, 24, 15, 0.96));
    overflow: hidden;
    cursor: crosshair;
  }

  .gp-home-map-addnode-mini-map[hidden],
  .gp-home-map-addnode-city[hidden],
  .gp-home-map-addnode-back[hidden],
  .gp-home-map-addnode-next[hidden],
  .gp-home-map-addnode-submit[hidden] {
    display: none;
  }

  .gp-home-map-addnode-mini-topo {
    position: absolute;
    inset: 0;
    background-image: url('/images/hifi/topo-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .gp-home-map-addnode-mini-map svg {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .gp-home-map-addnode-mini-map svg circle {
    fill: var(--gp-green-400);
    opacity: 0.52;
  }

  .gp-home-map-addnode-mini-map [data-location-pin] {
    fill: var(--gp-map-member);
    stroke: var(--gp-green-950);
    stroke-width: 0.75;
    opacity: 1;
    filter: drop-shadow(0 0 5px var(--gp-map-member));
  }

  .gp-home-map-addnode-mini-map span {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: 10px;
    z-index: 2;
    transform: translateX(-50%);
    color: var(--gp-fg-dim);
    font-family: var(--gp-font-mono);
    font-size: var(--gp-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }

  .gp-home-map-addnode-note {
    margin-top: 0;
  }

  .gp-home-map-addnode-preview {
    display: flex;
    align-items: center;
    gap: 14px;
